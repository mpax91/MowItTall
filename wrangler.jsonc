{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mowittall",
  "compatibility_date": "2026-11-01",
  // Small API for the Lawn Hall of Fame / Shame. Everything else is the static Astro build.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The worker runs first for pages too (short links live there); static files skip it.
    "run_worker_first": ["/*", "!/_astro/*", "!/og/*", "!/pin/*", "!/img/*", "!/icons/*", "!/pagefind/*", "!/data/*", "!/favicon.svg"]
  },
  // Created automatically on the first deploy (no database_id needed). Admin key: the ADMIN_KEY secret,
  // set in the Cloudflare dashboard (Workers & Pages → mowittall → Settings → Variables and Secrets).
  // EV = the first-party event log (worker/events.js), its own database so it never crowds the Hall photos.
  "d1_databases": [
    { "binding": "DB", "database_name": "mowittall-hall" },
    { "binding": "EV", "database_name": "mowittall-events" },
    // Email CRM: contacts, sends, opens/clicks, replies, A/B tests (worker/crm.js). Auto-created on deploy.
    { "binding": "CRM", "database_name": "mowittall-crm" }
  ],
  // Cloudflare Email Service (Workers Paid). The domain must be onboarded under Email Service → Sending.
  "send_email": [{ "name": "EMAIL" }],
  // Delivery events (bounces/complaints): once the "mowittall-mail-events" queue and its Email Service event
  // subscription exist, add:  "queues": { "consumers": [{ "queue": "mowittall-mail-events" }] },
  // Hourly at :17. The SEO autopilot (worker/seo.js) runs every hour and decides what's due; the event
  // log's nightly rebuild runs on the 7:17 UTC run (~2:17am Eastern).
  "triggers": { "crons": ["17 * * * *"] },
  "workers_dev": true
}
