---
import Base from './Base.astro';
import ShareBox from '../components/ShareBox.astro';
import { PIN_TOOLS } from '../data/pins.js';
import { processArticle } from '../lib/autolink.js';
import { topicBySlug } from '../data/topics.js';
import { ogSlug } from '../data/og.js';
import { allPosts as allPostsFn } from '../data/posts.js';
import MowCheck from '../components/MowCheck.astro';
import MowWorkout from '../components/MowWorkout.astro';
import Playlist from '../components/Playlist.astro';
import DadJokes from '../components/DadJokes.astro';
import FeedSchedule from '../components/FeedSchedule.astro';
import GrassPicker from '../components/GrassPicker.astro';
import BagDecoder from '../components/BagDecoder.astro';
import SoilTranslator from '../components/SoilTranslator.astro';
import SoilReportCard from '../components/SoilReportCard.astro';
import CritterCards from '../components/CritterCards.astro';
import WeedPlaybook from '../components/WeedPlaybook.astro';
import ChipPicker from '../components/ChipPicker.astro';
import SpreaderHelper from '../components/SpreaderHelper.astro';
import MowerLetter from '../components/MowerLetter.astro';
import { SPOTS, SPOT_GROUPS } from '../data/spotFixer.js';
import { NEEDS, NEED_GROUPS } from '../data/doINeed.js';
import { GS } from '../data/granSpray.js';
import ThirdRule from '../components/ThirdRule.astro';
import PartyCountdown from '../components/PartyCountdown.astro';
import BladeCheck from '../components/BladeCheck.astro';
import Checklist from '../components/Checklist.astro';
import SeedWatch from '../components/SeedWatch.astro';
import { WAITS, PREPOST, MULCHBAG, COMPLIMENTS, TRAINING, HIRE, PITCH } from '../data/pickers2.js';
import { TUNEUP } from '../data/tuneup.js';
import { GIFTS, RESOLUTIONS, OPENING_DAY, ROBOT, TREES } from '../data/pickers3.js';
import WeedBracket from '../components/WeedBracket.astro';
import StripePicker from '../components/StripePicker.astro';
import CrewSplit from '../components/CrewSplit.astro';
import CrewText from '../components/CrewText.astro';
import CrewGrade from '../components/CrewGrade.astro';
import { PROGRAM, PROGRAM_GROUPS } from '../data/crew.js';
const { frontmatter, url } = Astro.props;
const { title, description, tag, widget, extra, faq } = frontmatter;
const rawPath = new URL(url || Astro.url.pathname, 'https://mowittall.com').pathname;
const path = rawPath.endsWith('/') ? rawPath : rawPath + '/';
const topics = (frontmatter.topics || []).filter((t) => topicBySlug[t]);
const metaTitle = frontmatter.seoTitle ? (frontmatter.seoTitle.length + 14 <= 65 ? `${frontmatter.seoTitle} | Mow It Tall` : frontmatter.seoTitle) : `${title} | Mow It Tall`;
const metaDesc = frontmatter.seoDescription || description;
const modified = frontmatter.updated ? (frontmatter.updated instanceof Date ? frontmatter.updated.toISOString() : String(frontmatter.updated)).slice(0, 10) : '';
// Read These Next: the post's hand-picked `related:` list (posts, guides or pages), topped up with
// the posts that share the most topics.
const blogAll = allPostsFn(import.meta.glob('../pages/blog/[a-z]*.md', { eager: true }));
const guideAll = allPostsFn(import.meta.glob('../pages/guides/[a-z]*.md', { eager: true }));
const PAGES = { '/weeds/': { title: 'The Lawn Weed Board: Name That Weed', tag: 'Tool' }, '/calendar/': { title: 'Your Lawn Calendar', tag: 'Tool' } };
const byUrl = Object.fromEntries([...blogAll, ...guideAll.map((g) => ({ ...g, tag: 'Guide' }))].map((p) => [p.url, p]));
const picked = (frontmatter.related || []).map((u) => byUrl[u] || (PAGES[u] && { ...PAGES[u], url: u })).filter(Boolean);
const related = [
  ...picked,
  ...blogAll
    .filter((p) => p.url !== path && !picked.some((x) => x.url === p.url))
    .map((p) => ({ ...p, score: (p.topics || []).filter((t) => topics.includes(t)).length }))
    .filter((p) => p.score > 0)
    .sort((a, b) => b.score - a.score || new Date(b.date) - new Date(a.date)),
].slice(0, 3);
const date = (frontmatter.date instanceof Date ? frontmatter.date.toISOString() : String(frontmatter.date)).slice(0, 10);
const art = processArticle(await Astro.slots.render('default'), path, { autolink: frontmatter.autolink !== false });
const tool = frontmatter.pinTool || (widget && PIN_TOOLS[widget]) || '';
const summary = frontmatter.summary || description;
const posting = {
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date,
  dateModified: modified || date,
  inLanguage: 'en-US',
  articleSection: tag,
  keywords: topics.map((t) => topicBySlug[t].name).join(', '),
  image: [`https://mowittall.com/og/${ogSlug(path)}.png`, 'https://mowittall.com/img/backyard-stripes-1400.webp'],
  isPartOf: { '@type': 'Blog', '@id': 'https://mowittall.com/blog/#blog', name: 'The Mow It Tall blog', url: 'https://mowittall.com/blog/' },
  author: { '@type': 'Person', name: 'Mike', url: 'https://mowittall.com/about/', '@id': 'https://mowittall.com/#mike' },
  publisher: { '@id': 'https://mowittall.com/#website' },
  mainEntityOfPage: `https://mowittall.com${path}`,
};
// Posts can list `faq:` (q/a pairs) in frontmatter for FAQPage structured data
const faqLd = Array.isArray(faq) && faq.length ? {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
} : null;
const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://mowittall.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://mowittall.com/blog/' },
    ...(topics[0] ? [{ '@type': 'ListItem', position: 3, name: topicBySlug[topics[0]].name, item: `https://mowittall.com/blog/topic/${topics[0]}/` }] : []),
    { '@type': 'ListItem', position: topics[0] ? 4 : 3, name: title, item: `https://mowittall.com${path}` },
  ],
};
const jsonLd = { '@context': 'https://schema.org', '@graph': [posting, crumbs, ...(faqLd ? [faqLd] : [])] };
---
<Base title={metaTitle} description={metaDesc} path={path} jsonLd={jsonLd} type="article" published={date} modified={modified || undefined} beer={false} crumbs={false} dl={{ post_tag: tag || '', post_topics: topics.join(','), published: date }}>
  <main id="main" class="post">
    <header class="post-head">
      <nav class="crumbs" aria-label="Breadcrumb" data-pagefind-ignore><a href="/blog/">Blog</a>{topics[0] && <> <span aria-hidden="true">›</span> <a href={`/blog/topic/${topics[0]}/`}>{topicBySlug[topics[0]].name}</a></>}</nav>
      <span class="clip-tag">{tag}</span>
      <h1>{title}</h1>
    </header>
    <section class="post-short" data-pagefind-ignore aria-label="The short version">
      <p class="post-short-h">The Short Version</p>
      <p class="post-short-t">{summary}</p>
      {tool && <a class="post-short-tool" href="#tool" data-track="toc_click" data-track-target="tool"><span>Try the Tool</span> {tool.replace(/^The /, '')} <b aria-hidden="true">↓</b></a>}
    </section>
    <article class="prose prose-card">
      <Fragment set:html={art.html} />
    </article>
    {widget === 'seed-watch' && (
      <div class="post-widget" data-widget="seed-watch"><SeedWatch id="seedwatch-post" guide={false} /></div>
    )}
    {widget === 'hire-it' && (
      <div class="post-widget" data-widget="hire-it"><ChipPicker id="hire" title="Hire it or DIY?" sub="Tap the job. Get my honest call." items={HIRE} prompt="Tap a job." /></div>
    )}
    {widget === 'pitch' && (
      <div class="post-widget" data-widget="pitch"><ChipPicker id="pitch" title="Handle the objection" sub="Tap what they said. Here’s your move." items={PITCH} prompt="Tap what they said." /></div>
    )}
    {widget === 'mow-check' && (
      <div class="post-widget" data-widget="mow-check"><MowCheck /></div>
    )}
    {widget === 'mow-workout' && (
      <div class="post-widget" data-widget="mow-workout"><MowWorkout measureHref="/measure/" /></div>
    )}
    {widget === 'playlist' && (
      <div class="post-widget" data-widget="playlist"><Playlist /></div>
    )}
    {widget === 'soil-translator' && (
      <div class="post-widget" data-widget="soil-translator"><SoilTranslator /></div>
    )}
    {widget === 'bag-decoder' && (
      <div class="post-widget" data-widget="bag-decoder"><BagDecoder /></div>
    )}
    {widget === 'grass-picker' && (
      <div class="post-widget" data-widget="grass-picker"><GrassPicker id="gp-post" /></div>
    )}
    {widget === 'feed-schedule' && (
      <div class="post-widget" data-widget="feed-schedule"><FeedSchedule /></div>
    )}
    {widget === 'dad-jokes' && (
      <div class="post-widget" data-widget="dad-jokes"><DadJokes /></div>
    )}
    {widget === 'weed-playbook' && (
      <div class="post-widget" data-widget="weed-playbook"><WeedPlaybook /></div>
    )}
    {widget === 'critters' && (
      <div class="post-widget" data-widget="critters"><CritterCards /></div>
    )}
    {widget === 'spot-fixer' && (
      <div class="post-widget" data-widget="spot-fixer"><ChipPicker id="damage" title="The damage report" sub="What happened to your lawn? Tap it. I’ll tell you how worried to be (not very) and how to fix it." items={SPOTS} groups={SPOT_GROUPS} prompt="Tap what happened." /></div>
    )}
    {widget === 'spreader' && (
      <div class="post-widget" data-widget="spreader"><SpreaderHelper /></div>
    )}
    {widget === 'gran-spray' && (
      <div class="post-widget" data-widget="gran-spray"><ChipPicker id="gs" title="Granules or spray for…" sub="Tap the job. Get my honest pick." items={GS} prompt="Tap a job." /></div>
    )}
    {widget === 'gift-finder' && (
      <div class="post-widget" data-widget="gift-finder"><ChipPicker id="gift" title="The Gift Finder" sub="Tap your budget or who you’re shopping for." items={GIFTS} prompt="Tap one." /></div>
    )}
    {widget === 'resolutions' && (
      <div class="post-widget" data-widget="resolutions"><Checklist id="resolve" title="Pick Your Lawn Resolutions" sub="Tick the ones you’re signing up for. They save on your phone, so check back in June and see how you’re doing." items={RESOLUTIONS} storeKey="mit-resolutions" /></div>
    )}
    {widget === 'opening-day' && (
      <div class="post-widget" data-widget="opening-day"><Checklist id="opening" title="The Opening Day Lineup Card" sub="Tick every box and you’re cleared to play. Saves on your phone." items={OPENING_DAY} storeKey="mit-opening-day" /></div>
    )}
    {widget === 'robot' && (
      <div class="post-widget" data-widget="robot"><ChipPicker id="robot" title="What Your Robot Mower Thinks of You" sub="Tap something you do. Hear it from the robot." items={ROBOT} prompt="Tap a confession." /></div>
    )}
    {widget === 'trees' && (
      <div class="post-widget" data-widget="trees"><ChipPicker id="trees" title="What’s Dropping on Your Lawn?" sub="Tap your tree. Get the verdict and the game plan." items={TREES} prompt="Tap a tree." /></div>
    )}
    {widget === 'stripe-picker' && (
      <div class="post-widget" data-widget="stripe-picker"><StripePicker id="stripes-post" /></div>
    )}
    {widget === 'crew-split' && (
      <div class="post-widget" data-widget="crew-split"><CrewSplit /></div>
    )}
    {widget === 'crew-text' && (
      <div class="post-widget" data-widget="crew-text"><CrewText /></div>
    )}
    {widget === 'crew-grade' && (
      <div class="post-widget" data-widget="crew-grade"><CrewGrade /></div>
    )}
    {widget === 'program-decoder' && (
      <div class="post-widget" data-widget="program-decoder"><ChipPicker id="program" title="Decode Your Lawn Program" sub="Tap a visit, an add-on or a question. Get my honest call." items={PROGRAM} groups={PROGRAM_GROUPS} prompt="Tap one." fine="Most programs run 5 to 7 visits. Names and timing vary by company. Ask for yours in writing." /></div>
    )}
    {widget === 'bracket' && (
      <div class="post-widget" data-widget="bracket"><WeedBracket /></div>
    )}
    {widget === 'mower-letter' && (
      <div class="post-widget" data-widget="mower-letter"><MowerLetter /></div>
    )}
    {widget === 'do-i-need' && (
      <div class="post-widget" data-widget="do-i-need"><ChipPicker id="need" title="Do I need this?" sub="Tap the thing your neighbor bought. Get my verdict." items={NEEDS} groups={NEED_GROUPS} prompt="Tap something." /></div>
    )}
    {widget === 'seed-waits' && (
      <div class="post-widget" data-widget="seed-waits"><ChipPicker id="wait" title="How long until I can seed?" sub="Tap what you put down (or want to). Labels win, always." items={WAITS} prompt="Tap a product type." /></div>
    )}
    {widget === 'pre-post' && (
      <div class="post-widget" data-widget="pre-post"><ChipPicker id="pp" title="Pre or post?" sub="Tap your situation." items={PREPOST} prompt="Tap one." /></div>
    )}
    {widget === 'third-rule' && (
      <div class="post-widget" data-widget="third-rule"><ThirdRule /></div>
    )}
    {widget === 'mulch-bag' && (
      <div class="post-widget" data-widget="mulch-bag"><ChipPicker id="mb" title="Mulch or bag today?" sub="Tap what today’s mow looks like." items={MULCHBAG} prompt="Tap one." /></div>
    )}
    {widget === 'party' && (
      <div class="post-widget" data-widget="party"><PartyCountdown /></div>
    )}
    {widget === 'tuneup' && (
      <div class="post-widget" data-widget="tuneup"><Checklist id="tuneup" title="The DIY tune-up" sub="Tick them off. Your progress saves on your phone." items={TUNEUP} storeKey="mit-tuneup" fine="Check your mower’s manual for oil type and amounts. Anything with a big repair bill (engine, transmission) goes to a shop." /></div>
    )}
    {widget === 'blade-check' && (
      <div class="post-widget" data-widget="blade-check"><BladeCheck /></div>
    )}
    {widget === 'compliments' && (
      <div class="post-widget" data-widget="compliments"><ChipPicker id="cmp" title="They said / you say" sub="Tap what they said. I’ve got your line." items={COMPLIMENTS} prompt="Tap one." /></div>
    )}
    {widget === 'training' && (
      <div class="post-widget" data-widget="training"><ChipPicker id="train" title="The off-season program" sub="December through March. Tap a drill." items={TRAINING} prompt="Tap a drill." /></div>
    )}
    {extra === 'soil-report' && (
      <div class="post-widget" data-widget="soil-report"><SoilReportCard /></div>
    )}
    {(widget || extra) && (
      <script is:inline>
        // Move each widget into its slot: <div data-widget-slot="name"> if the post has one, else the plain <div data-widget-slot>
        (function () {
          document.querySelectorAll('[data-widget]').forEach(function (w) {
            var slot = document.querySelector('[data-widget-slot="' + w.getAttribute('data-widget') + '"]') || document.querySelector('[data-widget-slot=""]');
            if (slot) slot.replaceWith(w);
            if (!document.getElementById('tool')) w.id = 'tool';
          });
        })();
      </script>
    )}
    {Array.isArray(faq) && faq.length > 0 && (
      // Visible on the page too: FAQ structured data has to match what readers can see.
      <section class="guide-faq post-faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Common Questions</h2>
        {faq.map((f: { q: string; a: string }) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </section>
    )}
    <ShareBox path={path} title={title} kind="post" end />
    {related.length > 0 && (
      <nav class="related" aria-labelledby="related-h" data-pagefind-ignore>
        <h2 id="related-h">Read These Next</h2>
        <ul class="clip-list">
          {related.map((r) => (
            <li><a class="clip" href={r.url}><span class="clip-tag">{r.tag}</span><span class="clip-title">{r.title}</span></a></li>
          ))}
        </ul>
      </nav>
    )}
    <aside class="window post-cta" data-pagefind-ignore>
      <h2>Want This Timed for Your Yard?</h2>
      <p>Seven quick questions, one minute. A plan made for your yard, then I’ll walk you through it all year, one short email at a time.</p>
      <a class="btn" href="/plan/">Get Your Free Lawn Plan</a>
    </aside>
  </main>
</Base>
