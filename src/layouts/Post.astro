---
import Base from './Base.astro';
import BeerCallout from '../components/BeerCallout.astro';
import { topicBySlug } from '../data/topics.js';
import MowCheck from '../components/MowCheck.astro';
import MowWorkout from '../components/MowWorkout.astro';
import Playlist from '../components/Playlist.astro';
import DadJokes from '../components/DadJokes.astro';
import FeedSchedule from '../components/FeedSchedule.astro';
import GrassPicker from '../components/GrassPicker.astro';
import BagDecoder from '../components/BagDecoder.astro';
import SoilTranslator from '../components/SoilTranslator.astro';
import SoilReportCard from '../components/SoilReportCard.astro';
import CritterCards from '../components/CritterCards.astro';
import WeedPlaybook from '../components/WeedPlaybook.astro';
import ChipPicker from '../components/ChipPicker.astro';
import SpreaderHelper from '../components/SpreaderHelper.astro';
import MowerLetter from '../components/MowerLetter.astro';
import { SPOTS, SPOT_GROUPS } from '../data/spotFixer.js';
import { NEEDS, NEED_GROUPS } from '../data/doINeed.js';
import { GS } from '../data/granSpray.js';
const { frontmatter, url } = Astro.props;
const { title, description, tag, widget, extra, faq } = frontmatter;
const topics = (frontmatter.topics || []).filter((t) => topicBySlug[t]);
const date = (frontmatter.date instanceof Date ? frontmatter.date.toISOString() : String(frontmatter.date)).slice(0, 10);
const minutes = frontmatter.minutes || 2;
const pretty = new Date(date + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const path = new URL(url || Astro.url.pathname, 'https://mowittall.com').pathname;
const posting = {
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date,
  author: { '@type': 'Person', name: 'Mike', '@id': 'https://mowittall.com/#mike' },
  publisher: { '@id': 'https://mowittall.com/#website' },
  mainEntityOfPage: `https://mowittall.com${path}`,
};
// Posts can list `faq:` (q/a pairs) in frontmatter for FAQPage structured data
const faqLd = Array.isArray(faq) && faq.length ? {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
} : null;
const jsonLd = { '@context': 'https://schema.org', '@graph': faqLd ? [posting, faqLd] : [posting] };
---
<Base title={`${title} | Mow It Tall`} description={description} path={path} jsonLd={jsonLd}>
  <main id="main" class="post">
    <header class="post-head">
      <a class="post-back" href="/blog/" data-pagefind-ignore>Blog</a>
      <span class="clip-tag">{tag}</span>
      <h1>{title}</h1>
      <p class="post-dek">{description}</p>
      <p class="post-meta">By Mike, Bedford NY. <time datetime={date}>{pretty}</time>. {minutes} min read.</p>
    </header>
    <article class="prose">
      <slot />
    </article>
    {widget === 'mow-check' && (
      <div class="post-widget" data-widget="mow-check"><MowCheck /></div>
    )}
    {widget === 'mow-workout' && (
      <div class="post-widget" data-widget="mow-workout"><MowWorkout measureHref="/measure/" /></div>
    )}
    {widget === 'playlist' && (
      <div class="post-widget" data-widget="playlist"><Playlist /></div>
    )}
    {widget === 'soil-translator' && (
      <div class="post-widget" data-widget="soil-translator"><SoilTranslator /></div>
    )}
    {widget === 'bag-decoder' && (
      <div class="post-widget" data-widget="bag-decoder"><BagDecoder /></div>
    )}
    {widget === 'grass-picker' && (
      <div class="post-widget" data-widget="grass-picker"><GrassPicker id="gp-post" /></div>
    )}
    {widget === 'feed-schedule' && (
      <div class="post-widget" data-widget="feed-schedule"><FeedSchedule /></div>
    )}
    {widget === 'dad-jokes' && (
      <div class="post-widget" data-widget="dad-jokes"><DadJokes /></div>
    )}
    {widget === 'weed-playbook' && (
      <div class="post-widget" data-widget="weed-playbook"><WeedPlaybook /></div>
    )}
    {widget === 'critters' && (
      <div class="post-widget" data-widget="critters"><CritterCards /></div>
    )}
    {widget === 'spot-fixer' && (
      <div class="post-widget" data-widget="spot-fixer"><ChipPicker id="damage" title="The damage report" sub="What happened to your lawn? Tap it. I’ll tell you how worried to be (not very) and how to fix it." items={SPOTS} groups={SPOT_GROUPS} prompt="Tap what happened." /></div>
    )}
    {widget === 'spreader' && (
      <div class="post-widget" data-widget="spreader"><SpreaderHelper /></div>
    )}
    {widget === 'gran-spray' && (
      <div class="post-widget" data-widget="gran-spray"><ChipPicker id="gs" title="Granules or spray for…" sub="Tap the job. Get my honest pick." items={GS} prompt="Tap a job." /></div>
    )}
    {widget === 'mower-letter' && (
      <div class="post-widget" data-widget="mower-letter"><MowerLetter /></div>
    )}
    {widget === 'do-i-need' && (
      <div class="post-widget" data-widget="do-i-need"><ChipPicker id="need" title="Do I need this?" sub="Tap the thing your neighbor bought. Get my verdict." items={NEEDS} groups={NEED_GROUPS} prompt="Tap something." /></div>
    )}
    {extra === 'soil-report' && (
      <div class="post-widget" data-widget="soil-report"><SoilReportCard /></div>
    )}
    {(widget || extra) && (
      <script is:inline>
        // Move each widget into its slot: <div data-widget-slot="name"> if the post has one, else the plain <div data-widget-slot>
        (function () {
          document.querySelectorAll('[data-widget]').forEach(function (w) {
            var slot = document.querySelector('[data-widget-slot="' + w.getAttribute('data-widget') + '"]') || document.querySelector('[data-widget-slot=""]');
            if (slot) slot.replaceWith(w);
          });
        })();
      </script>
    )}
    {topics.length > 0 && (
      <nav class="post-topics" aria-label="More on these topics" data-pagefind-ignore>
        <span>More on:</span>
        {topics.map((t) => <a class="bf-chip" href={`/blog/topic/${t}/`}>{topicBySlug[t].name}</a>)}
      </nav>
    )}
    <BeerCallout />
    <aside class="window post-cta" data-pagefind-ignore>
      <h2>Want the short version for your yard?</h2>
      <p>Seven questions, two minutes, one plan.</p>
      <a class="btn" href="/plan/">Take the quiz</a>
    </aside>
  </main>
</Base>
