---
// Guides: straight-answer articles built for search and AI answers (blog posts are the funny ones).
// Frontmatter: title, description, seoTitle?, seoDescription?, answer (the 1–3 sentence quick answer),
// date, updated?, minutes, topics, faq [{q, a}], sources [{name, url}], tools? [[href, label]]
import Base from './Base.astro';
import PinButton from '../components/PinButton.astro';
import { topicBySlug } from '../data/topics.js';
import { allPosts } from '../data/posts.js';
import { ogSlug } from '../data/og.js';
const { frontmatter, url } = Astro.props;
const { title, description, answer, faq = [], sources = [], tools = [] } = frontmatter;
const raw = new URL(url || Astro.url.pathname, 'https://mowittall.com').pathname;
const path = raw.endsWith('/') ? raw : raw + '/';
const site = 'https://mowittall.com';
const topics = (frontmatter.topics || []).filter((t) => topicBySlug[t]);
const iso = (d) => (d instanceof Date ? d.toISOString() : String(d || '')).slice(0, 10);
const date = iso(frontmatter.date), modified = iso(frontmatter.updated) || date;
const pretty = new Date(modified + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const short = frontmatter.short || title;
const metaTitle = frontmatter.seoTitle ? (frontmatter.seoTitle.length + 14 <= 65 ? `${frontmatter.seoTitle} | Mow It Tall` : frontmatter.seoTitle) : `${title} | Mow It Tall`;
const score = (p) => (p.topics || []).filter((t) => topics.includes(t)).length;
const guides = allPosts(import.meta.glob('../pages/guides/[a-z]*.md', { eager: true }))
  .filter((g) => g.url !== path).map((g) => ({ ...g, s: score(g) })).filter((g) => g.s > 0).sort((a, b) => b.s - a.s).slice(0, 4);
const posts = allPosts(import.meta.glob('../pages/blog/[a-z]*.md', { eager: true }))
  .map((p) => ({ ...p, s: score(p) })).filter((p) => p.s > 0).sort((a, b) => b.s - a.s || new Date(b.date) - new Date(a.date)).slice(0, 3);
const jsonLd = { '@graph': [
  {
    '@type': 'Article', '@id': `${site}${path}#article`, headline: title, description, datePublished: date, dateModified: modified, inLanguage: 'en-US',
    image: [`${site}/og/${ogSlug(path)}.png`], author: { '@id': `${site}/#mike` }, publisher: { '@id': `${site}/#org` },
    mainEntityOfPage: `${site}${path}`, isPartOf: { '@type': 'CollectionPage', '@id': `${site}/guides/#guides`, name: 'Mow It Tall lawn guides', url: `${site}/guides/` },
    about: topics.map((t) => topicBySlug[t].name), ...(sources.length ? { citation: sources.map((s) => s.url) } : {}),
  },
  ...(faq.length ? [{ '@type': 'FAQPage', '@id': `${site}${path}#faq`, mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
] };
---
<Base title={metaTitle} description={frontmatter.seoDescription || description} path={path} jsonLd={jsonLd} type="article" published={date} modified={modified}
  crumbs={[['Guides', '/guides/'], [short, path]]} dl={{ post_topics: topics.join(','), published: date }}>
  <main id="main" class="post guide">
    <header class="post-head">
      <span class="clip-tag">Guide</span>
      <h1>{title}</h1>
      <p class="post-meta">By <a href="/yards/">Mike</a>, Bedford, NY. Updated <time datetime={modified}>{pretty}</time>. {frontmatter.minutes || 3} min read.</p>
    </header>
    {answer && (
      <section class="window guide-answer" aria-labelledby="qa-h">
        <h2 id="qa-h">The Short Answer</h2>
        <p set:html={answer} />
      </section>
    )}
    <article class="prose">
      <slot />
    </article>
    {tools.length > 0 && (
      <nav class="guide-tools" aria-label="Free tools for this" data-pagefind-ignore>
        <h2>Free Tools for This</h2>
        <ul>{tools.map(([href, label]) => <li><a class="bf-chip" href={href}>{label}</a></li>)}</ul>
      </nav>
    )}
    {faq.length > 0 && (
      <section class="guide-faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Common Questions</h2>
        {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </section>
    )}
    {sources.length > 0 && (
      <aside class="guide-sources" data-pagefind-ignore>
        <h2>Where This Comes From</h2>
        <p>My yard, plus university extension research for cool-season lawns:</p>
        <ul>{sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}</ul>
      </aside>
    )}
    <PinButton path={path} note="Need this again in spring?" />
    <aside class="guide-bio" data-pagefind-ignore>
      <p><b>Who’s Mike?</b> A homeowner in Bedford, NY, known around town as the lawn guy because of the stripes. No lawn company, no products to sell you. <a href="/yards/">See the yard</a>.</p>
    </aside>
    {guides.length > 0 && (
      <nav class="related guide-more" aria-labelledby="more-g" data-pagefind-ignore>
        <h2 id="more-g">More Straight Answers</h2>
        <ul class="clip-list">{guides.map((g) => <li><a class="clip" href={g.url}><span class="clip-tag">Guide</span><span class="clip-title">{g.title}</span></a></li>)}</ul>
      </nav>
    )}
    {posts.length > 0 && (
      <nav class="related" aria-labelledby="more-p" data-pagefind-ignore>
        <h2 id="more-p">The Fun Version (From the Blog)</h2>
        <ul class="clip-list">{posts.map((p) => <li><a class="clip" href={p.url}><span class="clip-tag">{p.tag}</span><span class="clip-title">{p.title}</span></a></li>)}</ul>
      </nav>
    )}
    <aside class="window post-cta" data-pagefind-ignore data-cta-loc="guide_end">
      <h2>Want This Timed for Your Yard?</h2>
      <p>Nine quick questions, two minutes, one plan with phone reminders.</p>
      <a class="btn" href="/plan/">Get My Free Lawn Plan</a>
    </aside>
  </main>
</Base>
