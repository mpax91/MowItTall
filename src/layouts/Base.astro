
---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/atkinson-hyperlegible-next/400.css';
import '@fontsource/atkinson-hyperlegible-next/700.css';
import '../styles/global.css';
import '../styles/tools.css';
import BeerCallout from '../components/BeerCallout.astro';
import RedVest from '../components/RedVest.astro';
import { TOPICS } from '../data/topics.js';
const FOOT_TOPICS = ['mowing', 'feeding', 'seeding', 'weeds', 'soil', 'gear'].map((slug) => TOPICS.find((t) => t.slug === slug)).filter(Boolean);
const FOOTER = [
  { title: 'Start Here', links: [['/plan/', 'Free Lawn Plan'], ['/lawn-101/', 'Lawn 101'], ['/calendar/', 'Lawn Calendar'], ['/search/', 'Search the Site']] },
  { title: 'Free Tools', links: [['/weeds/', 'What’s That Weed?'], ['/measure/', 'Measure Your Yard'], ['/resources/#dx', 'What’s Wrong With My Lawn?'], ['/resources/#water-h', 'Should I Water?'], ['/resources/#seed', 'Can I Seed Now?'], ['/resources/#calc', 'Lawn Calculator'], ['/resources/', 'All Free Tools']] },
  { title: 'The Blog', links: [['/blog/', 'All Posts'], ...FOOT_TOPICS.map((t) => [`/blog/topic/${t.slug}/`, t.name.replace(/\b(\w)/g, (m) => m.toUpperCase()).replace(' For ', ' for ')])] },
  { title: 'Just for Fun', links: [['/games/', 'Lawn Games'], ['/hall/', 'Hall of Fame & Shame'], ['/yards/', 'Mike’s Yard'], ['/neighbor/', 'Send to a Neighbor'], ['/merch/', 'Merch']] },
];

interface Props {
  title: string;
  description: string;
  path?: string;
  jsonLd?: object;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  published?: string;
  modified?: string;
}
const { title, description, path = '/', jsonLd, image = '/img/backyard-stripes-1400.webp', imageAlt = 'Mike’s striped backyard lawn in Bedford, NY', type = 'website', published, modified } = Astro.props;
const site = 'https://mowittall.com';
const url = site + path;
// Site-wide entities on every page, merged with the page's own structured data (deduped by @id).
const siteGraph = [
  { '@type': 'WebSite', '@id': `${site}/#website`, url: `${site}/`, name: 'Mow It Tall', alternateName: 'mowittall.com', description: 'The easy guide to a better lawn: free lawn plans, tools and short, funny lawn care advice for Westchester and the Northeast.', inLanguage: 'en-US', publisher: { '@id': `${site}/#mike` } },
  { '@type': 'Person', '@id': `${site}/#mike`, name: 'Mike', url: `${site}/`, description: 'Bedford, NY homeowner known locally as the lawn guy for his striped lawn.', homeLocation: { '@type': 'Place', name: 'Bedford, New York' }, knowsAbout: ['Lawn care', 'Cool-season grass', 'Lawn mowing', 'Lawn fertilizer', 'Overseeding'] },
];
const pageItems = !jsonLd ? [] : Array.isArray(jsonLd) ? jsonLd.flatMap((j) => j['@graph'] || [j]) : jsonLd['@graph'] || [jsonLd];
const seen = new Set();
const graph = [...pageItems.map(({ '@context': _c, ...rest }) => rest), ...siteGraph].filter((n) => !n['@id'] || (seen.has(n['@id']) ? false : (seen.add(n['@id']), true)));
const ld = { '@context': 'https://schema.org', '@graph': graph };
const NAV = [
  { href: '/lawn-101/', label: 'Lawn 101', match: (p) => p.startsWith('/lawn-101') || p.startsWith('/weeds') || p.startsWith('/yards') },
  { href: '/resources/', label: 'Resources', match: (p) => p.startsWith('/resources') || p.startsWith('/measure') },
  { href: '/blog/', label: 'Blog', match: (p) => p.startsWith('/blog') },
  { href: '/games/', label: 'Games', match: (p) => p.startsWith('/games') },
];
---
<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=GTM-MXGJGQH6"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#173d27" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Mow It Tall" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={site + image} />
    <meta property="og:image:alt" content={imageAlt} />
    {published && <meta property="article:published_time" content={published} />}
    {(modified || published) && <meta property="article:modified_time" content={modified || published} />}
    {type === 'article' && <meta property="article:author" content="Mike" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={site + image} />
    <meta name="author" content="Mike" />
    <link rel="alternate" type="application/rss+xml" title="Mow It Tall blog" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip" href="#main" data-pagefind-ignore>Skip to content</a>
    <header class="top" data-pagefind-ignore>
      <div class="top-bar">
        <a class="wordmark" href="/" aria-label="Mow It Tall home">Mow It <span class="wordmark-tall" aria-label="TALL"><span class="g g-t" aria-hidden="true">T</span><span class="g g-a" aria-hidden="true">A</span><span class="g g-l" aria-hidden="true">L</span><span class="g g-l" aria-hidden="true">L</span></span></a>
        <div class="top-right">
          <a class="top-search" href="/search/" aria-label="Search the site" aria-current={path === '/search/' ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" /></svg></a>
          <a class="top-cta" href="/plan/" aria-current={path === '/plan/' ? 'page' : undefined}>Get Plan</a>
        </div>
      </div>
      <nav class="top-nav" aria-label="Main">
        {NAV.map((n) => (
          <a href={n.href} aria-current={n.match(path) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>

    <slot />

    <footer class="footer" data-pagefind-ignore>
      <div class="foot-top">
        <a class="wordmark foot-mark" href="/" aria-label="Mow It Tall home">Mow It <span class="wordmark-tall" aria-label="TALL"><span class="g g-t" aria-hidden="true">T</span><span class="g g-a" aria-hidden="true">A</span><span class="g g-l" aria-hidden="true">L</span><span class="g g-l" aria-hidden="true">L</span></span></a>
        <p class="foot-tag">You don’t need to be a <span class="nowrap">know-it-all.</span> <span class="nowrap">Just mow it tall.</span></p>
      </div>
      <nav class="foot-cols" aria-label="Site map">
        {FOOTER.map((g) => (
          <div class="foot-col">
            <h2 class="foot-h">{g.title}</h2>
            <ul>{g.links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
          </div>
        ))}
      </nav>
      <div class="foot-extra">
        <BeerCallout compact />
        <p>No gas leaf blowers were used in the making of this website.</p>
      </div>
      <div class="foot-bottom">
        <p class="foot-copy">© {new Date().getFullYear()} Mow It Tall</p>
        <p class="red-vest-credit"><RedVest size={26} /><span>A Red Vest Creation</span></p>
      <button type="button" class="footer-lock" aria-label="Owner login" title="Owner login" data-lock>
        <svg viewBox="0 0 10 12" width="15" height="18" aria-hidden="true" shape-rendering="crispEdges">
          <path fill="currentColor" d="M3 0h4v1h1v4h1v7h-9v-7h1v-4h1zM3 2v3h4v-3h-1v-1h-2v1zM4 7v3h2v-3z" />
        </svg>
      </button>
      <dialog class="lock-dialog" data-lock-dialog>
        <form method="dialog" data-lock-form>
          <label><span>Password</span><input type="password" autocomplete="current-password" data-lock-pass required /></label>
          <p class="lock-msg" data-lock-msg role="status"></p>
          <div class="lock-actions">
            <button type="button" class="btn btn-small btn-quiet" data-lock-cancel>Cancel</button>
            <button type="submit" class="btn btn-small">Open HQ</button>
          </div>
        </form>
      </dialog>
      </div>
    </footer>
    <script>
      // Footer lock: asks for the owner password, checks it with the server (ADMIN_KEY secret), then opens /admin/.
      const lock = document.querySelector('[data-lock]');
      const dlg = document.querySelector<HTMLDialogElement>('[data-lock-dialog]');
      if (lock && dlg) {
        const pass = dlg.querySelector<HTMLInputElement>('[data-lock-pass]')!, msg = dlg.querySelector('[data-lock-msg]')!;
        lock.addEventListener('click', () => {
          let saved = ''; try { saved = localStorage.getItem('mit-admin') || ''; } catch {}
          if (saved) { location.href = '/admin/'; return; }
          msg.textContent = ''; pass.value = ''; dlg.showModal(); pass.focus();
        });
        dlg.querySelector('[data-lock-cancel]')!.addEventListener('click', () => dlg.close());
        dlg.querySelector('[data-lock-form]')!.addEventListener('submit', async (e) => {
          e.preventDefault();
          msg.textContent = 'Checking…';
          const r = await fetch('/api/admin/overview', { headers: { 'x-admin-key': pass.value } }).catch(() => null);
          if (r && r.ok) { try { localStorage.setItem('mit-admin', pass.value); } catch {} location.href = '/admin/'; return; }
          const j = r ? await r.json().catch(() => ({})) : {};
          msg.textContent = r && r.status === 503 ? 'The password isn’t set up in Cloudflare yet.' : (j as any).error === 'Wrong key.' ? 'Wrong password.' : 'Couldn’t check right now.';
        });
      }
    </script>
  </body>
</html>
