---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/atkinson-hyperlegible-next/400.css';
import '@fontsource/atkinson-hyperlegible-next/700.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  jsonLd?: object;
  image?: string;
}
const { title, description, path = '/', jsonLd, image = '/img/backyard-stripes-1400.webp' } = Astro.props;
const site = 'https://mowittall.com';
const url = site + path;
const NAV = [
  { href: '/lawn-101/', label: 'Lawn 101', match: (p) => p.startsWith('/lawn-101') || p.startsWith('/weeds') || p.startsWith('/yards') },
  { href: '/toolshed/', label: 'Toolshed', match: (p) => p.startsWith('/toolshed') },
  { href: '/blog/', label: 'Blog', match: (p) => p.startsWith('/blog') },
  { href: '/games/', label: 'Games', match: (p) => p.startsWith('/games') },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Preview build: remove noindex at launch on mowittall.com -->
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#173d27" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mow It Tall" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={site + image} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="top-bar">
        <a class="wordmark" href="/" aria-label="Mow It Tall home">Mow it <span class="wordmark-tall" aria-label="TALL"><span class="g g-t" aria-hidden="true">T</span><span class="g g-a" aria-hidden="true">A</span><span class="g g-l" aria-hidden="true">L</span><span class="g g-l" aria-hidden="true">L</span></span></a>
        <a class="top-cta" href="/plan/" aria-current={path === '/plan/' ? 'page' : undefined}>Take Quiz</a>
      </div>
      <nav class="top-nav" aria-label="Main">
        {NAV.map((n) => (
          <a href={n.href} aria-current={n.match(path) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>

    <slot />

    <footer class="footer">
      <nav class="footer-links" aria-label="More">
        <a href="/lawn-101/">Lawn 101</a><a href="/weeds/">Weed guide</a><a href="/toolshed/">Toolshed</a><a href="/blog/">Blog</a><a href="/yards/">The yards</a><a href="/games/">Games</a><a href="/plan/">Free lawn plan</a>
      </nav>
      <p>Built in Bedford, NY by Mike. Works anywhere with cool-season grass.</p>
      <p>No gas leaf blowers were used in the making of this website.</p>
    </footer>
  </body>
</html>
