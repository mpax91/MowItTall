---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/atkinson-hyperlegible-next/400.css';
import '@fontsource/atkinson-hyperlegible-next/700.css';
import '../styles/global.css';
import '../styles/tools.css';
import BeerCallout from '../components/BeerCallout.astro';
import RedVest from '../components/RedVest.astro';
import { TOPICS } from '../data/topics.js';
import { allOgPages, ogSlug } from '../data/og.js';
import { SOCIAL_PROFILES, SAME_AS, X_HANDLE, CONTACT_EMAIL } from '../data/site.js';
const OG = allOgPages();
const FOOT_TOPICS = ['mowing', 'feeding', 'seeding', 'weeds', 'soil', 'gear'].map((slug) => TOPICS.find((t) => t.slug === slug)).filter(Boolean);
const FOOTER = [
  { title: 'Start Here', links: [['/plan/', 'Free Lawn Plan'], ['/lawn-101/', 'Lawn 101'], ['/calendar/', 'Lawn Calendar'], ['/guides/', 'Lawn Guides'], ['/search/', 'Search the Site']] },
  { title: 'Free Tools', links: [['/weeds/', 'What’s That Weed?'], ['/measure/', 'Measure Your Yard'], ['/resources/#dx', 'What’s Wrong With My Lawn?'], ['/resources/#water-h', 'Should I Water?'], ['/resources/#seed', 'Can I Seed Now?'], ['/resources/#calc', 'Lawn Calculator'], ['/resources/', 'All Free Tools']] },
  { title: 'The Blog', links: [['/blog/', 'All Posts'], ...FOOT_TOPICS.map((t) => [`/blog/topic/${t.slug}/`, t.name.replace(/\b(\w)/g, (m) => m.toUpperCase()).replace(' For ', ' for ')])] },
  { title: 'Just for Fun', links: [['/games/', 'Lawn Games'], ['/hall/', 'Hall of Fame & Shame'], ['/yards/', 'Mike’s Yard'], ['/neighbor/', 'Send to a Neighbor'], ['/merch/', 'Merch']] },
];

interface Props {
  title: string;
  description: string;
  path?: string;
  jsonLd?: object;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  published?: string;
  modified?: string;
  noindex?: boolean;
  crumbs?: [string, string][] | false;
  dl?: Record<string, string | number>;
}
const { title, description, path = '/', jsonLd, image: imageProp, imageAlt: altProp, type = 'website', published, modified, noindex = false, crumbs: crumbsProp, dl = {}, shareTitle, shareDescription } = Astro.props;
// Social previews (Facebook, iMessage, X…) can use punchier copy than the search title/description.
const ogTitle = shareTitle || title;
const ogDesc = shareDescription || description;
const site = 'https://mowittall.com';
const url = site + path;
// Share image: the page's own 1200x630 card if it has one (src/data/og.js), else Mike's backyard photo.
const card = !imageProp && OG[path];
// `v` in og.js busts Facebook/LinkedIn image caches when a card is redesigned (bump it on each redesign).
const image = imageProp || (card ? `/og/${ogSlug(path)}.png${card.v ? `?v=${card.v}` : ''}` : '/img/backyard-stripes-1400.webp');
const imageAlt = altProp || (card ? `${card.title} | Mow It Tall` : 'Mike’s striped backyard lawn in Bedford, NY');
const imageType = image.endsWith('.png') ? 'image/png' : image.endsWith('.jpg') ? 'image/jpeg' : 'image/webp';
const imageSize = card ? [1200, 630] : image.includes('-1400') ? [1400, 1050] : null;
// Breadcrumbs: pages pass crumbs={[[name, href], ...]} (last = this page). Posts draw their own (crumbs={false} from Post.astro).
const crumbs = crumbsProp === false || path === '/' ? [] : crumbsProp || [];
// GA4 content grouping, pushed to the dataLayer before GTM loads (see the Analytics tab in HQ).
const pageType = path === '/' ? 'home' : path.startsWith('/blog/topic/') ? 'topic' : /^\/(blog|guides)\/$/.test(path) ? 'hub' : path.startsWith('/blog/') ? 'post' : path.startsWith('/guides/') ? 'guide'
  : ['/plan/', '/measure/', '/calendar/', '/weeds/', '/resources/'].includes(path) ? 'tool' : ['/games/', '/hall/'].includes(path) ? 'fun' : 'page';
const pageDL = { page_type: pageType, content_group: { home: 'Home', topic: 'Blog topics', hub: 'Hubs', post: 'Blog posts', guide: 'Guides', tool: 'Tools', fun: 'Games & Hall', page: 'Pages' }[pageType], ...dl };
const isAdminPage = path.startsWith('/admin');
const crumbLd = crumbs.length ? [{ '@type': 'BreadcrumbList', '@id': `${url}#breadcrumb`, itemListElement: [['Home', '/'], ...crumbs].map(([name, href], i) => ({ '@type': 'ListItem', position: i + 1, name, item: site + href })) }] : [];
// Site-wide entities on every page, merged with the page's own structured data (deduped by @id).
const siteGraph = [
  { '@type': 'WebSite', '@id': `${site}/#website`, url: `${site}/`, name: 'Mow It Tall', alternateName: 'mowittall.com', description: 'The easy guide to a better lawn: free lawn plans, tools and short, funny lawn care advice for Westchester and the Northeast.', inLanguage: 'en-US', publisher: { '@id': `${site}/#mike` } },
  { '@type': 'Person', '@id': `${site}/#mike`, name: 'Mike', url: `${site}/`, description: 'Bedford, NY homeowner known locally as the lawn guy for his striped lawn.', homeLocation: { '@type': 'Place', name: 'Bedford, New York' }, knowsAbout: ['Lawn care', 'Cool-season grass', 'Lawn mowing', 'Lawn fertilizer', 'Overseeding', 'Lawn striping'], worksFor: { '@id': `${site}/#org` }, ...(SAME_AS.length ? { sameAs: SAME_AS } : {}) },
  { '@type': 'Organization', '@id': `${site}/#org`, name: 'Mow It Tall', url: `${site}/`, slogan: 'You don’t need to be a know-it-all. Just mow it tall.', logo: { '@type': 'ImageObject', url: `${site}/icons/icon-512.png`, width: 512, height: 512 }, founder: { '@id': `${site}/#mike` }, areaServed: ['Westchester County, NY', 'Northeastern United States'], email: CONTACT_EMAIL, contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', email: CONTACT_EMAIL, url: `${site}/contact/` }, ...(SAME_AS.length ? { sameAs: SAME_AS } : {}) },
];
const pageItems = !jsonLd ? [] : Array.isArray(jsonLd) ? jsonLd.flatMap((j) => j['@graph'] || [j]) : jsonLd['@graph'] || [jsonLd];
const seen = new Set();
const graph = [...pageItems.map(({ '@context': _c, ...rest }) => rest), ...crumbLd, ...siteGraph].filter((n) => !n['@id'] || (seen.has(n['@id']) ? false : (seen.add(n['@id']), true)));
const ld = { '@context': 'https://schema.org', '@graph': graph };
const NAV = [
  { href: '/lawn-101/', label: 'Lawn 101', match: (p) => p.startsWith('/lawn-101') || p.startsWith('/weeds') || p.startsWith('/yards') },
  { href: '/resources/', label: 'Resources', match: (p) => p.startsWith('/resources') || p.startsWith('/measure') },
  { href: '/blog/', label: 'Blog', match: (p) => p.startsWith('/blog') },
  { href: '/games/', label: 'Games', match: (p) => p.startsWith('/games') },
];
---
<!doctype html>
<html lang="en">
  <head>
    <script is:inline define:vars={{ pageDL }}>window.dataLayer = window.dataLayer || []; window.dataLayer.push(pageDL);</script>
    {!isAdminPage && (<Fragment>
    <!-- Microsoft Clarity page tags (Clarity itself loads through GTM). Queued with Clarity's standard stub, so they apply whenever Clarity loads. Filter recordings by these in Clarity → Filters → Custom tags. -->
    <script is:inline define:vars={{ pageDL }}>(function(c){c.clarity=c.clarity||function(){(c.clarity.q=c.clarity.q||[]).push(arguments)};['page_type','content_group','post_tag','post_topics'].forEach(function(k){var v=pageDL[k];if(v)c.clarity('set',k,String(v).slice(0,255))})})(window);</script>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-PTSGH8QX');</script>
    <!-- End Google Tag Manager -->
    </Fragment>)}

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={url} />}
    {!noindex && <meta name="robots" content="max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    <meta name="theme-color" content="#173d27" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/icon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Mow It Tall" />
    <meta name="application-name" content="Mow It Tall" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Mow It Tall" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDesc} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={site + image} />
    <meta property="og:image:secure_url" content={site + image} />
    <meta property="og:image:type" content={imageType} />
    {imageSize && <meta property="og:image:width" content={String(imageSize[0])} />}
    {imageSize && <meta property="og:image:height" content={String(imageSize[1])} />}
    <meta property="og:image:alt" content={imageAlt} />
    {published && <meta property="article:published_time" content={published} />}
    {(modified || published) && <meta property="article:modified_time" content={modified || published} />}
    {type === 'article' && <meta property="article:author" content="Mike" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDesc} />
    <meta name="twitter:image" content={site + image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {X_HANDLE && <meta name="twitter:site" content={X_HANDLE} />}
    {X_HANDLE && <meta name="twitter:creator" content={X_HANDLE} />}
    <meta name="author" content="Mike" />
    <link rel="alternate" type="application/rss+xml" title="Mow It Tall blog" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      // GA4 events go through Google Tag Manager's dataLayer. mitTrack('event_name', { param: 'value' }).
      // Also: any element with data-track="event_name" (plus optional data-track-* params) sends that event on click.
      window.dataLayer = window.dataLayer || [];
      // Event parameters are cleared before each event so a value never carries over into the next one (GTM remembers pushed keys).
      var MIT_KEYS = 'quiz_name step_number question_id step_type answer effort_level lawn_profile grass_pick task_count game_name level_name score new_best coverage tool_name choice file_name file_extension search_term search_location results_count topic method content_type item_id cta_location cta_text link_url link_text link_area link_domain nav_area card_id question form_id form_location percent read_seconds zip3 yard_size area_count vote board amount platform target page_path page_referrer error_message error_source program_name value currency'.split(' ');
      window.mitTrack = function (event, params) {
        try { var reset = {}; MIT_KEYS.forEach(function (k) { reset[k] = undefined; }); window.dataLayer.push(reset); window.dataLayer.push(Object.assign({ event: event }, params || {})); } catch (e) {}
        try { if (window.mitLog) window.mitLog(event, params); } catch (e) {}
      };
      // Mike's own event log (worker/events.js → Cloudflare D1, kept forever, free). Every mitTrack event, plus
      // page_view and page_leave (seconds the page was actually on screen). No IP, no names: a random device id
      // (the same `mit-device` the Hall uses) and a 30-minute session. Skips /admin/, bots, Global Privacy Control,
      // and anything that isn't mowittall.com (set localStorage mit-log-test = 1 to test elsewhere).
      (function () {
        try {
          var ls = localStorage, host = location.hostname.replace(/^www\./, '');
          if (host !== 'mowittall.com' && ls.getItem('mit-log-test') !== '1') return;
          if (/^\/admin\//.test(location.pathname) || navigator.webdriver || navigator.globalPrivacyControl) return;
          var uid = function () { return crypto.randomUUID ? crypto.randomUUID() : Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 12); };
          var now = Date.now(), nv = 0, d = ls.getItem('mit-device');
          if (!d) { d = uid(); ls.setItem('mit-device', d); nv = 1; }
          var S = {}; try { S = JSON.parse(ls.getItem('mit-sess') || '{}'); } catch (e) {}
          var q = new URLSearchParams(location.search), src = q.get('utm_source'), med = q.get('utm_medium'), camp = q.get('utm_campaign');
          if (!src && q.get('gclid')) { src = 'google'; med = 'cpc'; }
          var ref = ''; try { ref = document.referrer ? new URL(document.referrer).hostname.replace(/^www\./, '') : ''; } catch (e) {}
          if (ref === host) ref = '';
          if (!src && ref) { src = ref; med = /(^|\.)(google|bing|duckduckgo|yahoo|ecosia|brave|baidu|yandex|startpage|qwant|aol)\./.test(ref) ? 'organic' : 'referral'; }
          // New session after 30 quiet minutes, or when a visitor comes back through a different link/campaign.
          if (!S.id || now - (S.last || 0) > 30 * 60000 || (src && (src !== S.src || (camp || '') !== (S.camp || '')))) {
            S = { id: uid(), src: src || '(direct)', med: med || (src ? 'referral' : '(none)'), camp: camp || '', land: location.pathname, nv: nv };
          }
          var Q = [], timer, save = function () { S.last = Date.now(); try { ls.setItem('mit-sess', JSON.stringify(S)); } catch (e) {} };
          save();
          var flush = function (beacon) {
            while (Q.length) {
              var body = JSON.stringify({ d: d, s: S.id, nv: S.nv ? 1 : 0, a: { src: S.src, med: S.med, camp: S.camp, land: S.land }, e: Q.splice(0, 25) });
              if (beacon && navigator.sendBeacon) navigator.sendBeacon('/api/e', new Blob([body], { type: 'text/plain' }));
              else fetch('/api/e', { method: 'POST', body: body, keepalive: true, headers: { 'content-type': 'text/plain' } })
                .then(function (r) { if (r.ok && pend.length) { var sent = body; pend = pend.filter(function (e) { return sent.indexOf(e.k) < 0; }); keepPend(); } }).catch(function () {});
            }
          };
          var push = function (n, x, ms) {
            Q.push({ n: n, p: location.pathname, ti: (document.title || '').slice(0, 160), x: x || undefined, ms: ms || undefined });
            save(); clearTimeout(timer); timer = setTimeout(flush, 1500);
          };
          // page_leave backup: browsers sometimes drop the goodbye beacon, so it's also kept here and re-sent from the
          // next page (the server ignores the copy by its id). Cleared once a normal send succeeds.
          var PK = 'mit-ev-pend', pend = []; try { pend = JSON.parse(ls.getItem(PK) || '[]').slice(-10); } catch (e) {}
          var keepPend = function () { try { ls.setItem(PK, JSON.stringify(pend.slice(-10))); } catch (e) {} };
          pend.forEach(function (e) { Q.push(e); });
          window.mitLog = function (n, x) { if (typeof n === 'string') push(n, x); };
          // Time on page: only while the tab is visible. Sent as page_leave whenever the page is hidden or closed.
          var shown = document.visibilityState === 'visible' ? now : 0, acc = 0;
          var leave = function () {
            if (shown) { acc += Date.now() - shown; shown = 0; }
            if (acc > 0) {
              var ev = { n: 'page_leave', p: location.pathname, ti: (document.title || '').slice(0, 160), ms: acc, k: uid(), t: Date.now() };
              Q.push(ev); pend.push(ev); keepPend(); save(); acc = 0;
            }
            clearTimeout(timer); flush(true);
          };
          document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'hidden') leave(); else shown = Date.now(); });
          addEventListener('pagehide', leave);
          push('page_view');
        } catch (e) {}
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body class={path === "/" ? "is-home" : path === "/404/" ? "is-404" : undefined} data-pt={pageType}>
    <!-- Google Tag Manager (noscript) -->
    {!isAdminPage && <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PTSGH8QX" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>}
    <!-- End Google Tag Manager (noscript) -->
    <a class="skip" href="#main" data-pagefind-ignore>Skip to content</a>
    <header class="top" data-pagefind-ignore>
      <div class="top-bar">
        <a class="wordmark" href="/" aria-label="Mow It Tall home">Mow It <span class="wordmark-tall" aria-label="TALL"><span class="g g-t" aria-hidden="true">T</span><span class="g g-a" aria-hidden="true">A</span><span class="g g-l" aria-hidden="true">L</span><span class="g g-l" aria-hidden="true">L</span></span></a>
        <div class="top-right">
          <a class="top-search" href="/search/" aria-label="Search the site" aria-current={path === '/search/' ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" /></svg></a>
          <a class="top-cta" href="/plan/" aria-current={path === '/plan/' ? 'page' : undefined}>Get Plan</a>
        </div>
      </div>
      <nav class="top-nav" aria-label="Main">
        {NAV.map((n) => (
          <a href={n.href} aria-current={n.match(path) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>

    {crumbs.length > 1 && (
      <nav class="crumbs crumbs-top" aria-label="Breadcrumb" data-pagefind-ignore>
        <ol>
          <li><a href="/">Home</a></li>
          {crumbs.map(([name, href], i) => i === crumbs.length - 1 ? <li aria-current="page">{name}</li> : <li><a href={href}>{name}</a></li>)}
        </ol>
      </nav>
    )}
    <slot />

    <footer class="footer" data-pagefind-ignore>
      <div class="foot-top">
        <a class="wordmark foot-mark" href="/" aria-label="Mow It Tall home">Mow It <span class="wordmark-tall" aria-label="TALL"><span class="g g-t" aria-hidden="true">T</span><span class="g g-a" aria-hidden="true">A</span><span class="g g-l" aria-hidden="true">L</span><span class="g g-l" aria-hidden="true">L</span></span></a>
        <p class="foot-tag">You don’t need to be a <span class="nowrap">know-it-all.</span> <span class="nowrap">Just mow it tall.</span></p>
      </div>
      <nav class="foot-cols" aria-label="Site map">
        {FOOTER.map((g) => (
          <div class="foot-col">
            <h2 class="foot-h">{g.title}</h2>
            <ul>{g.links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
          </div>
        ))}
      </nav>
      {SAME_AS.length > 0 && (
        <ul class="foot-social" aria-label="Mow It Tall on social media">
          {Object.entries(SOCIAL_PROFILES).filter(([, u]) => u).map(([k, u]) => (
            <li><a href={u} rel="me noopener" target="_blank" data-track="social_profile_click" data-track-platform={k}>{({ instagram: 'Instagram', facebook: 'Facebook', youtube: 'YouTube', tiktok: 'TikTok', x: 'X', threads: 'Threads', pinterest: 'Pinterest', reddit: 'Reddit', nextdoor: 'Nextdoor' } as any)[k] || k}</a></li>
          ))}
        </ul>
      )}
      <div class="foot-extra">
        <BeerCallout compact />
        <p>No gas leaf blowers were used in the making of this website.</p>
      </div>
      <div class="foot-bottom">
        <p class="foot-copy">© {new Date().getFullYear()} Mow It Tall <span aria-hidden="true">·</span> <a href="/privacy/">Privacy</a> <span aria-hidden="true">·</span> <a href="/contact/">Contact</a></p>
        <p class="red-vest-credit"><RedVest size={26} /><span>A Red Vest Creation</span></p>
      <button type="button" class="footer-lock" aria-label="Owner login" title="Owner login" data-lock>
        <svg viewBox="0 0 10 12" width="15" height="18" aria-hidden="true" shape-rendering="crispEdges">
          <path fill="currentColor" d="M3 0h4v1h1v4h1v7h-9v-7h1v-4h1zM3 2v3h4v-3h-1v-1h-2v1zM4 7v3h2v-3z" />
        </svg>
      </button>
      <dialog class="lock-dialog" data-lock-dialog>
        <form method="dialog" data-lock-form>
          <label><span>Password</span><input type="password" autocomplete="current-password" data-lock-pass required /></label>
          <p class="lock-msg" data-lock-msg role="status"></p>
          <div class="lock-actions">
            <button type="button" class="btn btn-small btn-quiet" data-lock-cancel>Cancel</button>
            <button type="submit" class="btn btn-small">Open HQ</button>
          </div>
        </form>
      </dialog>
      </div>
    </footer>
    <script>
      // Footer lock: asks for the owner password, checks it with the server (ADMIN_KEY secret), then opens /admin/.
      const lock = document.querySelector('[data-lock]');
      const dlg = document.querySelector<HTMLDialogElement>('[data-lock-dialog]');
      if (lock && dlg) {
        const pass = dlg.querySelector<HTMLInputElement>('[data-lock-pass]')!, msg = dlg.querySelector('[data-lock-msg]')!;
        lock.addEventListener('click', () => {
          let saved = ''; try { saved = localStorage.getItem('mit-admin') || ''; } catch {}
          if (saved) { location.href = '/admin/'; return; }
          msg.textContent = ''; pass.value = ''; dlg.showModal(); pass.focus();
        });
        dlg.querySelector('[data-lock-cancel]')!.addEventListener('click', () => dlg.close());
        dlg.querySelector('[data-lock-form]')!.addEventListener('submit', async (e) => {
          e.preventDefault();
          msg.textContent = 'Checking…';
          const r = await fetch('/api/admin/overview', { headers: { 'x-admin-key': pass.value } }).catch(() => null);
          if (r && r.ok) { try { localStorage.setItem('mit-admin', pass.value); } catch {} location.href = '/admin/'; return; }
          const j = r ? await r.json().catch(() => ({})) : {};
          msg.textContent = r && r.status === 503 ? 'The password isn’t set up in Cloudflare yet.' : (j as any).error === 'Wrong key.' ? 'Wrong password.' : 'Couldn’t check right now.';
        });
      }
    </script>
    <script is:inline>
      // Site-wide GA4 events (no edits needed in each tool). Names and params are documented in HQ → Analytics.
      (function () {
        var T = window.mitTrack, seen = {};
        var slug = function (t) { return String(t || '').toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '').slice(0, 40); };
        var where = function (el) { var s = el.closest('[data-cta-loc], section[id], aside, header, footer, .sticky-cta, nav'); return s ? (s.getAttribute('data-cta-loc') || s.id || s.className.split(' ')[0] || s.tagName.toLowerCase()) : 'body'; };
        document.addEventListener('click', function (e) {
          var el = e.target.closest && e.target.closest('a, button, [data-track]'); if (!el) return;
          var tr = el.closest('[data-track]');
          if (tr) { var p = {}; for (var k in tr.dataset) if (k.indexOf('track') === 0 && k !== 'track') p[slug(k.slice(5))] = tr.dataset[k]; T(tr.dataset.track, p); }
          var href = el.getAttribute && el.getAttribute('href');
          if (href && /^\/plan\/?(\?|#|$)/.test(href) && location.pathname.indexOf('/plan') !== 0) T('plan_cta_click', { cta_location: where(el), cta_text: (el.textContent || '').trim().slice(0, 40) });
          if (href && /^\/(guides|blog)\//.test(href) && el.closest('.related, .guide-more, .post-topics, .crumbs')) T('internal_link_click', { link_url: href, link_area: where(el) });
        }, true);
        // First real interaction with each tool on the page = tool_use (once per tool per page view)
        var toolUse = function (e) {
          var el = e.target.closest && e.target.closest('[data-tool], [data-widget], .tool, .window[id], section[id]'); if (!el) return;
          var h = el.querySelector('h2, h3');
          var name = el.getAttribute('data-tool') || el.getAttribute('data-widget') || el.id || slug(h && h.textContent);
          if (!name || seen[name] || /^(main|plan)$/.test(name)) return; seen[name] = 1;
          T('tool_use', { tool_name: slug(name) });
        };
        document.addEventListener('change', toolUse, true);
        document.addEventListener('input', function (e) { if (e.target.type === 'range' || e.target.type === 'number' || e.target.type === 'text') toolUse(e); }, true);
        document.addEventListener('click', function (e) { if (e.target.closest && e.target.closest('button, [role=button], .flip-btn, .flip-inner') && !e.target.closest('header.top, footer, .crumbs')) toolUse(e); }, true);
        // Native share sheet + copy-to-clipboard
        if (navigator.share) { var sh = navigator.share.bind(navigator); navigator.share = function (d) { T('share', { method: 'share_sheet', content_type: d && d.files ? 'image' : 'link', item_id: location.pathname }); return sh(d); }; }
        if (navigator.clipboard && navigator.clipboard.writeText) { var wt = navigator.clipboard.writeText.bind(navigator.clipboard); navigator.clipboard.writeText = function (t) { T('share', { method: 'copy', content_type: /https?:/.test(t) ? 'link' : 'text', item_id: location.pathname }); return wt(t); }; }
        // Downloads made in the browser (.ics calendars, saved images): anchors with a download attribute
        var ac = HTMLAnchorElement.prototype.click;
        HTMLAnchorElement.prototype.click = function () { if (this.download) { var ext = (this.download.split('.').pop() || '').toLowerCase(); T(ext === 'ics' ? 'calendar_download' : 'file_download', { file_name: this.download, file_extension: ext, tool_name: slug(location.pathname) || 'home' }); } return ac.apply(this, arguments); };
        // Outbound links, email/phone links, header/footer nav, chip pickers, flip cards
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href]');
          if (a) {
            var h = a.getAttribute('href') || '', txt = (a.textContent || '').trim().slice(0, 60);
            if (/^mailto:|^tel:|^sms:/.test(h)) T('contact_click', { method: h.split(':')[0], link_text: txt });
            else if (/^https?:/.test(h) && a.hostname !== location.hostname && !/mowittall\.com$/.test(a.hostname)) T('outbound_click', { link_domain: a.hostname.replace(/^www\./, ''), link_url: h.slice(0, 150), link_text: txt, link_area: where(a) });
            var nav = a.closest('header.top, footer, .crumbs');
            if (nav && h.charAt(0) === '/') T('nav_click', { nav_area: nav.tagName === 'HEADER' ? 'header' : nav.tagName === 'FOOTER' ? 'footer' : 'breadcrumb', link_text: txt, link_url: h });
          }
          var chip = e.target.closest && e.target.closest('[data-cp-chip]');
          if (chip) { var pk = chip.closest('[data-chip-picker]'); T('tool_choice', { tool_name: pk ? pk.id : 'picker', choice: chip.getAttribute('data-cp-chip') }); }
          var flip = e.target.closest && e.target.closest('.flip-btn, .flip-inner');
          if (flip) { var card = flip.closest('.flip, li, [id]'); T('card_flip', { card_id: (card && (card.id || slug(card.querySelector('h3, h2') && card.querySelector('h3, h2').textContent))) || 'card', page_type: document.body.dataset.pt || '' }); }
        }, true);
        // FAQs and other expanders
        document.addEventListener('toggle', function (e) {
          var d = e.target; if (!d || d.tagName !== 'DETAILS' || !d.open || d.closest('[data-dash]')) return;
          var s = d.querySelector('summary'), q = (s && s.textContent || '').trim().slice(0, 100);
          T(d.closest('.faq, .guide-faq') ? 'faq_open' : 'details_open', { question: q });
        }, true);
        // Every form (Hall upload, neighbor note, future email sign-ups)
        document.addEventListener('submit', function (e) { var f = e.target; T('form_submit', { form_id: f.id || f.getAttribute('data-form') || slug(f.className) || 'form', form_location: where(f) }); }, true);
        // Reading depth on posts and guides
        var art = document.querySelector('article.prose');
        if (art) {
          var marks = [25, 50, 75, 90], sentM = {}, t0 = Date.now(), doneArt = false;
          var onScroll = function () {
            var r = art.getBoundingClientRect(), pct = Math.round(Math.min(1, Math.max(0, (innerHeight - r.top) / r.height)) * 100);
            marks.forEach(function (m) { if (pct >= m && !sentM[m]) { sentM[m] = 1; T('scroll_depth', { percent: m }); } });
            if (!doneArt && r.bottom <= innerHeight + 40) { doneArt = true; T('article_complete', { read_seconds: Math.round((Date.now() - t0) / 1000) }); }
          };
          addEventListener('scroll', onScroll, { passive: true });
        }
        // Print, 404s and broken scripts
        addEventListener('beforeprint', function () { T('print_page', {}); });
        if (document.body.classList.contains('is-404')) T('page_not_found', { page_path: location.pathname.slice(0, 150), page_referrer: document.referrer.slice(0, 150) });
        var errs = 0;
        addEventListener('error', function (e) { if (e.message && !/ResizeObserver loop/.test(e.message) && errs++ < 3) T('js_error', { error_message: String(e.message).slice(0, 100), error_source: String(e.filename || '').split('/').pop().slice(0, 60) }); });
        // Location and yard size (coarse only: first 3 ZIP digits, size bucket)
        window.addEventListener('mit:place', function (e) { var z = e.detail && (e.detail.zip || ''); T('location_set', { zip3: String(z).slice(0, 3), method: e.detail && e.detail.source || 'zip' }); });
        window.addEventListener('appinstalled', function () { T('app_installed', {}); });
        window.addEventListener('mit:yard', function (e) { var t = e.detail && e.detail.total || 0; T('yard_measured', { yard_size: t < 2500 ? 'under_2500' : t < 5000 ? '2500_5000' : t < 10000 ? '5000_10000' : t < 21780 ? '10000_half_acre' : 'half_acre_plus' }); });
      })();
    </script>
  </body>
</html>
