---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { TOPICS } from '../../../data/topics.js';
import { allPosts } from '../../../data/posts.js';

export function getStaticPaths() {
  return TOPICS.map((t) => ({ params: { slug: t.slug }, props: { topic: t } }));
}
const { topic } = Astro.props;
const posts = allPosts(import.meta.glob('../[a-z]*.md', { eager: true })).filter((p) => (p.topics || []).includes(topic.slug));
const title = `${topic.name}: lawn care posts | Mow It Tall`;
const description = `${topic.blurb} Short, funny lawn care posts from Bedford, NY.`;
const others = TOPICS.filter((t) => t.slug !== topic.slug);
---
<Base title={title} description={description} path={`/blog/topic/${topic.slug}/`}>
  <main id="main" class="page">
    <header class="page-head">
      <a class="post-back" href="/blog/" data-pagefind-ignore>Blog</a>
      <h1>{topic.name}</h1>
      <p class="lede">{topic.blurb} {posts.length} post{posts.length === 1 ? '' : 's'} so far.</p>
    </header>
    {posts.length ? <PostList posts={posts} /> : <p class="lede">Nothing here yet. Soon.</p>}
    <nav class="topic-more" aria-label="Other topics">
      <h2>Other topics</h2>
      <div class="bf-chips">
        {others.map((t) => <a class="bf-chip" href={`/blog/topic/${t.slug}/`}>{t.name}</a>)}
      </div>
    </nav>
  </main>
</Base>
