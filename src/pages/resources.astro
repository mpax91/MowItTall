---
// /resources/: the tool hub. A grid of every free tool, sorted by the question in the visitor's head
// (see TOOL_CATS in src/data/tools.js for the order and why). Each card goes to that tool's own page.
// "What do you need help with?" menu (a plain select: tight, and native on phones) shows one section; the search box matches names and keywords.
// Old in-page anchors (#seedwatch, #ops-overseed, #water-h…) are forwarded to the new dedicated pages.
import Base from '../layouts/Base.astro';
import PixelIcon from '../components/PixelIcon.astro';
import { TOOLS, TOOL_CATS, TOOL_MENU, toolsIn } from '../data/tools.js';
import { TOOL_ICONS } from '../data/toolIcons.js';

const site = 'https://mowittall.com';
const title = 'Free Lawn Care Tools and Calculators | Mow It Tall';
const description =
  `${TOOLS.length} free lawn tools sorted by what you need: should I water, can I seed now, what’s wrong with my lawn, which grass seed, lawn calculator and more.`;
const abs = (h) => (h.startsWith('http') ? h : site + h);
const jsonLd = { '@graph': [
  { '@type': 'CollectionPage', '@id': `${site}/resources/#page`, name: 'Free Lawn Tools', url: `${site}/resources/`, description, mainEntity: { '@id': `${site}/resources/#tools` } },
  { '@type': 'ItemList', '@id': `${site}/resources/#tools`, name: 'Free lawn care tools', numberOfItems: TOOLS.length,
    itemListElement: TOOLS.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name, url: abs(t.href) })) },
] };
// never hide just one card behind a button
const cats = TOOL_CATS.map((c) => { const tools = toolsIn(c.id); return { ...c, tools, show: tools.length - c.show === 1 ? tools.length : c.show }; });
---
<Base title={title} description={description} path="/resources/" jsonLd={jsonLd} crumbs={[["Resources", "/resources/"]]}>
  <main id="main" class="tg-page" data-tool-grid>
    <section class="page-head page-head-hub">
      <h1>Free Lawn Tools</h1>
      <p class="lede">{TOOLS.length} free tools that do the thinking for you. No account, no email, no gas blower.</p>

      <form class="tg-form" data-tg-form>
        <label class="tg-field">
          <span class="tg-label">What Do You Need Help With?</span>
          <span class="tg-select">
            <select data-tg-select>
              <option value="">Show me everything</option>
              {TOOL_MENU.map((m) => <option value={m.id} data-name={m.name} data-cats={m.cats.join(' ')}>{m.ask}</option>)}
            </select>
            <svg viewBox="0 0 10 6" width="14" height="9" aria-hidden="true" shape-rendering="crispEdges"><path fill="currentColor" d="M0 0h2v1h1v1h1v1h2V2h1V1h1V0h2v2H9v1H8v1H7v1H6v1H4V5H3V4H2V3H1V2H0z" /></svg>
          </span>
        </label>
        <label class="tg-find">
          <span class="sr-only">Or search the tools</span>
          <svg viewBox="0 0 12 12" width="16" height="16" aria-hidden="true" shape-rendering="crispEdges"><path fill="currentColor" d="M3 1h4v1h1v1h1v4H8v1H7v1H3V8H2V7H1V3h1V2h1zm0 2v4h4V3zm5 6h1v1h1v1h1v1h-1v-1h-1v-1H8z" /></svg>
          <input type="search" placeholder="Or search: crabgrass, mower…" autocomplete="off" enterkeyhint="search" data-tg-find />
        </label>
      </form>
      <p class="tg-status" data-tg-status hidden><span data-tg-status-text></span> <button type="button" class="tg-reset" data-tg-reset>Show Everything</button></p>
    </section>

    <p class="tg-none" data-tg-none hidden>No tool for that yet. <a href="/plan/">Take the 2-minute quiz</a> or <a href="/search/">search the whole site</a>.</p>

    {cats.map((c) => {
      const hiddenN = Math.max(0, c.tools.length - c.show);
      return (
        <section class:list={['tg-sec', `tg-sec-${c.id}`]} id={`cat-${c.id}`} data-tg-sec={c.id} aria-labelledby={`tg-${c.id}-h`}>
          <div class="tg-head">
            <span class="tg-icon"><PixelIcon map={TOOL_ICONS[c.icon]} size={34} /></span>
            <div>
              <h2 id={`tg-${c.id}-h`}>{c.name}</h2>
              <p class="tg-why">{c.why}</p>
            </div>
          </div>
          <ul class:list={['tg-grid', c.id === 'start' && 'tg-grid-start']}>
            {c.tools.map((t, i) => (
              <li class="tg-item" data-tg-item data-extra={i >= c.show ? '' : undefined} data-keys={`${t.name} ${t.line} ${t.keys || ''} ${c.name}`.toLowerCase()}>
                <a class="tg-card" href={t.href} data-track="tool_click" data-track-tool_name={t.id} data-track-link_area={`resources_${c.id}`}>
                  <span class="tg-tag" data-tag={t.tag}>{t.tag === 'Live' && <i aria-hidden="true"></i>}{t.tag}</span>
                  <span class="tg-name">{t.name}</span>
                  <span class="tg-line">{t.line}</span>
                  <span class="tg-go" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
          {hiddenN > 0 && (
            <button type="button" class="tg-more" data-tg-more aria-expanded="false" data-more={`Show ${hiddenN} More`}>Show {hiddenN} More ▾</button>
          )}
        </section>
      );
    })}

    <section class="plan plan-mid" aria-labelledby="tg-plan-h">
      <div class="window plan-card">
        <h2 id="tg-plan-h">Too Many Tools? Fair.</h2>
        <p>Skip all of this. Answer seven quick questions and I’ll tell you the three or four things your lawn actually needs, in order. Then I’ll walk you through it all year, one short email at a time.</p>
        <a class="btn" href="/plan/">Get Your Free Lawn Plan</a>
      </div>
    </section>
  </main>
</Base>

<script>
  // Old one-page anchors → the tool's own page (emails, social posts and short links still use some).
  const OLD: Record<string, string> = {
    seed: '/resources/can-i-seed-now/', seedwatch: '/resources/is-my-grass-seed-working/', dx: '/resources/whats-wrong-with-my-lawn/',
    ops: '/resources/lawn-care-order-of-operations/', calc: '/resources/lawn-calculator/', spreader: '/resources/spreader-settings/',
    need: '/blog/lawn-stuff-you-dont-need/#tool', 'water-h': '/resources/should-i-water-my-lawn/', water: '/resources/should-i-water-my-lawn/',
    'soil-h': '/resources/lawn-soil-temperature/', 'measure-h': '/measure/', 'grass-h': '/resources/what-grass-seed-should-i-buy/',
    'quiz-h': '/plan/', 'nb-card-h': '/neighbor/', calendar: '/calendar/',
  };
  const h = decodeURIComponent(location.hash.slice(1));
  if (h && !h.startsWith('cat-')) {
    const to = OLD[h] || (h.startsWith('dx-') ? `/resources/whats-wrong-with-my-lawn/#${h}` : h.startsWith('ops-') ? `/resources/lawn-care-order-of-operations/#${h}` : '');
    if (to) location.replace(to);
  }

  const root = document.querySelector<HTMLElement>('[data-tool-grid]')!;
  const select = root.querySelector<HTMLSelectElement>('[data-tg-select]')!;
  const secs = [...root.querySelectorAll<HTMLElement>('[data-tg-sec]')];
  const find = root.querySelector<HTMLInputElement>('[data-tg-find]')!;
  const none = root.querySelector<HTMLElement>('[data-tg-none]')!;
  const status = root.querySelector<HTMLElement>('[data-tg-status]')!;
  let cat = '';          // menu choice (or a single section id from a #cat- link)
  let cats: string[] = [];
  const pick = (v: string) => {
    const o = [...select.options].find((x) => x.value === v && v);
    cat = o ? v : secs.some((x) => x.dataset.tgSec === v) ? v : '';
    cats = o ? o.dataset.cats!.split(' ') : cat ? [cat] : [];
  };

  const expand = (sec: HTMLElement, on: boolean) => {
    sec.classList.toggle('is-open', on);
    const b = sec.querySelector<HTMLButtonElement>('[data-tg-more]');
    if (b) { b.setAttribute('aria-expanded', String(on)); b.textContent = on ? 'Show Less ▴' : `${b.dataset.more} ▾`; }
  };

  function render() {
    const q = find.value.trim().toLowerCase();
    const words = q.split(/\s+/).filter(Boolean);
    let shown = 0;
    root.classList.toggle('is-filtered', !!(cat || q));
    secs.forEach((sec) => {
      const mine = !cat || cats.includes(sec.dataset.tgSec!);
      let n = 0;
      sec.querySelectorAll<HTMLElement>('[data-tg-item]').forEach((li) => {
        const hit = !words.length || words.every((w) => li.dataset.keys!.includes(w));
        li.hidden = !(mine && hit);
        if (!li.hidden) n++;
      });
      sec.hidden = n === 0;
      if (cat || q) sec.classList.add('is-open'); else if (!sec.dataset.userOpen) expand(sec, false);
      shown += n;
    });
    none.hidden = shown > 0;
    select.value = [...select.options].some((o) => o.value === cat) ? cat : '';
    status.hidden = !(cat || q);
    const tools = `${shown} tool${shown === 1 ? '' : 's'}`;
    root.querySelector('[data-tg-status-text]')!.textContent = cat ? `${tools} in ${select.selectedOptions[0]?.dataset.name || secs.find((x) => x.dataset.tgSec === cat)?.querySelector('h2')?.textContent}.` : `${tools} matching “${find.value.trim()}”.`;
  }

  select.addEventListener('change', () => {
    pick(select.value);
    find.value = '';
    history.replaceState(null, '', cat ? `#cat-${cat}` : location.pathname);
    render();
    (window as any).mitTrack?.('tool_choice', { tool_name: 'resources_filter', choice: cat || 'all' });
    if (cat) root.querySelector(`#cat-${cats[0]}`)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  root.querySelector('[data-tg-form]')!.addEventListener('submit', (e) => { e.preventDefault(); find.blur(); });
  root.querySelector('[data-tg-reset]')!.addEventListener('click', () => { pick(''); find.value = ''; history.replaceState(null, '', location.pathname); render(); });

  let t = 0;
  find.addEventListener('input', () => {
    pick('');
    render();
    clearTimeout(t);
    t = window.setTimeout(() => { if (find.value.trim().length > 1) (window as any).mitTrack?.('search', { search_term: find.value.trim().slice(0, 60), search_location: 'resources' }); }, 1200);
  });

  root.querySelectorAll<HTMLButtonElement>('[data-tg-more]').forEach((b) => b.addEventListener('click', () => {
    const sec = b.closest<HTMLElement>('[data-tg-sec]')!;
    const on = !sec.classList.contains('is-open');
    sec.dataset.userOpen = on ? '1' : '';
    expand(sec, on);
  }));

  // #cat-seed etc. opens that section filtered (handy for links from emails and posts)
  if (h.startsWith('cat-')) { pick(h.slice(4)); if (cat) render(); }
  window.addEventListener('hashchange', () => {
    const v = decodeURIComponent(location.hash.slice(1));
    if (v.startsWith('cat-')) { pick(v.slice(4)); find.value = ''; render(); }
  });
</script>
