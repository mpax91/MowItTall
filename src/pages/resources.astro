---
import Base from '../layouts/Base.astro';
import Calendar from '../components/Calendar.astro';
import SoilGauge from '../components/SoilGauge.astro';
import RainMeter from '../components/RainMeter.astro';
import ChipPicker from '../components/ChipPicker.astro';
import CanISeed from '../components/CanISeed.astro';
import SeedWatch from '../components/SeedWatch.astro';
import LawnCalc from '../components/LawnCalc.astro';
import SpreaderHelper from '../components/SpreaderHelper.astro';
import { DX, DX_GROUPS } from '../data/diagnose.js';
import { OPS, OPS_GROUPS } from '../data/orderOps.js';
import { NEEDS, NEED_GROUPS } from '../data/doINeed.js';

const title = 'Free Lawn Care Tools and Calculators | Mow It Tall';
const description =
  'Free lawn tools: can I seed now, is my grass seed working, what’s wrong with my lawn, order of operations, lawn calculator, spreader settings, should I water and soil temperature.';
const jump = [
  ['#seed', 'Can I seed now?'], ['#seedwatch', 'Is my seed working?'], ['#dx', 'What’s wrong?'], ['#ops', 'Order of operations'], ['#calc', 'Lawn calculator'],
  ['#spreader', 'Spreader settings'], ['#need', 'Do I need this?'], ['#water-h', 'Should I water?'], ['#measure-h', 'Measure'], ['#grass-h', 'Pick grass'],
];
---
<Base title={title} description={description} path="/resources/">
  <main id="main">
    <section class="page-head page-head-hub">
      <h1>Free Lawn Resources</h1>
      <p class="lede">Free tools and cheat sheets that do the thinking for you. No account, no email, no gas blower.</p>
      <nav class="shed-jump" aria-label="Jump to a tool">
        {jump.map(([h, t]) => <a class="bf-chip" href={h}>{t}</a>)}
      </nav>
    </section>

    <section class="plan plan-mid" aria-labelledby="quiz-h">
      <div class="window plan-card">
        <h2 id="quiz-h">Your Lawn Plan</h2>
        <p>Nine quick questions about your yard and how much effort you’ll honestly give. You get the few things that matter, in order, with phone reminders.</p>
        <a class="btn" href="/plan/">Get My Free Lawn Plan</a>
      </div>
    </section>

    <section class="tool-sec"><CanISeed /></section>
    <section class="tool-sec"><SeedWatch /></section>

    <section class="tool-sec">
      <ChipPicker id="dx" title="What’s wrong with my lawn?" sub="Tap what you’re seeing. I’ll tell you the likely cause, how to check, and the fix." items={DX} groups={DX_GROUPS} prompt="Tap what your lawn is doing." />
    </section>

    <section class="tool-sec">
      <ChipPicker id="ops" title="Order of operations" sub="Pick the job. Get the steps in the right order. Order matters more than products." items={OPS} groups={OPS_GROUPS} prompt="Tap a job." fine="Always follow the product labels. They win." />
    </section>

    <section class="tool-sec"><LawnCalc /></section>

    <section class="plan plan-mid" aria-labelledby="measure-h">
      <div class="window plan-card">
        <h2 id="measure-h">Measure Your Yard</h2>
        <p>Trace your grass on a satellite map. Each part gets its square feet written right on it, plus a total. Every tool on this page uses it.</p>
        <a class="btn" href="/measure/">Measure My Lawn</a>
      </div>
    </section>

    <section class="tool-sec"><SpreaderHelper /></section>

    <section class="tool-sec">
      <ChipPicker id="need" title="Do I need this?" sub="Tap the thing your neighbor bought. Get my verdict." items={NEEDS} groups={NEED_GROUPS} prompt="Tap something." />
    </section>

    <section class="plan plan-mid" aria-labelledby="grass-h">
      <div class="window plan-card">
        <h2 id="grass-h">Pick Your Grass Seed</h2>
        <p>Sun, shade, kids, dogs, no sprinkler? Four questions and you’ll know exactly which grass to buy and how much.</p>
        <a class="btn" href="/lawn-101/#grass">Find My Grass</a>
      </div>
    </section>

    <RainMeter />

    <SoilGauge />

    <Calendar />

    <section class="plan plan-mid" aria-labelledby="nb-card-h">
      <div class="window plan-card">
        <h2 id="nb-card-h">Know a Lawn That Needs Help?</h2>
        <p>Send your neighbor a free lawn plan. Print an anonymous note for their door, or text it.</p>
        <a class="btn" href="/neighbor/">Send It to a Neighbor</a>
      </div>
    </section>

    <section class="workbench" aria-labelledby="bench-h">
      <h2 id="bench-h">On the Workbench</h2>
      <p class="section-lede">Tools I’m building next.</p>
      <ul class="bench-list">
        <li><strong>Should I mow today?</strong> A straight yes or no for your ZIP, from rain, soil temperature and the etiquette rules.</li>
        <li><strong>Lawn alerts.</strong> A heads-up when it’s time to water, seed, feed or put down crabgrass preventer.</li>
        <li><strong>Your lawn, saved.</strong> An account with your measurements, your plan, what you’ve done and progress photos.</li>
        <li><strong>Anonymous neighbor emails.</strong> Send the site to a neighbor without them knowing it was you.</li>
      </ul>
    </section>
  </main>
</Base>
