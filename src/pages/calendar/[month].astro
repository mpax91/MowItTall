---
// Month pages (/calendar/april/ …): jobs from tasks.js (each job on ONE month: the month it lands on
// in /calendar/), copy from monthPages.js, typical soil temps for the month (MonthSoil).
import Base from '../../layouts/Base.astro';
import MonthSoil from '../../components/MonthSoil.astro';
import AutoLink from '../../components/AutoLink.astro';
import { TASKS, MONTHS_LONG, windowText } from '../../data/tasks.js';
import { TASK_LINKS } from '../../data/gamePlan.js';
import { MONTH_PAGES } from '../../data/monthPages.js';
import { NE_SOIL } from '../../data/soilNormals.js';
import { placeOf } from '../../scripts/agenda.js';

export function getStaticPaths() {
  return MONTH_PAGES.map((m, i) => ({ params: { month: m.slug }, props: { m, i } }));
}
const { m, i } = Astro.props;
const name = MONTHS_LONG[i];
const n = i + 1;
const site = 'https://mowittall.com';
const path = `/calendar/${m.slug}/`;
const Y = 2026;
const jobs = TASKS.filter((t) => placeOf(t, Y).getMonth() + 1 === n).sort((a, b) => a.level - b.level || placeOf(a, Y) - placeOf(b, Y));
const core = jobs.filter((t) => t.level <= 1), extra = jobs.filter((t) => t.level >= 2);
const pi = (i + 11) % 12, ni = (i + 1) % 12;
const prev = MONTH_PAGES[pi], next = MONTH_PAGES[ni];
const title = `Lawn Care in ${name}: What to Do (and Skip) | Mow It Tall`;
const strip = (h) => h.replace(/<[^>]+>/g, '');
const cut = (t, k) => (t.length <= k ? t : t.slice(0, t.lastIndexOf(' ', k - 1)).replace(/[,;:]$/, '') + '…');
const description = cut(`Northeast lawn care in ${name}: ${strip(m.answer)}`, 158);
const soil = NE_SOIL[i];
const jsonLd = { '@graph': [
  { '@type': 'Article', '@id': `${site}${path}#article`, headline: `Lawn Care in ${name}`, description, datePublished: '2026-11-16', dateModified: '2026-11-16', inLanguage: 'en-US',
    author: { '@id': `${site}/#mike` }, publisher: { '@id': `${site}/#org` }, mainEntityOfPage: `${site}${path}`, image: [`${site}/og/calendar-${m.slug}.png`] },
] };
const [lead, ...rest] = m.answer.split('. ');
---
<Base title={title} description={description} path={path} jsonLd={jsonLd} crumbs={[['Lawn Calendar', '/calendar/'], [name, path]]} dl={{ post_topics: 'calendar' }}>
  <main id="main" class="post guide mo">
    <header class="post-head">
      <span class="clip-tag">Lawn Calendar</span>
      <h1>Lawn Care in {name}</h1>
    </header>
    <section class="window guide-answer" aria-labelledby="qa-h">
      <h2 id="qa-h">What to Do in {name}</h2>
      <p set:html={`<b>${lead}${rest.length ? '.' : ''}</b> ${rest.join('. ')}`} />
    </section>

    <article class="prose">
      <AutoLink self={path}>
        <p set:html={m.intro} />
        {m.note && <p class="mo-note" set:html={m.note} />}

        <h2>{name} Lawn Jobs</h2>
        {jobs.length > 0 ? (
          <>
            {core.length > 0 && <h3>For Everyone</h3>}
            <ul class="mo-jobs">
              {core.map((t) => (
                <li><strong>{t.title.replace(/\s*\(Lawn Psycho only\)/, "")}</strong> <span class="mo-when">{windowText(t)}</span><br />{t.short} {t.why}{t.tip && <> <em>{t.tip}</em></>}{TASK_LINKS[t.id] && <> <a class="mo-link" href={TASK_LINKS[t.id][0]}>{TASK_LINKS[t.id][1]} →</a></>}</li>
              ))}
            </ul>
            {extra.length > 0 && (
              <>
                <h3>Extra Credit</h3>
                <ul class="mo-jobs">
                  {extra.map((t) => (
                    <li><strong>{t.title.replace(/\s*\(Lawn Psycho only\)/, "")}</strong> <span class="mo-when">{windowText(t)}</span><br />{t.short} {t.why}{t.tip && <> <em>{t.tip}</em></>}{TASK_LINKS[t.id] && <> <a class="mo-link" href={TASK_LINKS[t.id][0]}>{TASK_LINKS[t.id][1]} →</a></>}</li>
                  ))}
                </ul>
              </>
            )}
          </>
        ) : (
          <p>None on the calendar. That’s not a typo. The best thing you can do for your lawn in {name} is leave it alone.</p>
        )}
        {m.extra.length > 0 && (
          <>
            <h3>Also Worth Doing</h3>
            <ul>{m.extra.map((x) => <li set:html={x} />)}</ul>
          </>
        )}

        <h2>Mowing in {name}</h2>
        <p set:html={m.mow} />

        <h2>What to Skip in {name}</h2>
        <ul class="mo-skip">{m.skip.map((x) => <li set:html={x} />)}</ul>

        <h2>Go by the Soil, Not the Date</h2>
        <p>Grass and weeds go by soil temperature, not the calendar. Around here, {name} soil usually runs from about {Math.min(soil.early, soil.late)}°F to {Math.max(soil.early, soil.late)}°F. A warm or cold year can shift everything by a couple of weeks.</p>
      </AutoLink>
    </article>

    <div class="tp-tool"><MonthSoil month={n} /></div>

    <nav class="mo-nav" aria-label="Other months" data-pagefind-ignore>
      <div class="mo-pn">
        <a class="mo-step mo-prev" href={`/calendar/${prev.slug}/`} rel="prev"><span>Previous</span><b>← {MONTHS_LONG[pi]}</b></a>
        <a class="mo-step mo-next" href={`/calendar/${next.slug}/`} rel="next"><span>Next</span><b>{MONTHS_LONG[ni]} →</b></a>
      </div>
      <a class="mo-all" href="/calendar/">See the Full Lawn Calendar</a>
    </nav>

    <aside class="window post-cta" data-pagefind-ignore data-cta-loc="month_end">
      <h2>Want It Made for Your Yard?</h2>
      <p>Seven quick questions and you get a plan made for your yard. Then I’ll email you right when each job comes up, all year.</p>
      <a class="btn" href="/plan/">Get Your Free Lawn Plan</a>
    </aside>
  </main>
</Base>
