---
import Base from '../layouts/Base.astro';
import { PHOTOS } from '../data/photos.js';

const title = 'The yards: lawn stripe photos from Bedford, NY | Mow It Tall';
const description = 'Real lawns, real stripes, no filters. Photos from Mike’s yard in Bedford, NY, and soon, yours.';
---
<Base title={title} description={description} path="/yards/">
  <main id="main" class="page">
    <header class="page-head">
      <h1>The yards</h1>
      <p class="lede">No filters, no landscaping crew, no lawn-care company. Just a regular push mower, set tall, and a little stubbornness.</p>
    </header>
    <div class="gallery">
      {PHOTOS.map((p, i) => (
        <figure class:list={['photo', i === 0 && 'photo-hero']}>
          <img
            src={`/img/${p.src}-800.webp`}
            srcset={`/img/${p.src}-800.webp 800w, /img/${p.src}-1400.webp 1400w`}
            sizes="(min-width: 900px) 820px, 100vw"
            width={p.w} height={p.h} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" alt={p.alt}
          />
          <figcaption>{p.caption}</figcaption>
        </figure>
      ))}
    </div>
    <section class="window submit-card" aria-labelledby="submit-h">
      <h2 id="submit-h">Got stripes? Show off.</h2>
      <p>Soon you’ll be able to post your yard here and let the neighborhood vote. Best stripes in town get bragging rights and absolutely nothing else.</p>
      <p class="soon">Coming this spring</p>
    </section>
  </main>
</Base>
