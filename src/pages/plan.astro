---
import Base from '../layouts/Base.astro';

const title = 'Get your lawn game plan: a 2-minute quiz | Mow It Tall';
const description =
  'Nine quick questions about your yard and your effort level. Get a free lawn care plan with calendar reminders, timed for Westchester and the Northeast.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Lawn game plan quiz',
  description,
  url: 'https://mowittall.com/plan/',
  isPartOf: { '@id': 'https://mowittall.com/#website' },
};
---
<Base title={title} description={description} path="/plan/" jsonLd={jsonLd}>
  <main id="main" class="quiz" data-quiz>
    <div class="quiz-intro">
      <h1>Your Lawn Game Plan</h1>
      <p>Nine quick questions, about two minutes. No email required. Be honest about the effort part. We won’t judge. Much.</p>
    </div>

    <div class="window quiz-card" data-card>
      <div class="quiz-progress" aria-hidden="true"><span data-bar></span></div>
      <p class="quiz-step-count" data-count></p>
      <h2 class="quiz-q" data-q></h2>
      <p class="quiz-hint" data-hint></p>
      <div data-body></div>
      <div class="quiz-nav">
        <button type="button" class="quiz-back" data-back>Back</button>
        <button type="button" class="btn" data-next>Next</button>
      </div>
    </div>

    <section class="plan-result" data-result hidden aria-live="polite"></section>

    <noscript>
      <p>The quiz needs JavaScript. In the meantime, the <a href="/">calendar on the home page</a> shows the general plan.</p>
    </noscript>
  </main>

  <script>
    import { initQuiz } from '../scripts/quiz.js';
    const el = document.querySelector('[data-quiz]');
    if (el) initQuiz(el);
  </script>
</Base>
