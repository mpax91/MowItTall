---
// Dedicated lawn calendar: a vertical schedule (like a phone calendar's Schedule view),
// filtered by effort level, starting today. The homepage keeps the sideways month strip.
import Base from '../layouts/Base.astro';
import { agendaHTML, yearMonths, LEVELS, KINDS } from '../scripts/agenda.js';

const title = 'Lawn Care Calendar for the Northeast: What to Do Each Month';
const description =
  'A month-by-month lawn care schedule for Westchester and the Northeast. Every job with its date window, starting today, sized to how much effort you want to put in.';
const year = new Date().getFullYear();
const serverHTML = agendaHTML({ months: yearMonths(year), level: 3 });

const faqs = [
  {
    q: 'What should I do to my lawn each month?',
    a: 'In the Northeast: sharpen the blade and raise the mower in March, crabgrass preventer in April, a light feeding around Memorial Day, mow tall and water deep all summer, seed and feed around Labor Day, feed again around Columbus Day, keep leaves off it in fall, and put the mower away in December. January and February: stay off it.',
  },
  {
    q: 'When is the best time to fertilize a lawn in the Northeast?',
    a: 'Labor Day. If you only feed once a year, feed then. Grass grows most of its roots in fall. Memorial Day and Columbus Day are the next two worth doing.',
  },
  {
    q: 'Can I put this calendar on my phone?',
    a: 'Yes. Tap “Add to My Phone Calendar” and it downloads a calendar file with a reminder for each job. It repeats every year, so you only do it once.',
  },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base title={title} description={description} path="/calendar/" jsonLd={jsonLd}>
  <main id="main">
    <section class="page-head page-head-hub">
      <h1>The Lawn Calendar</h1>
      <p class="lede">Every lawn job for the year, in order, starting today. Pick how much effort you want and the list shrinks to match. Timing is set for Westchester &amp; the Northeast.</p>
    </section>

    <section class="ag-wrap" data-agenda-root>
      <div class="ag-controls window">
        <p class="ag-ctl-label" id="ag-lv-h">How Much Effort?</p>
        <div class="ag-seg" role="group" aria-labelledby="ag-lv-h">
          {LEVELS.map((l, i) => (
            <button type="button" data-level={i} aria-pressed={i === 3 ? 'true' : 'false'}><b>{l.name}</b><span>{l.note}</span></button>
          ))}
        </div>
        <p class="ag-count" data-count aria-live="polite"></p>
        <ul class="ag-legend" aria-label="Colors">
          {Object.entries(KINDS).map(([k, v]) => <li class={`is-${k}`}>{v.name}</li>)}
        </ul>
        <button type="button" class="btn ag-ics" data-ics>Add to My Phone Calendar</button>
      </div>

      <button type="button" class="ag-earlier" data-earlier hidden>Show Earlier Months ▴</button>
      <div class="ag-list" data-agenda set:html={serverHTML} />
      <p class="ag-foot">That’s a full year. It all starts over in March. <a href="/plan/">Get your free lawn plan</a> for one built around your yard.</p>

      <a class="ag-jump" href="#today" data-jump hidden>Today ▴</a>
    </section>

    <section class="faq" aria-labelledby="faq-h">
      <h2 id="faq-h">Quick Answers</h2>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>
  </main>
</Base>

<script>
  import { agendaHTML, rollingMonths, tasksFor, icsFor } from '../scripts/agenda.js';

  const root = document.querySelector('[data-agenda-root]');
  const listEl = root.querySelector('[data-agenda]');
  const earlier = root.querySelector('[data-earlier]');
  const jump = root.querySelector('[data-jump]');
  const count = root.querySelector('[data-count]');
  const buttons = [...root.querySelectorAll('[data-level]')];
  const today = new Date();
  const y = today.getFullYear(), m = today.getMonth() + 1;

  // effort: last pick on this page, else the quiz answer, else Curb Appeal Hunter
  let level = 2;
  try {
    const saved = localStorage.getItem('mit-cal-level');
    const q = JSON.parse(localStorage.getItem('mit-quiz') || '{}');
    if (saved != null) level = Number(saved);
    else if (q && q.effort != null) level = Number(q.effort);
  } catch { /* private mode */ }
  level = Math.min(3, Math.max(0, level || 0));
  let showEarlier = false;

  function render() {
    const months = showEarlier ? rollingMonths(y, 1, m - 1 + 12) : rollingMonths(y, m, 12);
    listEl.innerHTML = agendaHTML({ months, today, level });
    earlier.hidden = showEarlier || m === 1;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.level) === level)));
    const n = tasksFor(level).length;
    const mins = tasksFor(level).reduce((s, t) => s + (t.minutes || 0), 0);
    const hrs = Math.round(mins / 60);
    count.textContent = `${n} jobs a year. ${mins < 60 ? 'Under an hour of work' : `About ${hrs} hour${hrs === 1 ? '' : 's'} of work`}, total (plus mowing).`;
    watchToday();
  }

  // the floating "Today" pill shows once the today line is off screen
  let io;
  function watchToday() {
    io?.disconnect();
    const line = listEl.querySelector('[data-today]');
    if (!line || !('IntersectionObserver' in window)) return;
    io = new IntersectionObserver(([e]) => { jump.hidden = e.isIntersecting || e.boundingClientRect.top > innerHeight; });
    io.observe(line);
  }
  jump.addEventListener('click', (e) => {
    e.preventDefault();
    listEl.querySelector('[data-today]')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  buttons.forEach((b) => b.addEventListener('click', () => {
    level = Number(b.dataset.level);
    try { localStorage.setItem('mit-cal-level', String(level)); } catch { /* private mode */ }
    render();
  }));

  // reveal January..last month above, keeping the view where it was
  earlier.addEventListener('click', () => {
    const anchor = listEl.querySelector('.ag-month');
    const before = anchor.getBoundingClientRect().top;
    const key = anchor.dataset.ym;
    showEarlier = true;
    render();
    const same = listEl.querySelector(`[data-ym="${key}"]`);
    scrollBy(0, same.getBoundingClientRect().top - before);
  });

  root.querySelector('[data-ics]').addEventListener('click', () => {
    const blob = new Blob([icsFor(level, today)], { type: 'text/calendar' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'mow-it-tall-lawn-calendar.ics';
    document.body.append(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 4000);
  });

  // opening a "Happening now" link opens that job's card
  listEl.addEventListener('click', (e) => {
    const a = e.target.closest('.ag-now-list a');
    if (!a) return;
    e.preventDefault();
    const id = a.getAttribute('href');
    // started last month or earlier: bring the earlier months back first
    if (!document.querySelector(id) && !showEarlier) { showEarlier = true; render(); }
    const card = document.querySelector(id);
    if (card) { e.preventDefault(); card.open = true; card.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
  });

  render();
</script>
