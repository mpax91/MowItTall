---
// Dedicated lawn calendar. Step 1: pick an effort level. Step 2: the calendar builds below,
// in the normal page scroll (no inner scroll box), from this month through last month.
import Base from '../layouts/Base.astro';
import { LEVELS, levelShort, levelCost, money } from '../scripts/agenda.js';
import { MONTHS, MONTHS_LONG } from '../data/tasks.js';

const title = 'Lawn Care Calendar for the Northeast: What to Do Each Month';
const description =
  'A month-by-month lawn care schedule for the Northeast. Pick how much effort you want and get every job with its date window, starting this month.';
---
<Base title={title} description={description} path="/calendar/" crumbs={[["Lawn Calendar", "/calendar/"]]}>
  <main id="main" data-gate>
    <section class="page-head page-head-hub">
      <h1>The Lawn Calendar</h1>
      <p class="lede">Every lawn job for the year, starting this month. Pick your effort level and I’ll build your calendar.</p>
    </section>

    <section class="ag-wrap" data-agenda-root>
      <div class="ag-controls window" id="effort">
        <h2 class="ag-ctl-label" id="ag-lv-h">How Much Effort Will You Put In?</h2>
        <p class="ag-pick" data-pick>Pick one to build your calendar.</p>
        <div class="ag-seg" role="group" aria-labelledby="ag-lv-h">
          {LEVELS.map((l, i) => (
            <button type="button" data-level={i} aria-pressed="false"><b>{l.name}</b><span>{l.note}</span><em>{levelShort(i)}</em><em class="ag-cost" data-cost>{money(levelCost(i))}</em></button>
          ))}
        </div>
      </div>

      <div class="ag-cal" data-cal hidden>
        <div class="ag-cal-head">
          <h2 class="ag-cal-title" data-cal-title tabindex="-1">Your Lawn Year</h2>
          <p class="ag-react"><span>What the neighbors will say</span><q data-cal-sub></q></p>
        </div>
        <nav class="ag-pills" aria-label="Jump to a month">
          <ul data-pills>
            {MONTHS_LONG.map((name, i) => <li><a href={`/calendar/${name.toLowerCase()}/`} data-m={i + 1}>{MONTHS[i]}</a></li>)}
          </ul>
        </nav>
        <div class="ag-months" data-agenda></div>
        <div class="ag-nudge" data-nudge></div>
        <div class="ag-end window">
          <h2 class="ag-end-h">Put It on Your Phone</h2>
          <p>One reminder for each job. It repeats every year, so you only do this once.</p>
          <button type="button" class="btn ag-ics" data-ics>Add to My Phone Calendar</button>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import { agendaHTML, rollingMonths, icsFor, levelCost, money, BASE_SQFT, LEVELS } from '../scripts/agenda.js';

  const root = document.querySelector('[data-agenda-root]');
  const cal = root.querySelector('[data-cal]');
  const listEl = root.querySelector('[data-agenda]');
  const titleEl = root.querySelector('[data-cal-title]');
  const subEl = root.querySelector('[data-cal-sub]');
  const pills = root.querySelector('[data-pills]');
  const nudge = root.querySelector('[data-nudge]');
  const buttons = [...root.querySelectorAll('[data-level]')];
  const today = new Date();
  const y = today.getFullYear(), m = today.getMonth() + 1;
  const months = rollingMonths(y, m, 12); // this month first, last month at the bottom
  const track = (name, p) => { try { (window as any).mitTrack?.(name, p); } catch { /* ignore */ } };
  let level = -1;

  // size the costs to the visitor's measured lawn, if they used the measure tool
  let sqft = BASE_SQFT;
  try {
    const yard = JSON.parse(localStorage.getItem('mit-yard') || 'null');
    if (yard && yard.total > 300) sqft = Math.round(yard.total);
  } catch { /* private mode */ }
  if (sqft !== BASE_SQFT) {
    buttons.forEach((b) => { b.querySelector('[data-cost]').textContent = money(levelCost(Number(b.dataset.level), sqft)); });
  }

  // month pills in calendar order (this month first), each jumps to its month
  const byM = Object.fromEntries([...pills.querySelectorAll('li')].map((li) => [li.querySelector('a').dataset.m, li]));
  months.forEach(({ y: yy, m: mm }) => {
    const li = byM[mm];
    const a = li.querySelector('a');
    a.dataset.target = `m-${yy}-${mm}`;
    if (mm === m && yy === y) a.classList.add('is-now');
    pills.append(li);
  });
  pills.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('a');
    if (!a) return;
    const sec = document.getElementById(a.dataset.target);
    if (!sec) return;
    e.preventDefault();
    sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  function nudgeHTML() {
    const out = [];
    if (level > 0) out.push(`<p><b>Too much?</b> <button type="button" data-go="${level - 1}">Try ${LEVELS[level - 1].name}</button> for something more manageable.</p>`);
    if (level < 3) out.push(`<p><b>Too easy?</b> <button type="button" data-go="${level + 1}">Try ${LEVELS[level + 1].name}</button> to see what a little more effort looks like.</p>`);
    return out.join('');
  }

  function show(lv, { scroll = true } = {}) {
    level = lv;
    try { localStorage.setItem('mit-cal-level', String(level)); } catch { /* private mode */ }
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.level) === level)));
    listEl.innerHTML = agendaHTML({ months, today, level, sqft });
    titleEl.textContent = `Your Lawn Year: ${LEVELS[level].name}`;
    subEl.textContent = LEVELS[level].react;
    nudge.innerHTML = nudgeHTML();
    cal.hidden = false;
    main.removeAttribute('data-gate');
    pick.textContent = 'Pick one to build your calendar.';
    if (scroll) {
      requestAnimationFrame(() => {
        cal.scrollIntoView({ behavior: 'smooth', block: 'start' });
        titleEl.focus({ preventScroll: true });
      });
    }
  }

  buttons.forEach((b) => b.addEventListener('click', () => {
    show(Number(b.dataset.level));
    track('tool_choice', { tool_name: 'lawn_calendar', choice: LEVELS[level].name });
  }));
  nudge.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-go]') as HTMLElement;
    if (!b) return;
    show(Number(b.dataset.go));
    track('tool_choice', { tool_name: 'lawn_calendar', choice: LEVELS[level].name, method: 'nudge' });
  });

  root.querySelector('[data-ics]').addEventListener('click', () => {
    const blob = new Blob([icsFor(level, today)], { type: 'text/calendar' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'mow-it-tall-lawn-calendar.ics';
    document.body.append(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 4000);
    track('calendar_download', { tool_name: 'lawn_calendar', choice: LEVELS[level].name });
  });

  // Until a level is picked, the page ends at the effort box (CSS hides the footer via main[data-gate]).
  // Trying to scroll first wiggles the box and flashes the "Pick one" line.
  const main = document.querySelector('main');
  const box = root.querySelector('.ag-controls');
  const pick = root.querySelector('[data-pick]');
  let last = 0, startY = 0;
  function prompt() {
    if (!main.hasAttribute('data-gate')) return;
    const now = Date.now();
    if (now - last < 1200) return;
    last = now;
    box.classList.remove('is-nudge'); void box.offsetWidth; box.classList.add('is-nudge');
    pick.textContent = 'Pick one first to see your calendar.';
    track('calendar_gate_prompt', { tool_name: 'lawn_calendar' });
  }
  addEventListener('wheel', (e) => { if (e.deltaY > 0) prompt(); }, { passive: true });
  addEventListener('touchstart', (e) => { startY = e.touches[0].clientY; }, { passive: true });
  addEventListener('touchmove', (e) => { if (startY - e.touches[0].clientY > 30) prompt(); }, { passive: true });
  addEventListener('keydown', (e) => { if (['ArrowDown', 'PageDown', ' ', 'End'].includes(e.key) && !(e.target as HTMLElement).closest('button')) prompt(); });
</script>
