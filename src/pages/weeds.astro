---
import Base from '../layouts/Base.astro';
import FlipCards from '../components/FlipCards.astro';
import { WEEDS, WEED_GROUPS } from '../data/weeds.js';

const title = 'Common Lawn Weeds in the Northeast, With Photos | Mow It Tall';
const description =
  'Photos of the most common Northeast lawn weeds (dandelion, clover, crabgrass, nutsedge, moss and more), plus the easy fix and when to let it be.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Common lawn weeds in the Northeast',
  itemListElement: WEEDS.map((w, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: w.name,
    url: `https://mowittall.com/weeds/#${w.id}`,
  })),
};
const card = (w) => ({
  id: w.id,
  photos: w.photos.map((p) => ({ src: `/img/weeds/${w.id}-${p.n}`, alt: p.alt, caption: p.caption })),
  title: w.name,
  sub: w.looks,
  back: [
    { label: 'When: ', text: w.when },
    { label: 'Easy fix: ', text: w.easy },
    { label: 'Mike’s fix: ', text: w.mike },
    { label: 'Or just let it be: ', text: w.chill },
  ],
});
const groups = WEED_GROUPS.map((g) => ({ ...g, items: WEEDS.filter((w) => w.group === g.id).map(card) }));
---
<Base title={title} description={description} path="/weeds/" jsonLd={jsonLd}>
  <main id="main" class="page">
    <header class="page-head">
      <h1>The weed board</h1>
      <p class="lede">The weeds you’ll actually see around Bedford and the rest of the Northeast. Swipe the photos to find the one that looks like yours, then tap it for the fix.</p>
      <nav class="weed-jump" aria-label="Weed types">
        {WEED_GROUPS.map((g) => <a class="weed-chip" href={`#group-${g.id}`}>{g.title}</a>)}
      </nav>
    </header>
    {groups.map((g) => (
      <section class="weed-sec" aria-labelledby={`group-${g.id}`}>
        <h2 class="weed-group" id={`group-${g.id}`}>{g.title}</h2>
        {g.note && <p class="weed-group-note">{g.note}</p>}
        <FlipCards items={g.items} layout="list" headingLevel="h3" />
      </section>
    ))}
    <p class="page-note">
      Before you spray anything: thick, tall grass is the best weed killer there is. Most weeds are just
      filling in where grass is thin. Always follow the product label.
    </p>
    <section class="weed-sec photo-credits" aria-labelledby="credits-h">
      <h2 id="credits-h">Photo credits</h2>
      <p>All photos are used under free licenses, cropped and resized.</p>
      <ul>
        {WEEDS.map((w) => (
          <li>
            <strong>{w.name}:</strong>{' '}
            {w.photos.map((p, j) => (
              <span>
                {j > 0 && '; '}{p.caption.toLowerCase()} by <a href={p.source} rel="noopener">{p.by}</a>,{' '}
                {p.licenseUrl ? <a href={p.licenseUrl} rel="noopener license">{p.license}</a> : p.license}
              </span>
            ))}
          </li>
        ))}
      </ul>
    </section>
  </main>
</Base>
