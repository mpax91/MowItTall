---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Mow It Tall" description="That page got mowed. Try the blog, free resources or a free lawn plan." path="/404/">
  <main id="main" class="page">
    <header class="page-head">
      <h1>This page got scalped.</h1>
      <p class="lede">Whatever was here is gone. Cut too short, probably. Try one of these instead:</p>
    </header>
    <div class="bf-chips">
      <a class="bf-chip" href="/plan/">Free lawn plan</a>
      <a class="bf-chip" href="/blog/">Blog</a>
      <a class="bf-chip" href="/resources/">Resources</a>
      <a class="bf-chip" href="/weeds/">Weed guide</a>
      <a class="bf-chip" href="/search/">Search</a>
    </div>
  </main>
</Base>
