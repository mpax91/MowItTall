---
import Base from '../layouts/Base.astro';
import FlipCards from '../components/FlipCards.astro';
import GrassPicker from '../components/GrassPicker.astro';
import { changeCards } from '../data/changes.js';
import { WEEDS } from '../data/weeds.js';
import { PHOTOS } from '../data/photos.js';

const title = 'Lawn Care 101 for Beginners in the Northeast | Mow It Tall';
const description =
  'Lawn care basics for beginners in Westchester and the Northeast: six small habits, which grass seed to buy, common weeds and real yard photos.';
const faqs = [
  {
    q: 'How high should I mow my lawn?',
    href: '/guides/how-high-to-mow-grass/',
    a: 'For most lawns in New York and the Northeast, 3.5 to 4 inches. Taller grass shades the soil so weed seeds can’t sprout, and it grows deeper roots so it stays green in summer.',
  },
  {
    q: 'When should I put down crabgrass preventer in Westchester?',
    href: '/guides/crabgrass-preventer-timing/',
    a: 'When the soil warms to about 55°F, usually early to mid April around Bedford. A good clue: put it down when the forsythia bushes are blooming.',
  },
  {
    q: 'Should I bag my grass clippings?',
    href: '/blog/mulching-vs-bagging/',
    a: 'No. Leave them on the lawn. They break down quickly and return nutrients to the soil. Bag only if the grass got very long and the clippings are clumping.',
  },
  {
    q: 'When is the best time to seed a lawn in New York?',
    href: '/guides/when-to-overseed-lawn/',
    a: 'Late August through September. The soil is still warm, the air is cooler, and there are fewer weeds competing with new grass.',
  },
  {
    q: 'How often should I water my lawn?',
    href: '/guides/how-often-to-water-lawn/',
    a: 'Once or twice a week, deeply, in the early morning. Aim for about an inch of water a week, counting rain. Short daily watering grows shallow roots.',
  },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base title={title} description={description} path="/lawn-101/" crumbs={[["Lawn 101", "/lawn-101/"]]} jsonLd={jsonLd}>
  <main id="main">
    <section class="page-head page-head-hub">
      <h1>Lawn 101</h1>
      <p class="lede">Everything a beginner actually needs, and nothing you don’t. Start with one small change. That’s it. That’s the class.</p>
    </section>

    <section class="changes" aria-labelledby="changes-h">
      <h2 id="changes-h">Six Small Changes</h2>
      <p class="section-lede">Tap a card. Pick one. Next month, pick another.</p>
      <FlipCards items={changeCards} layout="list" />
    </section>

    <section class="grass-sec" id="grass" aria-labelledby="grass-sec-h">
      <div class="section-head">
        <h2 id="grass-sec-h">Pick Your Grass</h2>
        <a class="more" href="/blog/grass-types-northeast/">Grass guide</a>
      </div>
      <p class="section-lede">Seeding this fall? Four questions and I’ll tell you what to buy.</p>
      <GrassPicker postHref="/blog/grass-types-northeast/" />
    </section>

    <section class="weeds-teaser" aria-labelledby="weeds-h">
      <div class="section-head">
        <h2 id="weeds-h">What’s That Weed?</h2>
        <a class="more" href="/weeds/">Weed guide</a>
      </div>
      <p class="section-lede">The usual suspects around here, and how to deal with each one. Easy way, my way, or just let it be.</p>
      <div class="weed-chips">
        {WEEDS.filter((w) => w.group !== 'joke').map((w) => (
          <a class="weed-chip" href={`/weeds/#${w.id}`}><img src={`/img/weeds/${w.id}-thumb.webp`} width="30" height="30" alt="" loading="lazy" decoding="async" />{w.name}</a>
        ))}
      </div>
    </section>

    <section class="yards-teaser" aria-labelledby="yards-h">
      <div class="section-head">
        <h2 id="yards-h">Proof It Works</h2>
        <a class="more" href="/yards/">See the yards</a>
      </div>
      <p class="section-lede">My yard in Bedford. Regular push mower, no lawn company, just these habits.</p>
      <div class="photo-strip">
        {PHOTOS.map((p) => (
          <figure class="photo">
            <img
              src={`/img/${p.src}-800.webp`}
              srcset={`/img/${p.src}-800.webp 800w, /img/${p.src}-1400.webp 1400w`}
              sizes="(min-width: 900px) 420px, 82vw"
              width={p.w} height={p.h} loading="lazy" decoding="async" alt={p.alt}
            />
            <figcaption>{p.caption}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="plan plan-mid" aria-labelledby="dx-card-h">
      <div class="window plan-card">
        <h2 id="dx-card-h">Something Look Wrong?</h2>
        <p>Brown spots, seed that won’t come up, mushrooms, moss? Tap what you see and get the cause and the fix. Or get any job’s steps in the right order.</p>
        <p class="shed-jump"><a class="btn" href="/resources/#dx">What’s Wrong With My Lawn?</a> <a class="bf-chip" href="/resources/#ops">Order of operations</a></p>
      </div>
    </section>

    <section class="plan plan-mid" aria-labelledby="plan-h">
      <div class="window plan-card">
        <h2 id="plan-h">Want the Short List for Your Yard?</h2>
        <p>Nine quick questions, two minutes. I’ll tell you exactly what to do and when.</p>
        <a class="btn" href="/plan/">Get My Free Lawn Plan</a>
      </div>
    </section>
    <section class="faq" aria-labelledby="faq-h">
      <h2 id="faq-h">Quick Answers</h2>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a} {f.href && <a href={f.href}>Full answer</a>}</p>
        </details>
      ))}
      <p class="faq-more"><a href="/guides/">All lawn guides: straight answers to common questions</a></p>
    </section>
  </main>
</Base>
