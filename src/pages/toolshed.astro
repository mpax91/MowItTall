---
import Base from '../layouts/Base.astro';
import Calendar from '../components/Calendar.astro';
import SoilGauge from '../components/SoilGauge.astro';
import RainMeter from '../components/RainMeter.astro';

const title = 'Free lawn tools: should I water, live lawn calendar and soil temperature for Bedford, NY | Mow It Tall';
const description =
  'Free lawn care tools for Westchester and the Northeast: a custom lawn plan quiz, a yard measuring tool, a grass seed picker, a should-I-water rain meter, a live lawn calendar, and today’s soil temperature in Bedford, NY.';
---
<Base title={title} description={description} path="/toolshed/">
  <main id="main">
    <section class="page-head page-head-hub">
      <h1>The toolshed</h1>
      <p class="lede">Free tools that do the thinking for you. No account, no email, no gas blower.</p>
    </section>

    <section class="plan plan-mid" aria-labelledby="quiz-h">
      <div class="window plan-card">
        <h2 id="quiz-h">Your lawn plan</h2>
        <p>Seven questions about your yard and how much effort you’ll honestly give. You get the few things that matter, in order, with phone reminders.</p>
        <a class="btn" href="/plan/">Take the quiz</a>
      </div>
    </section>

    <section class="plan plan-mid" aria-labelledby="measure-h">
      <div class="window plan-card">
        <h2 id="measure-h">Measure your yard</h2>
        <p>Trace your grass on a satellite map. Each part gets its square feet written right on it, plus a total you can save as a picture.</p>
        <a class="btn" href="/measure/">Measure my lawn</a>
      </div>
    </section>

    <section class="plan plan-mid" aria-labelledby="grass-h">
      <div class="window plan-card">
        <h2 id="grass-h">Pick your grass seed</h2>
        <p>Sun, shade, kids, dogs, no sprinkler? Four questions and you’ll know exactly which grass to buy and how much.</p>
        <a class="btn" href="/lawn-101/#grass">Find my grass</a>
      </div>
    </section>

    <Calendar />

    <RainMeter />

    <SoilGauge />

    <section class="workbench" aria-labelledby="bench-h">
      <h2 id="bench-h">On the workbench</h2>
      <p class="section-lede">Tools I’m building next.</p>
      <ul class="bench-list">
        <li><strong>Should I mow today?</strong> A straight yes or no for your ZIP, from rain and soil temperature.</li>
        <li><strong>Watering alerts.</strong> A heads-up on your phone when the rain meter says your lawn needs a drink.</li>
        <li><strong>How many bags?</strong> Your yard measurement turned into exactly what to buy, right in your plan.</li>
        <li><strong>Soil alerts.</strong> A heads-up when Bedford’s soil hits crabgrass-preventer temperature.</li>
      </ul>
    </section>
  </main>
</Base>
