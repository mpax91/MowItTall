---
import Base from '../layouts/Base.astro';
const title = 'Search Mow It Tall: Lawn Tips, Tools and Weeds';
const description = 'Search every Mow It Tall page: blog posts, free lawn tools, the weed guide and lawn basics for Westchester and the Northeast.';
const tries = ['dog pee', 'crabgrass', 'spreader setting', 'when to seed', 'lime', 'mower height', 'brown spots', 'clover'];
---
<Base title={title} description={description} path="/search/" noindex crumbs={[["Search", "/search/"]]}>
  <main id="main" class="page">
    <header class="page-head">
      <h1>Search the Site</h1>
      <p class="lede">Posts, tools, weeds, the works. Type like you’d text me.</p>
    </header>
    <form class="bf-search srch-form" role="search" data-srch-form action="/search/">
      <label class="sr-only" for="srch-q">Search</label>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" /></svg>
      <input id="srch-q" name="q" type="search" placeholder="My lawn has brown spots…" autocomplete="off" enterkeyhint="search" data-srch-q />
    </form>
    <div class="bf-chips srch-tries" data-srch-tries>
      <span class="srch-try-label">Try:</span>
      {tries.map((t) => <button type="button" class="bf-chip" data-srch-try={t}>{t}</button>)}
    </div>
    <p class="bf-status" aria-live="polite" data-srch-status></p>
    <ol class="srch-results" data-srch-results></ol>
    <p class="srch-more" hidden data-srch-more-wrap><button type="button" class="btn" data-srch-more>Show More</button></p>
  </main>
</Base>

<script>
  type Hit = { url: string; excerpt: string; meta: { title?: string } };
  const form = document.querySelector<HTMLFormElement>('[data-srch-form]')!;
  const input = document.querySelector<HTMLInputElement>('[data-srch-q]')!;
  const list = document.querySelector<HTMLOListElement>('[data-srch-results]')!;
  const status = document.querySelector<HTMLElement>('[data-srch-status]')!;
  const moreWrap = document.querySelector<HTMLElement>('[data-srch-more-wrap]')!;
  const moreBtn = document.querySelector<HTMLButtonElement>('[data-srch-more]')!;
  let pf: any = null;
  let hits: any[] = [];
  let shown = 0;
  let seq = 0;

  async function engine() {
    if (!pf) {
      const path = '/pagefind/pagefind.js';
      pf = await import(/* @vite-ignore */ path);
      await pf.options({ excerptLength: 22 });
    }
    return pf;
  }

  function label(url: string) {
    if (url.startsWith('/blog/topic/')) return 'Topic';
    if (url.startsWith('/blog/')) return 'Blog';
    if (url.startsWith('/guides/')) return 'Guide';
    if (url.startsWith('/weeds')) return 'Weed guide';
    if (url.startsWith('/resources') || url.startsWith('/measure') || url.startsWith('/neighbor')) return 'Tool';
    if (url.startsWith('/games')) return 'Game';
    if (url.startsWith('/plan')) return 'Quiz';
    return 'Page';
  }

  async function renderMore() {
    const batch = hits.slice(shown, shown + 8);
    shown += batch.length;
    const datas: Hit[] = await Promise.all(batch.map((h) => h.data()));
    datas.forEach((d) => {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.className = 'clip srch-hit';
      a.href = d.url;
      const tag = document.createElement('span');
      tag.className = 'clip-tag';
      tag.textContent = label(d.url);
      const t = document.createElement('span');
      t.className = 'clip-title';
      t.textContent = (d.meta.title || d.url).replace(/\s*\|\s*Mow It Tall$/, '');
      const ex = document.createElement('span');
      ex.className = 'clip-dek';
      ex.innerHTML = d.excerpt; // Pagefind escapes page text and wraps matches in <mark>
      a.append(tag, t, ex);
      li.appendChild(a);
      list.appendChild(li);
    });
    moreWrap.hidden = shown >= hits.length;
  }

  async function run(q: string) {
    const mine = ++seq;
    const u = new URL(location.href);
    q ? u.searchParams.set('q', q) : u.searchParams.delete('q');
    history.replaceState(null, '', u);
    list.innerHTML = '';
    moreWrap.hidden = true;
    if (!q.trim()) { status.textContent = ''; return; }
    status.textContent = 'Looking…';
    try {
      const p = await engine();
      const r = await p.debouncedSearch(q, {}, 200);
      if (r === null || mine !== seq) return;
      hits = r.results;
      shown = 0;
      clearTimeout((window as any).__mitSrch); (window as any).__mitSrch = setTimeout(() => (window as any).mitTrack?.('search', { search_term: q.trim().toLowerCase().slice(0, 80), results_count: hits.length }), 1200);
      status.textContent = hits.length ? `${hits.length} result${hits.length === 1 ? '' : 's'}` : 'Nothing. Either it’s not here yet or you spelled crabgrass wrong.';
      await renderMore();
    } catch {
      status.textContent = 'Search only works on the live site (it’s built when the site deploys).';
    }
  }

  input.value = new URLSearchParams(location.search).get('q') || '';
  input.addEventListener('input', () => run(input.value));
  form.addEventListener('submit', (e) => { e.preventDefault(); input.blur(); run(input.value); });
  moreBtn.addEventListener('click', renderMore);
  document.querySelectorAll<HTMLButtonElement>('[data-srch-try]').forEach((b) =>
    b.addEventListener('click', () => { input.value = b.dataset.srchTry || ''; run(input.value); }),
  );
  if (input.value) run(input.value); else input.focus({ preventScroll: true });
</script>
