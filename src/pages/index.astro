---
import Base from '../layouts/Base.astro';
import Calendar from '../components/Calendar.astro';
import HeroMower from '../components/HeroMower.astro';
import LawnThisWeek from '../components/LawnThisWeek.astro';
import CardRow from '../components/CardRow.astro';
import { PHOTOS } from '../data/photos.js';
import { changeCards } from '../data/changes.js';
const posts = Object.values(import.meta.glob('./blog/[a-z]*.md', { eager: true }))
  .map((p) => ({ ...p.frontmatter, url: p.url }))
  .sort((a, b) => new Date(b.date) - new Date(a.date))
  .slice(0, 8);


const title = 'Mow It Tall: the easy guide to a better lawn';
const description =
  'Small, easy changes for a better-looking lawn. Simple lawn care tips for beginners in Bedford, Westchester and the Northeast, from a neighbor with great stripes.';
const site = 'https://mowittall.com';



const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      url: site,
      name: 'Mow It Tall',
      description,
      publisher: { '@id': `${site}/#mike` },
    },
    {
      '@type': 'Person',
      '@id': `${site}/#mike`,
      name: 'Mike',
      description: 'Bedford, NY homeowner known locally for his striped lawn.',
      homeLocation: { '@type': 'Place', name: 'Bedford, New York' },
    },
  ],
};

const lawn101 = [
  { href: '/weeds/', img: '/img/weeds/dandelion-thumb.webp', title: 'What’s that weed?', sub: '16 usual suspects, with real photos and the easy fix.' },
  { href: '/lawn-101/#grass', icon: changeCards[5].icon, title: 'Which grass should I plant?', sub: 'Four questions. One answer. No seed-aisle panic.' },
  ...changeCards.map((c) => ({ href: '/lawn-101/#changes-h', icon: c.icon, title: c.title, sub: c.sub })),
  { href: '/yards/', img: `/img/${PHOTOS[0].src}-800.webp`, title: 'Proof it works', sub: 'My yard. Push mower. No lawn company.' },
];
const tools = [
  { href: '/resources/#seed', tag: 'Live', title: 'Can I seed now?', sub: 'Checks your soil and forecast. Yes or no.' },
  { href: '/resources/#dx', tag: 'Fix it', title: 'What’s wrong with my lawn?', sub: 'Tap what you see. Get the likely cause and the fix.' },
  { href: '/resources/#water-h', tag: 'Live', title: 'Should I water?', sub: 'This week’s rain vs. what your grass drank.' },
  { href: '/measure/', tag: 'Map', title: 'Measure your yard', sub: 'Draw it on the map. Get the square feet.' },
  { href: '/resources/#calc', tag: 'Math', title: 'Lawn calculator', sub: 'How many bags of seed, food or lime.' },
  { href: '/resources/#spreader', tag: 'Math', title: 'Spreader settings', sub: 'Half rate, twice. No stripes of shame.' },
  { href: '/resources/#ops', tag: 'Steps', title: 'Order of operations', sub: 'What to do first when you overseed or fix a mess.' },
  { href: '/resources/#need', tag: 'Honest', title: 'Do I need this?', sub: 'Aerator shoes and other gadgets. Mostly no.' },
  { href: '/neighbor/', tag: 'Petty', title: 'Send to a neighbor', sub: 'A friendly, anonymous nudge for the yard next door.' },
];
const games = [
  { href: '/games/', icon: changeCards[0].icon, title: 'The stripe game', sub: 'Eight yards, from a starter home to a snowy Christmas lawn.' },
  { href: '/games/#whack-h', icon: changeCards[1].icon, title: 'Whack-a-Weed', sub: '30 seconds. Hit the weeds, not the bees.' },
];
---
<Base title={title} description={description} path="/" jsonLd={jsonLd}>
    <main id="main">
      <HeroMower />

      <section class="whats" aria-labelledby="whats-h">
        <h2 id="whats-h">How this site works</h2>
        <p class="section-lede">No 40-step program. Grab what you need and get back to your weekend.</p>
        <ul class="whats-grid">
          <li><a href="/plan/"><b>Your free plan</b><span>Seven questions. A plan for your yard, with reminders on your phone.</span></a></li>
          <li><a href="#local"><b>Your lawn this week</b><span>What to do, whether to water and how warm the soil is, for your ZIP.</span></a></li>
          <li><a href="#l101"><b>Lawn 101 &amp; resources</b><span>The basics, weed ID and calculators. Minus the boring parts.</span></a></li>
          <li><a href="#blog"><b>Blog &amp; games</b><span>Hot takes, rankings and a mower game for when you should be mowing.</span></a></li>
        </ul>
      </section>

      <LawnThisWeek />
      <Calendar compact />

      <CardRow id="l101" title="Lawn 101" lede="Everything a beginner actually needs. Start with one small change." href="/lawn-101/" more="Explore Lawn 101" items={lawn101} />
      <CardRow id="res" title="Free resources" lede="Tools that do the thinking for you. No account, no email." href="/resources/" more="See All Resources" items={tools} kind="tools" />
      <CardRow id="blog" title="From the blog" lede="Lawn takes. Some hot, all short." href="/blog/" more="Read the Blog" items={posts.map((p) => ({ href: p.url, tag: p.tag, title: p.title }))} kind="blog" />
      <CardRow id="games" title="Games" lede="For when you should be mowing." href="/games/" more="Play the Games" items={games} kind="games" />

      <section class="plan plan-end" id="plan" aria-labelledby="plan-h">
        <div class="window plan-card">
          <h2 id="plan-h">Get your free lawn plan</h2>
          <p>Seven questions, two minutes. A plan for your yard and how much effort you actually want to give, with reminders on your phone’s calendar.</p>
          <a class="btn btn-big" href="/plan/">Get My Free Lawn Plan</a>
        </div>
        <p class="hero-tag">You don’t need to be a <span class="nowrap">know-it-all.</span> Just mow it tall.</p>
      </section>
    </main>

    <div class="sticky-cta" data-sticky hidden>
      <a class="btn" href="/plan/">Get My Free Lawn Plan</a>
    </div>

    <script>
      // A slim "get your plan" bar appears once the hero button scrolls away,
      // and gets out of the way near the other plan buttons.
      const bar = document.querySelector('[data-sticky]');
      const hero = document.querySelector('[data-hero-cta]');
      const end = document.querySelector('#plan');
      if (bar && hero && end) {
        let heroOut = false, endIn = false;
        const sync = () => { bar.hidden = !(heroOut && !endIn); };
        new IntersectionObserver(([e]) => { heroOut = !e.isIntersecting && e.boundingClientRect.top < 0; sync(); }).observe(hero);
        new IntersectionObserver(([e]) => { endIn = e.isIntersecting; sync(); }).observe(end);
      }
    </script>
</Base>
