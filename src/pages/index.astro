---
import Base from '../layouts/Base.astro';
import Calendar from '../components/Calendar.astro';
import StripeGame from '../components/StripeGame.astro';
import FlipCards from '../components/FlipCards.astro';
import SoilGauge from '../components/SoilGauge.astro';
import { PHOTOS } from '../data/photos.js';
import { WEEDS } from '../data/weeds.js';
import PixelIcon from '../components/PixelIcon.astro';
const posts = Object.values(import.meta.glob('./clippings/[a-z]*.md', { eager: true }))
  .map((p) => ({ ...p.frontmatter, url: p.url }))
  .sort((a, b) => new Date(b.date) - new Date(a.date))
  .slice(0, 3);


const title = 'Mow It Tall: the easy guide to a better lawn';
const description =
  'Small, easy changes for a better-looking lawn. Simple lawn care tips for beginners in Bedford, Westchester and the Northeast, from a neighbor with great stripes.';
const site = 'https://mowittall.com';

const icons = {
  raise: [
    '..a.........',
    '.aaa........',
    'aaaaa.......',
    '..a...l..l..',
    '..a..l.ll.l.',
    '..a..l.gl.l.',
    '..a.lg.gl.gl',
    '....lg.gl.gl',
    '....gg.gg.gg',
    '....gg.gg.gg',
    'llllgggggggg',
    'gggggggggggg',
  ],
  clippings: [
    '............',
    '..l....l....',
    '...l..l...l.',
    '.l...l...l..',
    '..l.l..l...l',
    '.....l...l..',
    '..l.....l...',
    '............',
    'llllllllllll',
    'gglgglgglggl',
    'gggggggggggg',
    'tttttttttttt',
  ],
  water: [
    '......b.....',
    '.....bb.....',
    '.....bbb....',
    '....bbbb....',
    '....bwbbb...',
    '...bwbbbbb..',
    '...bwbbbbb..',
    '...bbbbbbb..',
    '...bbbbbbb..',
    '....bbbbb...',
    '.....bbb....',
    '............',
  ],
  blade: [
    '............',
    '..........y.',
    '.........yyy',
    '..........y.',
    'sSSSSSSSSSS.',
    'sssSSaaSSSSS',
    'sssssaasssSS',
    '.ssssssssss.',
    '............',
    '..y.........',
    '.yyy........',
    '..y.........',
  ],
  leaves: [
    '........aa..',
    '.......a....',
    '....oooo....',
    '...ooyooo...',
    '..ooyoooo...',
    '..oyoooo....',
    '.oyoooo.....',
    '.yoooo......',
    'yooo........',
    'y...........',
    '............',
    '............',
  ],
  seed: [
    '............',
    '.....ll.....',
    '....lggl.ll.',
    '....lgglgll.',
    '.....gl.gl..',
    '......g.g...',
    '......gg....',
    '......g.....',
    '..tttttttt..',
    '.tttttttttt.',
    '.tttttttttt.',
    '............',
  ],
};

const changes = [
  {
    icon: icons.raise,
    title: 'Raise your mower',
    body: 'Set it to 3.5 to 4 inches. Tall grass shades out weeds and needs less water.',
    effort: '10 seconds, once',
  },
  {
    icon: icons.clippings,
    title: 'Leave the clippings',
    body: 'Skip the bag. Clippings break down in a few days and feed your lawn for free.',
    effort: 'Less work than before',
  },
  {
    icon: icons.water,
    title: 'Water less often, but longer',
    body: 'Once or twice a week, early morning, about an inch total. Deep watering grows deep roots.',
    effort: 'Change one timer',
  },
  {
    icon: icons.blade,
    title: 'Sharpen the blade',
    body: 'A dull blade tears the grass and leaves brown tips. Do it once a year, before spring.',
    effort: '20 minutes a year',
  },
  {
    icon: icons.leaves,
    title: 'Mow over your leaves',
    body: 'No blower needed. Chopped-up leaves sink into the lawn and turn into free fertilizer.',
    effort: 'You were mowing anyway',
  },
  {
    icon: icons.seed,
    title: 'Seed in fall, not spring',
    body: 'Late August through September is when new grass does best around here.',
    effort: 'One weekend',
  },
];

const changeCards = changes.map((c) => ({
  icon: c.icon,
  title: c.title,
  sub: `Effort: ${c.effort}`,
  back: [{ text: c.body }],
}));

const faqs = [
  {
    q: 'How high should I mow my lawn?',
    a: 'For most lawns in New York and the Northeast, 3.5 to 4 inches. Taller grass shades the soil so weed seeds can’t sprout, and it grows deeper roots so it stays green in summer.',
  },
  {
    q: 'When should I put down crabgrass preventer in Westchester?',
    a: 'When the soil warms to about 55°F, usually early to mid April around Bedford. A good clue: put it down when the forsythia bushes are blooming.',
  },
  {
    q: 'Should I bag my grass clippings?',
    a: 'No. Leave them on the lawn. They break down quickly and return nutrients to the soil. Bag only if the grass got very long and the clippings are clumping.',
  },
  {
    q: 'When is the best time to seed a lawn in New York?',
    a: 'Late August through September. The soil is still warm, the air is cooler, and there are fewer weeds competing with new grass.',
  },
  {
    q: 'How often should I water my lawn?',
    a: 'Once or twice a week, deeply, in the early morning. Aim for about an inch of water a week, counting rain. Short daily watering grows shallow roots.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      url: site,
      name: 'Mow It Tall',
      description,
      publisher: { '@id': `${site}/#mike` },
    },
    {
      '@type': 'Person',
      '@id': `${site}/#mike`,
      name: 'Mike',
      description: 'Bedford, NY homeowner known locally for his striped lawn.',
      homeLocation: { '@type': 'Place', name: 'Bedford, New York' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<Base title={title} description={description} path="/" jsonLd={jsonLd}>
    <StripeGame />

    <main id="main">
      <section class="intro">
        <h1 class="tagline">You don’t need to be a <span class="nowrap">know-it-all.</span> Just mow it tall.</h1>
        <p class="lede">
          The easy guide to a better lawn. No jargon, no 40-step programs. Just a few small
          changes from a guy in Bedford, NY whose neighbors keep asking about his stripes.
        </p>
        <a class="btn" href="/plan/">Get your lawn game plan</a>
      </section>

      <section class="changes" aria-labelledby="changes-h">
        <h2 id="changes-h">Small changes, big lawn</h2>
        <p class="section-lede">You don’t have to become a lawn person. Tap a card. Pick one. Next month, pick another.</p>
        <FlipCards items={changeCards} layout="list" />
      </section>

      <Calendar />

      <SoilGauge />

      <section class="yards-teaser" aria-labelledby="yards-h">
        <div class="section-head">
          <h2 id="yards-h">Proof it works</h2>
          <a class="more" href="/yards/">See the yards</a>
        </div>
        <div class="photo-strip">
          {PHOTOS.map((p) => (
            <figure class="photo">
              <img
                src={`/img/${p.src}-800.webp`}
                srcset={`/img/${p.src}-800.webp 800w, /img/${p.src}-1400.webp 1400w`}
                sizes="(min-width: 900px) 420px, 82vw"
                width={p.w} height={p.h} loading="lazy" decoding="async" alt={p.alt}
              />
              <figcaption>{p.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="clips-teaser" aria-labelledby="clips-h">
        <div class="section-head">
          <h2 id="clips-h">Clippings</h2>
          <a class="more" href="/clippings/">All posts</a>
        </div>
        <p class="section-lede">Lawn takes. Some hot, all short.</p>
        <ul class="clip-list">
          {posts.map((p) => (
            <li>
              <a class="clip" href={p.url}>
                <span class="clip-tag">{p.tag}</span>
                <span class="clip-title">{p.title}</span>
                <span class="clip-dek">{p.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="weeds-teaser" aria-labelledby="weeds-h">
        <div class="section-head">
          <h2 id="weeds-h">What’s that weed?</h2>
          <a class="more" href="/weeds/">Weed board</a>
        </div>
        <p class="section-lede">The usual suspects around here, and how to deal with each one. Easy way, Mike’s way, or just let it be.</p>
        <div class="weed-chips">
          {WEEDS.map((w) => (
            <a class="weed-chip" href={`/weeds/#${w.id}`}><PixelIcon map={w.icon} size={30} />{w.name}</a>
          ))}
        </div>
      </section>

      <section class="games-teaser" aria-labelledby="games-h">
        <div class="window games-card">
          <h2 id="games-h">Waste five minutes productively</h2>
          <p>Whack-a-Weed: tap the dandelions, spare the bees, and whatever you do, don’t touch the gas blower.</p>
          <a class="btn" href="/games/">Play the games</a>
        </div>
      </section>

      <section class="plan" id="plan" aria-labelledby="plan-h">
        <h2 id="plan-h">Get your lawn game plan</h2>
        <p>
          Seven quick questions about your yard and how much effort you’re honestly willing to
          give. You get a plan, plus reminders for your phone’s calendar.
        </p>
        <a class="btn" href="/plan/">Take the quiz</a>
      </section>

      <section class="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Quick answers</h2>
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    </main>
</Base>
