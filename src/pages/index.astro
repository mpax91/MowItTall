---
import Base from '../layouts/Base.astro';
import Calendar from '../components/Calendar.astro';
import HeroMower from '../components/HeroMower.astro';
import LawnThisWeek from '../components/LawnThisWeek.astro';
import TrendingGrid from '../components/TrendingGrid.astro';


const title = 'Mow It Tall | Easy Lawn Care Tips, Free Plan and Tools';
const description =
  'Small, easy changes for a better-looking lawn. Simple lawn care tips for beginners in Bedford, Westchester and the Northeast, from a neighbor with great stripes.';
const site = 'https://mowittall.com';



const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      url: site,
      name: 'Mow It Tall',
      description,
      publisher: { '@id': `${site}/#mike` },
    },
    {
      '@type': 'Person',
      '@id': `${site}/#mike`,
      name: 'Mike',
      description: 'Bedford, NY homeowner known locally for his striped lawn.',
      homeLocation: { '@type': 'Place', name: 'Bedford, New York' },
    },
  ],
};

---
<Base title={title} description={description} path="/" jsonLd={jsonLd}>
    <main id="main">
      <HeroMower />
      <LawnThisWeek />
      <Calendar compact />

      <TrendingGrid />

      <section class="plan plan-end" id="plan" aria-labelledby="plan-h">
        <div class="window plan-card">
          <h2 id="plan-h">Get Your Free Lawn Plan</h2>
          <p>Nine quick questions, two minutes. A plan for your yard and how much effort you actually want to give, with reminders on your phone’s calendar.</p>
          <a class="btn btn-big" href="/plan/">Get My Free Lawn Plan</a>
        </div>
        <p class="hero-tag">You don’t need to be a <span class="nowrap">know-it-all.</span> Just mow it tall.</p>
      </section>
    </main>

    <div class="sticky-cta" data-sticky hidden>
      <a class="btn" href="/plan/">Get My Free Lawn Plan</a>
    </div>

    <script>
      // A slim "get your plan" bar appears once the game's Hold button scrolls away,
      // and gets out of the way near the other plan buttons.
      const bar = document.querySelector('[data-sticky]');
      const hero = document.querySelector('[data-hero-end]'); 
      const end = document.querySelector('#plan');
      if (bar && hero && end) {
        let heroOut = false, endIn = false;
        const sync = () => { bar.hidden = !(heroOut && !endIn); };
        new IntersectionObserver(([e]) => { heroOut = !e.isIntersecting && e.boundingClientRect.top < 0; sync(); }).observe(hero);
        new IntersectionObserver(([e]) => { endIn = e.isIntersecting; sync(); }).observe(end);
      }
    </script>
</Base>
