---
// "Share This" box for posts and guides. One button opens a sheet with every way to share:
// text, email, Facebook, Instagram, Threads, X, Pinterest (with the tall pin), Reddit, Bluesky, Nextdoor,
// copy link, and the phone's own share sheet. Plain links, no social scripts. Every tap fires `share`.
// Instagram has no web share link: on phones it opens the share sheet (Instagram is in it); elsewhere it copies the link.
import { siFacebook, siInstagram, siThreads, siX, siPinterest, siReddit, siBluesky } from 'simple-icons';
import { allPins, pinUrl } from '../data/pins.js';
interface Props { path: string; title: string; kind?: 'post' | 'guide' }
const { path, title, kind = 'post' } = Astro.props;
const site = 'https://mowittall.com';
const u = (src: string) => `${site}${path}?utm_source=${src}&utm_medium=share`;
const enc = encodeURIComponent;
const pin = allPins()[path];
const line = `${title} (Mow It Tall)`;
const nl = '\n';
const items = [
  { id: 'sms', name: 'Text', href: `sms:?&body=${enc(`${line}${nl}${u('sms')}`)}`, svg: 'M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H9l-5 4v-4H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z', stroke: true, color: '#34c759' },
  { id: 'email', name: 'Email', href: `mailto:?subject=${enc(title)}&body=${enc(`Thought you’d like this:${nl}${nl}${title}${nl}${u('email')}`)}`, svg: 'M3 5h18v14H3zM3 6l9 7 9-7', stroke: true, color: '#5b6b62' },
  { id: 'facebook', name: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${enc(u('facebook'))}`, svg: siFacebook.path, color: '#0866ff' },
  { id: 'instagram', name: 'Instagram', href: '', svg: siInstagram.path, color: '#e1306c', native: true },
  { id: 'threads', name: 'Threads', href: `https://www.threads.net/intent/post?text=${enc(`${title} ${u('threads')}`)}`, svg: siThreads.path, color: '#000000' },
  { id: 'x', name: 'X', href: `https://x.com/intent/post?text=${enc(title)}&url=${enc(u('x'))}`, svg: siX.path, color: '#000000' },
  { id: 'pinterest', name: 'Pinterest', href: `https://www.pinterest.com/pin/create/button/?${new URLSearchParams({ url: u('pinterest'), ...(pin ? { media: site + pinUrl(pin), description: pin.description } : { description: title }) })}`, svg: siPinterest.path, color: '#e60023' },
  { id: 'reddit', name: 'Reddit', href: `https://www.reddit.com/submit?url=${enc(u('reddit'))}&title=${enc(title)}`, svg: siReddit.path, color: '#ff4500' },
  { id: 'bluesky', name: 'Bluesky', href: `https://bsky.app/intent/compose?text=${enc(`${title} ${u('bluesky')}`)}`, svg: siBluesky.path, color: '#1185fe' },
  { id: 'nextdoor', name: 'Nextdoor', href: `https://nextdoor.com/sharekit/?source=mowittall&body=${enc(`${title} ${u('nextdoor')}`)}`, svg: 'M3 11.5 12 4l9 7.5M5.5 9.5V20h13V9.5M10 20v-5.5h4V20', stroke: true, color: '#00b246' },
  { id: 'copy', name: 'Copy Link', href: '', svg: 'M9 9h11v11H9zM5 15H4V4h11v1', stroke: true, color: '#12301d' },
  { id: 'more', name: 'More', href: '', svg: 'M5 12h.01M12 12h.01M19 12h.01', stroke: true, color: '#12301d', native: true, onlyNative: true },
];
---
<aside class="share" data-share data-share-url={`${site}${path}`} data-share-title={title} data-pagefind-ignore>
  <p class="share-q"><b>Know someone who needs this?</b> <span>Send it to them. Takes two taps.</span></p>
  <button type="button" class="btn share-open" data-share-open aria-haspopup="dialog">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M7 8l5-5 5 5M5 13v7h14v-7" /></svg>
    Share This
  </button>
  <dialog class="share-sheet" aria-labelledby={`share-h-${kind}`}>
    <div class="share-top">
      <h2 id={`share-h-${kind}`}>Share This</h2>
      <button type="button" class="share-x" data-share-close aria-label="Close">×</button>
    </div>
    <ul class="share-grid">
      {items.map((it) => (
        <li data-share-item={it.id} hidden={it.onlyNative ? true : undefined}>
          {it.href ? (
            <a href={it.href} target={it.href.startsWith('http') ? '_blank' : undefined} rel="noopener" data-track="share" data-track-method={it.id} data-track-content_type={kind}>
              <span class="share-ic" style={`--c:${it.color}`}><svg viewBox="0 0 24 24" aria-hidden="true" {...(it.stroke ? { fill: 'none', stroke: 'currentColor', 'stroke-width': '2', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } : { fill: 'currentColor' })}><path d={it.svg} /></svg></span>
              {it.name}
            </a>
          ) : (
            <button type="button" data-share-act={it.id}>
              <span class="share-ic" style={`--c:${it.color}`}><svg viewBox="0 0 24 24" aria-hidden="true" {...(it.stroke ? { fill: 'none', stroke: 'currentColor', 'stroke-width': it.id === 'more' ? '3.5' : '2', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } : { fill: 'currentColor' })}><path d={it.svg} /></svg></span>
              {it.name}
            </button>
          )}
        </li>
      ))}
    </ul>
    <p class="share-note" data-share-note aria-live="polite"></p>
  </dialog>
</aside>

<script>
  document.querySelectorAll<HTMLElement>('[data-share]').forEach((box) => {
    const dlg = box.querySelector('dialog') as HTMLDialogElement;
    const note = box.querySelector('[data-share-note]') as HTMLElement;
    const url = box.dataset.shareUrl || location.href;
    const title = box.dataset.shareTitle || document.title;
    const canNative = typeof navigator.share === 'function';
    const track = (method: string) => (window as any).mitTrack?.('share', { method, content_type: location.pathname.startsWith('/guides/') ? 'guide' : 'post' });
    if (canNative) box.querySelectorAll<HTMLElement>('[data-share-item="more"]').forEach((li) => (li.hidden = false));
    box.querySelector('[data-share-open]')!.addEventListener('click', () => {
      note.textContent = '';
      dlg.showModal();
      track('open');
    });
    box.querySelector('[data-share-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    const copy = async (msg: string) => {
      try { await navigator.clipboard.writeText(url); note.textContent = msg; }
      catch { note.textContent = url; }
    };
    const native = async (src: string) => {
      try { await navigator.share({ title, url: `${url}?utm_source=${src}&utm_medium=share` }); } catch { /* closed */ }
    };
    box.querySelectorAll<HTMLButtonElement>('[data-share-act]').forEach((b) => b.addEventListener('click', () => {
      const act = b.dataset.shareAct!;
      track(act);
      if (act === 'copy') copy('Link copied. Paste it anywhere.');
      else if (act === 'more') native('native');
      else if (act === 'instagram') {
        if (canNative && matchMedia('(pointer: coarse)').matches) native('instagram');
        else copy('Link copied. Paste it in an Instagram story or DM.');
      }
    }));
  });
</script>
