---
// The stripe game, its frame and the leaf-blower Easter egg ticket.
---
    <section class="game" data-game aria-label="Stripe game">
      <div class="window hud">
        <span><span class="hud-label">Yard</span> <b data-level>Starter home</b></span>
        <span><span class="hud-label">Mowed</span> <b data-pct>0%</b></span>
        <span><span class="hud-label">Time</span> <b data-time>0:00</b></span>
      </div>

      <div class="screen" data-screen>
        <canvas tabindex="0" aria-label="Lawn. After the mower starts, drag anywhere on the lawn to drive it and paint stripes. On a keyboard, use the arrow keys."></canvas>

        <div class="window overlay" data-picker>
          <h2>Pick a yard</h2>
          <p class="overlay-small">Pull-start the mower, then paint the straightest stripes you can.</p>
          <button type="button" class="btn btn-wide" data-random>Surprise me</button>
          <p class="pick-label">Or choose your own adventure</p>
          <div class="pick-list" data-pick-list></div>
        </div>

        <div class="window overlay" data-ready hidden>
          <h2 data-ready-title>The starter home</h2>
          <p class="overlay-blurb" data-ready-blurb></p>
          <p data-ready-how></p>
          <p class="overlay-small">Drag anywhere on the lawn to drive. Your thumb paints the stripes.</p>
          <button type="button" class="cord" data-cord style="--p:0">Hold to start the mower</button>
          <div class="overlay-foot">
            <button type="button" class="link-btn" data-back>Pick a different yard</button>
            <span class="overlay-best" data-ready-best hidden></span>
          </div>
        </div>

        <div class="window overlay" data-result hidden>
          <p class="result-score"><span data-total>0</span><span class="stars" data-stars role="img"></span></p>
          <h2 data-grade>Respectable dad stripes.</h2>
          <p class="overlay-small" data-detail></p>
          <p class="overlay-small" data-tip></p>
          <div class="actions">
            <button type="button" class="btn" data-again>Mow again</button>
            <button type="button" class="btn btn-quiet" data-pick>Pick another yard</button>
          </div>
        </div>

        <p class="push-hint" data-push aria-hidden="true">Drag to mow</p>
        <p class="toast" data-toast aria-live="polite"></p>
        <p class="brap" data-brap aria-hidden="true">BRRRRAAAAP</p>
      </div>
    </section>

    <dialog class="ticket" data-ticket aria-labelledby="ticket-h">
      <form method="dialog">
        <p class="ticket-kicker">Totally unofficial</p>
        <h2 id="ticket-h">Bedford Blower Patrol</h2>
        <dl>
          <dt>Citation</dt><dd>No. 000042</dd>
          <dt>Offense</dt><dd>Operating a gas leaf blower within earshot of literally everyone.</dd>
          <dt>Fine</dt><dd>One (1) rake, to be used immediately.</dd>
        </dl>
        <p class="ticket-tip">
          Real tip: you don’t need either one. Mow right over the leaves. They chop up, sink in
          and feed the lawn.
        </p>
        <button class="btn" value="ok">Pay with rake</button>
      </form>
    </dialog>

<script>
  import { initGame } from '../scripts/game.js';
  const game = document.querySelector('[data-game]');
  if (game) initGame(game);
</script>
