---
// A live, horizontally scrolling lawn calendar. The server renders every task (good for
// search engines); the browser stamps today's date and marks what's done, now and next.
import { TASKS, MONTHS_LONG, windowText } from '../data/tasks.js';

interface Props { compact?: boolean }
// compact (homepage): no heading/summary, task names only, at most SHOW (2) per month with "+N more"
const { compact = false } = Astro.props;
const SHOW = 2;
const list = TASKS.filter((t) => t.level <= 2);
// each month lists tasks that start in it, then tasks still running from an earlier month ("Still going")
const SMALL = new Set(['a', 'an', 'the', 'and', 'or', 'of', 'to', 'in', 'on', 'at', 'by', 'for', 'up', 'as']);
const tc = (x: string) => x.split(' ').map((w, i, a) => (i && i < a.length - 1 && SMALL.has(w.toLowerCase()) ? w.toLowerCase() : w.charAt(0).toUpperCase() + w.slice(1))).join(' ');
const SHORT_M = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'June', 'July', 'Aug', 'Sept', 'Oct', 'Nov', 'Dec'];
const months = MONTHS_LONG.map((name, i) => ({
  name,
  tasks: [
    ...list.filter((t) => t.start[0] === i + 1).map((t) => ({ t, cont: false })),
    ...list.filter((t) => t.start[0] < i + 1 && t.end[0] >= i + 1).map((t) => ({ t, cont: true })),
  ],
}));
---
<section class:list={['calendar', { 'is-compact': compact }]} aria-labelledby="cal-h" data-calendar>
  {compact ? (
  <div class="cal-head row-head">
    <h2 id="cal-h" class="cal-mini-h">The Lawn Year at a Glance</h2>
    <a class="row-all" href="/resources/#cal-h" aria-label="See the full calendar">View All</a>
  </div>
  ) : (<Fragment>
  <div class="cal-head">
    <h2 id="cal-h">What Your Lawn Needs Right Now</h2>
    <p class="cal-today">
      Today is <time data-today>this week</time>. Timing is set for Westchester &amp; the Lower Hudson Valley.
    </p>
    <p class="cal-place-note" data-place-note hidden></p>
  </div>

  <div class="cal-summary" data-summary>
    <div class="cal-sum" data-sum="last">
      <p class="cal-sum-label">Last up</p>
      <p class="cal-sum-title" data-title>…</p>
      <p class="cal-sum-when" data-when></p>
    </div>
    <div class="cal-sum is-now" data-sum="now">
      <p class="cal-sum-label">Do it now</p>
      <p class="cal-sum-title" data-title>…</p>
      <p class="cal-sum-when" data-when></p>
    </div>
    <div class="cal-sum" data-sum="next">
      <p class="cal-sum-label">Next up</p>
      <p class="cal-sum-title" data-title>…</p>
      <p class="cal-sum-when" data-when></p>
    </div>
  </div>
  </Fragment>)}

  <div class="cal-track" data-track tabindex="0" aria-label="Lawn care calendar, January to December. Scroll sideways.">
    {months.map((m, i) => (
      <div class="cal-month" data-month={i + 1}>
        <h3 class="cal-month-name">{m.name}</h3>
        <span class="cal-flag" hidden>Now</span>
        {m.tasks.length === 0 && (
          <p class="cal-rest">{i < 2 ? 'Rest. Dream about spring.' : 'Nothing new. Keep it up.'}</p>
        )}
        {m.tasks.map(({ t, cont }, k) => compact ? (
          <article class:list={['cal-task', 'cal-flipcard', { 'is-extra': k >= SHOW, 'is-cont': cont }]} data-task={t.id} data-start={t.start.join('-')} data-end={t.end.join('-')} tabindex="0" role="button" aria-pressed="false" aria-label={`${t.title}. Tap for how.`}>
            <div class="cal-flip">
              <div class="cal-face cal-front">
                <p class="cal-window">{cont ? `Still going · since ${SHORT_M[t.start[0] - 1]}` : windowText(t)}</p>
                <h4>{tc(t.title)}</h4>
                <p class="cal-brief">{t.brief}</p>
                <p class="cal-status" data-status></p>
              </div>
              <div class="cal-face cal-back" aria-hidden="true">
                <p class="cal-window">{windowText(t)}</p>
                <p>{t.short}</p>
                <p><b>How:</b> {t.why}</p>
              </div>
            </div>
          </article>
        ) : (
          <article class:list={['cal-task', { 'is-cont': cont }]} data-task={t.id} data-start={t.start.join('-')} data-end={t.end.join('-')}>
            <p class="cal-window">{cont ? `Still going · since ${SHORT_M[t.start[0] - 1]}` : windowText(t)}</p>
            <h4>{tc(t.title)}</h4>
            <p>{t.short}</p>
            <p class="cal-status" data-status></p>
          </article>
        ))}
        {compact && m.tasks.length > SHOW && (
          <button type="button" class="cal-more" data-cal-more>+{m.tasks.length - SHOW} more</button>
        )}
      </div>
    ))}
  </div>
  {compact ? null : (
  <p class="cal-cta">
    This is the general plan. <a href="/plan/">Get your free lawn plan</a> for one built for your yard and your energy level.
  </p>
  )}
</section>

<script>
  import { TASKS, statusOf, snapshot, windowText, fmt } from '../data/tasks.js';
  import { getPlace, noteFor } from '../scripts/place.js';

  const placeNote = document.querySelector('[data-place-note]');
  const showNote = (p) => { if (placeNote) { placeNote.textContent = noteFor(p); placeNote.hidden = !placeNote.textContent; } };
  showNote(getPlace());
  window.addEventListener('mit:place', (e) => showNote(e.detail));

  const root = document.querySelector('[data-calendar]');
  if (root) {
    const today = new Date();
    const list = TASKS.filter((t) => t.level <= 2);
    const todayEl = root.querySelector('[data-today]');
    if (todayEl) {
      todayEl.textContent = today.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
      todayEl.setAttribute('datetime', today.toISOString().slice(0, 10));
    }
    // endless loop: a copy of the year on each side, so scrolling past December lands on January (and back)
    const track = root.querySelector('[data-track]');
    const orig = [...track.children];
    const copy = () => orig.map((n) => {
      const c = n.cloneNode(true);
      c.classList.add('is-clone'); c.setAttribute('aria-hidden', 'true');
      c.querySelectorAll('[tabindex]').forEach((e) => e.setAttribute('tabindex', '-1'));
      return c;
    });
    track.prepend(...copy()); track.append(...copy());
    const yearW = () => orig[0].offsetLeft - track.children[0].offsetLeft;
    let loopT;
    const wrap = () => {
      const w = yearW();
      if (!w) return;
      if (track.scrollLeft < w * 0.2) track.scrollLeft += w;
      else if (track.scrollLeft > w * 1.95) track.scrollLeft -= w;
    };
    track.addEventListener('scroll', () => { clearTimeout(loopT); loopT = setTimeout(wrap, 140); }, { passive: true });

    for (const b of root.querySelectorAll('[data-cal-more]')) {
      b.addEventListener('click', () => { b.parentElement.classList.add('is-open'); b.remove(); });
    }

    const plural = (n, w) => `${n} ${w}${n === 1 ? '' : 's'}`;
    for (const card of root.querySelectorAll('[data-task]')) {
      const t = TASKS.find((x) => x.id === card.dataset.task);
      const s = statusOf(t, today);
      card.dataset.state = s.state;
      card.querySelector('[data-status]').textContent =
        s.state === 'now' ? `Happening now, ${plural(s.daysLeft, 'day')} left`
        : s.state === 'next' ? `In ${plural(s.days, 'day')}`
        : 'Done for this year';
    }

    const snap = snapshot(list, today);
    if (root.querySelector('[data-summary]')) {
    const fill = (key, title, when) => {
      const el = root.querySelector(`[data-sum="${key}"]`);
      el.querySelector('[data-title]').textContent = title;
      el.querySelector('[data-when]').textContent = when;
    };
    if (snap.last) fill('last', snap.last.t.title, `${windowText(snap.last.t)}. Ended ${plural(snap.last.s.ago, 'day')} ago.`);
    else root.querySelector('[data-sum="last"]').hidden = true;
    if (snap.now.length) {
      const first = snap.now[0];
      const extra = snap.now.length > 1 ? ` Plus ${snap.now.length - 1} more below.` : '';
      fill('now', first.t.title, `Through ${fmt(first.t.end)}. ${plural(first.s.daysLeft, 'day')} left.${extra}`);
    } else {
      fill('now', 'Nothing urgent. Enjoy it.', 'Your lawn is between jobs.');
    }
    if (snap.next) fill('next', snap.next.t.title, `Starts ${fmt(snap.next.t.start)}. In ${plural(snap.next.s.days, 'day')}.`);
    }

    // compact: cards flip to show how; card height follows the side showing
    const flips = [...root.querySelectorAll('.cal-flipcard')];
    const fitCard = (c) => {
      if (!c.offsetParent) return;
      const side = c.querySelector(c.classList.contains('is-flipped') ? '.cal-back' : '.cal-front');
      c.style.height = `${side.offsetHeight}px`;
    };
    const fitCards = () => flips.forEach(fitCard);
    flips.forEach((c) => {
      const flip = () => {
        const on = !c.classList.contains('is-flipped');
        c.classList.toggle('is-flipped', on);
        c.setAttribute('aria-pressed', String(on));
        c.querySelector('.cal-front').setAttribute('aria-hidden', String(on));
        c.querySelector('.cal-back').setAttribute('aria-hidden', String(!on));
        fitCard(c);
      };
      c.addEventListener('click', flip);
      c.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); flip(); } });
    });
    fitCards();
    document.fonts?.ready.then(fitCards);
    window.addEventListener('resize', fitCards);
    for (const b of root.querySelectorAll('[data-cal-more]')) b.addEventListener('click', () => requestAnimationFrame(fitCards));
    if (flips.length && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (!e.isIntersecting) return;
        const c = e.target; io.unobserve(c);
        setTimeout(() => { if (!c.classList.contains('is-flipped')) c.classList.add('cal-jiggle'); }, 400);
        c.addEventListener('animationend', () => c.classList.remove('cal-jiggle'), { once: true });
      }), { threshold: 0.9 });
      root.querySelectorAll(`[data-month="${today.getMonth() + 1}"] .cal-flipcard`).forEach((c) => io.observe(c));
    }

    // mark this month and scroll it into view, with last month peeking in
    const month = today.getMonth() + 1;
    root.querySelectorAll(`[data-month="${month}"]`).forEach((m) => { m.classList.add('is-current'); m.querySelector('.cal-flag').hidden = false; });
    const col = orig.find((m) => m.dataset.month === String(month));
    const prev = col.previousElementSibling;
    const align = () => {
      const pad = parseFloat(getComputedStyle(track).paddingLeft) || 0;
      const delta = col.getBoundingClientRect().left - track.getBoundingClientRect().left - pad - (prev ? 48 : 0);
      track.style.scrollSnapType = 'none'; // let last month peek in
      track.scrollLeft += delta;
      track.addEventListener('pointerdown', () => { track.style.scrollSnapType = ''; }, { once: true });
    };
    requestAnimationFrame(align);
  }
</script>
