---
// Homepage hero: headline + one line about the site + the main CTA, then a quick mowing game in its own box.
---
<section class="hero2" aria-labelledby="hero-h" data-hero>
  <h1 id="hero-h">A better lawn, without becoming a lawn&nbsp;guy.</h1>
  <p class="hero-lede">
    Small, easy changes for lawns in Westchester &amp; the Lower Hudson Valley, from the neighbor with the striped lawn.
  </p>
  <div class="hero-cta">
    <a class="btn btn-big" href="/plan/" data-hero-cta>Get my free lawn plan</a>
    <span class="hero-cta-note">7 quick questions. No email needed.</span>
  </div>

  <div class="window mow-box">
  <div class="mow-box-head">
    <h2 class="mow-box-title">Quick game: <span>stripe this lawn</span></h2>
  </div>
  <div class="mow" data-mow>
    <div class="mow-stats" aria-live="polite">
      <span>Mowed <b data-pct>0%</b></span>
      <span>Time <b data-time>0:00</b><small> / par 0:45</small></span>
      <span>Best <b data-best>–</b></span>
    </div>
    <div class="mow-play">
    <div class="mow-lawn">
      <canvas aria-label="A small lawn with a push mower. Use the slider to line up the mower and hold the button to mow."></canvas>
      <p class="mow-hint" data-hint aria-hidden="true">Slide to line up. Hold to mow.<br /><small>Par is 45 seconds. Mind the dog.</small></p>
      <p class="mow-pop" data-pop aria-live="polite"></p>
      <button type="button" class="mow-done" data-done hidden>Call it done</button>
    </div>
    <div class="mow-track" data-mow-track role="slider" tabindex="0" aria-label="Mower position" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <span class="mow-knob" data-knob aria-hidden="true"><i></i><i></i><i></i></span>
    </div>
    <button type="button" class="mow-hold" data-hold><span>Hold to mow</span></button>
    <div class="mow-result" data-result hidden role="dialog" aria-label="Your mowing score">
      <button type="button" class="mow-x" data-close aria-label="Close and look at your lawn">&times;</button>
      <p class="mow-score"><b data-score>0</b><span>/100</span></p>
      <p class="mow-title" data-title></p>
      <ul class="mow-detail" data-detail></ul>
      <p class="mow-tip" data-tip></p>
      <button type="button" class="btn mow-again" data-again>Mow again</button>
    </div>
    </div>
  </div>
  <p class="mow-box-more">Want more? <a href="/games/">Eight yards on the games page</a></p>
  </div>
</section>

<script>
  import { initHeroMower } from '../scripts/heroMower.js';
  const mow = document.querySelector('[data-mow]');
  if (mow) initHeroMower(mow);
</script>
