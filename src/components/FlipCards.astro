---
// Tap-to-flip cards. Both faces are in the page for search engines and screen readers;
// the button just turns the card over.
import PixelIcon from './PixelIcon.astro';

interface Item {
  id?: string;
  icon?: string[];
  photos?: { src: string; alt: string; caption?: string }[];   // src is the base path: <src>-480.webp / <src>-960.webp
  title: string;
  sub?: string;
  back: { label?: string; text: string }[];
}
interface Props {
  items: Item[];
  layout?: 'grid' | 'list';
  headingLevel?: 'h3' | 'h2';
}
const { items, layout = 'grid', headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<ul class:list={['flips', `flips-${layout}`]} data-flips>
  {items.map((it, i) => (
    <li class:list={['flip', it.photos && 'has-photos']} id={it.id}>
      <div class="flip-inner">
        <div class:list={['flip-face flip-front', it.photos && 'has-photo']}>
          {it.photos ? (
            <div class="flip-photos" data-photos>
              <div class="flip-photos-track" tabindex="0" aria-label={`${it.title} photos. Swipe for more.`}>
                {it.photos.map((p, j) => (
                  <figure class="flip-photo-slide">
                    <img class="flip-photo" src={`${p.src}-480.webp`} srcset={`${p.src}-480.webp 480w, ${p.src}-960.webp 960w`}
                      sizes="(min-width: 700px) 640px, 92vw" width="960" height="720" alt={p.alt}
                      loading={i < 2 && j === 0 ? 'eager' : 'lazy'} decoding="async" />
                    {p.caption && <figcaption>{p.caption}{it.photos.length > 1 && <span> · {j + 1}/{it.photos.length}</span>}</figcaption>}
                  </figure>
                ))}
              </div>
              {it.photos.length > 1 && (
                <>
                  <button type="button" class="flip-photos-nav prev" data-dir="-1" aria-label="Previous photo" hidden>‹</button>
                  <button type="button" class="flip-photos-nav next" data-dir="1" aria-label="Next photo">›</button>
                  <div class="flip-photos-dots" aria-hidden="true">{it.photos.map((_, j) => <i class:list={[j === 0 && 'on']}></i>)}</div>
                </>
              )}
            </div>
          ) : it.icon && <PixelIcon map={it.icon} size={layout === 'list' ? 44 : 52} />}
          <div class="flip-front-text">
            <H class="flip-title">{it.title}</H>
            {it.sub && <p class="flip-sub">{it.sub}</p>}
          </div>
          <span class="flip-hint" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="16" height="16"><path d="M3 8a5 5 0 0 1 8.5-3.5L13 6M13 2v4H9M13 8a5 5 0 0 1-8.5 3.5L3 10M3 14v-4h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Tap
          </span>
        </div>
        <div class="flip-face flip-back">
          <p class="flip-back-title">{it.title}</p>
          {it.back.map((b) => (
            <p class="flip-back-row">
              {b.label && <strong>{b.label}</strong>}
              {b.text}
            </p>
          ))}
          <span class="flip-hint" aria-hidden="true">Tap to flip back</span>
        </div>
      </div>
      <button type="button" class="flip-btn" aria-expanded="false" aria-label={`${it.title}: show details`}></button>
    </li>
  ))}
</ul>

<script>
  // The card takes the height of whichever face is showing, so short fronts stay short.
  const fit = (card) => {
    const face = card.querySelector(card.classList.contains('is-flipped') ? '.flip-back' : '.flip-front');
    card.querySelector('.flip-inner').style.height = `${face.offsetHeight}px`;
  };
  for (const list of document.querySelectorAll('[data-flips]')) {
    const cards = [...list.querySelectorAll('.flip')];
    const fitAll = () => cards.forEach(fit);
    fitAll();
    new ResizeObserver(fitAll).observe(list);
    document.fonts?.ready.then(fitAll);
    // Photo sets. Phones won't scroll sideways inside a 3D-flipped card, so the swipe is done by hand:
    // follow the finger with a transform, snap to the nearest photo, let up/down drags scroll the page.
    for (const ph of list.querySelectorAll('[data-photos]')) {
      const track = ph.querySelector('.flip-photos-track');
      const dots = [...ph.querySelectorAll('.flip-photos-dots i')];
      const prev = ph.querySelector('.prev'), next = ph.querySelector('.next');
      const n = track.children.length;
      let k = 0, x0 = 0, y0 = 0, dx = 0, mode = null, moved = false;
      const go = (i, animate = true) => {
        k = Math.max(0, Math.min(n - 1, i));
        track.style.transition = animate ? 'transform 0.28s ease-out' : 'none';
        track.style.transform = `translateX(${-k * 100}%)`;
        dots.forEach((d, j) => d.classList.toggle('on', j === k));
        if (prev) prev.hidden = k <= 0;
        if (next) next.hidden = k >= n - 1;
        // load the next photo early so it's ready before the swipe lands
        track.children[Math.min(n - 1, k + 1)]?.querySelector('img')?.setAttribute('loading', 'eager');
      };
      ph._go = go;
      if (n > 1) {
        track.addEventListener('pointerdown', (e) => {
          if (e.pointerType === 'mouse' && e.button !== 0) return;
          x0 = e.clientX; y0 = e.clientY; dx = 0; mode = null; moved = false;
        });
        track.addEventListener('pointermove', (e) => {
          if (x0 === null) return;
          const mx = e.clientX - x0, my = e.clientY - y0;
          if (!mode && Math.hypot(mx, my) > 8) {
            mode = Math.abs(mx) > Math.abs(my) ? 'x' : 'y';
            if (mode === 'x') { track.setPointerCapture(e.pointerId); moved = true; }
          }
          if (mode !== 'x') return;
          dx = mx;
          const edge = (k === 0 && dx > 0) || (k === n - 1 && dx < 0) ? 0.3 : 1;   // rubber band at the ends
          track.style.transition = 'none';
          track.style.transform = `translateX(calc(${-k * 100}% + ${dx * edge}px))`;
        });
        const end = () => {
          if (mode === 'x') {
            const w = track.clientWidth;
            go(k + (dx < -w * 0.18 ? 1 : dx > w * 0.18 ? -1 : 0));
          }
          x0 = null; mode = null;
        };
        track.addEventListener('pointerup', end);
        track.addEventListener('pointercancel', end);
        track.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight') { go(k + 1); e.preventDefault(); }
          if (e.key === 'ArrowLeft') { go(k - 1); e.preventDefault(); }
        });
      }
      x0 = null;
      ph.addEventListener('click', (e) => {
        e.stopPropagation();
        if (moved) { moved = false; return; }   // a swipe isn't a tap
        const nav = e.target.closest('.flip-photos-nav');
        if (nav) { go(k + Number(nav.dataset.dir)); return; }
        ph.closest('.flip').querySelector('.flip-btn').click();
      });
      go(0, false);
    }
    // On photo cards the button is keyboard-only, so taps anywhere else on the card flip it.
    for (const card of list.querySelectorAll('.flip.has-photos')) {
      card.querySelector('.flip-inner').addEventListener('click', (e) => {
        if (e.target.closest('[data-photos]')) return;
        card.querySelector('.flip-btn').click();
      });
    }
    list.addEventListener('click', (e) => {
      const btn = e.target.closest('.flip-btn');
      if (!btn) return;
      const card = btn.closest('.flip');
      const open = card.classList.toggle('is-flipped');
      fit(card);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', `${card.querySelector('.flip-title').textContent}: ${open ? 'hide' : 'show'} details`);
    });
    // One gentle peek the first time the cards scroll into view, so people know they flip.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const first = list.querySelector('.flip');
      const io = new IntersectionObserver(([en]) => {
        if (!en.isIntersecting) return;
        first.classList.add('is-peeking');
        setTimeout(() => first.classList.remove('is-peeking'), 1100);
        io.disconnect();
      }, { threshold: 0.6 });
      if (first) io.observe(first);
    }
  }
</script>
