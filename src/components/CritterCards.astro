---
// Suspect lineup for the animals post: tap-to-flip cards (FlipCards) fed by src/data/critters.js.
import FlipCards from './FlipCards.astro';
import { CRITTERS } from '../data/critters.js';
---
<section class="window crit" aria-labelledby="crit-h">
  <h2 id="crit-h">The suspect lineup</h2>
  <p class="crit-sub">Find the clue you saw. Tap the card to see what it means.</p>
  <FlipCards items={CRITTERS} layout="list" />
</section>
