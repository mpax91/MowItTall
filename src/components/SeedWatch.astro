---
// "Is my grass seed working?" Seed countdown: seed type + date planted (+ what you see) → day count,
// stage picture, timeline, verdict, watering, when to mow and what to watch for. Saved in localStorage `mit-seed`.
// Germination windows: UC IPM / Purdue / extension consensus (rye 5–10 days, tall & fine fescue 7–14, bluegrass 14–30).
// First mow: when about 1/3 taller than mowing height, typically 4–6 weeks (Univ. of Maryland Extension). Mike reviews.
import PlaceChip from './PlaceChip.astro';
const { id = 'seedwatch', guide = true } = Astro.props;
const SEEDS = [
  { id: 'kbg-rye', name: 'Bluegrass + rye blend', first: [5, 10], last: [14, 30], note: 'The rye pops first. The bluegrass shows up a week or two later.' },
  { id: 'sunshade', name: 'Sun and shade mix', first: [5, 10], last: [14, 30], note: 'Rye first, then the fescue, then the bluegrass. It shows up in waves.' },
  { id: 'rye', name: 'Perennial ryegrass', first: [5, 10], last: [5, 10], note: 'The fastest grass there is. You’ll know soon.' },
  { id: 'tttf', name: 'Tall fescue blend', first: [7, 14], last: [7, 14], note: 'Usually green by week two.' },
  { id: 'ff', name: 'Fine fescue / shade mix', first: [7, 14], last: [7, 14], note: 'Thin, needle-like sprouts. Easy to miss.' },
  { id: 'kbg', name: '100% Kentucky bluegrass', first: [14, 30], last: [14, 30], note: 'The slowest one. Up to a month of nothing is normal.' },
  { id: 'unsure', name: 'Not sure (store mix)', first: [5, 10], last: [14, 30], note: 'Most store mixes have rye in them, so the first green shows fast.' },
];
const SEES = [
  { id: 'nothing', t: 'Nothing yet' },
  { id: 'few', t: 'A few sprouts' },
  { id: 'fuzz', t: 'Green fuzz' },
  { id: 'patchy', t: 'Up, but patchy' },
  { id: 'tall', t: 'It’s getting tall' },
];
const seedJson = JSON.stringify(SEEDS);
---
<section class="window tool sw" id={id} aria-labelledby={`${id}-h`} data-seedwatch data-seeds={seedJson}>
  <h2 id={`${id}-h`}>Is My Grass Seed Working?</h2>
  <p class="tool-sub">Tell me what you planted and when. I’ll tell you what you should see, what to do, and whether to worry. (Probably don’t.)</p>

  <div class="sw-inputs">
    <label class="sw-wide"><span>What did you plant?</span>
      <select data-sw-type>
        {SEEDS.map((s) => <option value={s.id}>{s.name}</option>)}
      </select>
    </label>
    <label><span>Date planted</span><input type="date" data-sw-date /></label>
    <div class="sw-where"><span>Where</span> <PlaceChip id={`${id}-place`} /></div>
  </div>

  <fieldset class="sw-see">
    <legend>What do you see right now? <small>(optional)</small></legend>
    <div class="cp-chips">
      {SEES.map((s) => <button type="button" class="cp-chip" data-sw-see={s.id} aria-pressed="false">{s.t}</button>)}
    </div>
  </fieldset>

  <div class="sw-out" aria-live="polite">
    <div class="sw-head">
      <p class="sw-day"><b data-sw-day>Day –</b><span data-sw-stage>Pick a date</span></p>
      <span class="mc-word" data-tone="close" data-sw-word>…</span>
    </div>
    <div class="sw-tm" data-sw-tm>
      <div class="sw-tm-top">
        <p class="sw-tm-day"><small>Slide Through 8 Weeks</small><b data-sw-tday>Day 0</b><span data-sw-tstage></span></p>
        <button type="button" class="sw-tm-play" data-sw-play aria-label="Play the next 8 weeks">▶ Play</button>
      </div>
      <div class="sw-tm-view" data-sw-view>
        <svg class="sw-scene" viewBox="0 0 96 52" shape-rendering="crispEdges" role="img" aria-label="Your seeded soil on the day picked with the slider" data-sw-scene></svg>
        <span class="sw-tm-hint" data-sw-hint aria-hidden="true">◀ Slide ▶</span>
      </div>
      <p class="sw-tm-cap" data-sw-cap aria-live="polite"></p>
      <div class="sw-tm-slider">
        <div class="sw-tm-bands" aria-hidden="true">
          <span class="sw-tm-band sw-b-sprout" data-sw-bsprout></span>
          <span class="sw-tm-band sw-b-mow" data-sw-bmow></span>
          <span class="sw-tm-you" data-sw-you>You</span>
        </div>
        <input type="range" min="0" max="60" step="1" value="0" data-sw-range aria-label="Days since you planted" />
        <div class="sw-tm-ticks" aria-hidden="true"><span>Plant</span><span>2 wks</span><span>4 wks</span><span>6 wks</span><span>8 wks</span></div>
        <div class="sw-tm-key" aria-hidden="true"><span><i class="k-sprout"></i>Sprouts</span><span><i class="k-mow"></i>First mow</span></div>
      </div>
      <button type="button" class="sw-tm-now is-off" data-sw-now>Back to Today</button>
    </div>
    <ol class="sw-steps" data-sw-steps></ol>
    <p class="sw-verdict" data-sw-verdict></p>
    <div class="sw-cards">
      <div class="sw-card"><h3>Watering Now</h3><p data-sw-water></p></div>
      <div class="sw-card"><h3>When Can I Mow?</h3><p data-sw-mow></p></div>
    </div>
    <div class="sw-card sw-watch"><h3>What to Watch For</h3><ul data-sw-watch></ul></div>
    <p class="sw-soil" data-sw-soil hidden></p>
    <div class="sw-calm">
      <h3>Don’t Freak Out. Trust the Process.</h3>
      <p>Not every seed makes it, and that’s planned for. The germination number on the bag comes from a lab with perfect conditions. In a real yard, fewer come up, and the seeding rate on the bag already counts on that. Sprouts come in waves, thin spots are normal for the first month, and a lawn from seed keeps thickening into next spring.</p>
    </div>
    <div class="sw-actions">
      <button type="button" class="btn btn-small" data-sw-ics>Add Reminders to My Calendar</button>
      {guide && <a class="btn btn-small btn-quiet" href="/blog/is-my-grass-seed-growing/">The Full Seed Guide</a>}
    </div>
  </div>
  <p class="tool-fine">Typical windows for Northeast lawns with the soil kept damp. Cold soil, dry spells and buried seed all slow things down. Your seed bag wins over me.</p>
</section>

<script>
  import { saveProfile } from '../scripts/profile.js';
  import { getPlace } from '../scripts/place.js';
  const KEY = 'mit-seed';
  const DAY = 86400000;

  document.querySelectorAll<HTMLElement>('[data-seedwatch]').forEach((root) => {
    const SEEDS = JSON.parse(root.dataset.seeds!);
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const type = $<HTMLSelectElement>('[data-sw-type]'), date = $<HTMLInputElement>('[data-sw-date]');
    const seeChips = [...root.querySelectorAll<HTMLButtonElement>('[data-sw-see]')];
    const iso = (d: Date) => new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
    let see = '';

    // restore
    let saved: any = {};
    try { saved = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch {}
    if (saved.type && SEEDS.some((s: any) => s.id === saved.type)) type.value = saved.type;
    else {
      // no saved seed yet: start from the grass picker's answer if there is one
      const fromPicker: Record<string, string> = { 'kbg-rye': 'kbg-rye', rye: 'rye', tttf: 'tttf', sunshade: 'sunshade', shade: 'ff' };
      try { const g = localStorage.getItem('mit-grass'); if (g && fromPicker[g]) type.value = fromPicker[g]; } catch {}
    }
    date.value = saved.date || iso(new Date(Date.now() - 7 * DAY));
    date.max = iso(new Date());
    see = saved.see || '';
    let synced = '';
    const save = () => {
      try { localStorage.setItem(KEY, JSON.stringify({ type: type.value, date: date.value, see })); } catch {}
      if (date.value && date.value !== synced) { synced = date.value; saveProfile('seeded', date.value); }
    };

    /* ---------- the picture: soil, seed and grass drawn as pixels, for any day 0–60.
       Every blade gets its own sprout day (fast wave / slow wave), growth rate and a later side shoot,
       so sliding shows sprouts appearing in waves, filling in, the first mow, and thickening up. */
    const W = 96, H = 52, SOIL = 38, PX_IN = 7, K = PX_IN / 5; // close-up: grass grows up from y=38; 7 px = 1 inch
    function blades(sd: any) {
      let s = 11; const r = () => ((s = (s * 9301 + 49297) % 233280) / 233280);
      const mixed = sd.first[0] !== sd.last[0];
      const out: any[] = [];
      for (let x = 6; x < W; x++) for (let k = 0; k < 2; k++) {
        if (r() < 0.12) continue;
        const fast = !mixed || r() < 0.45;
        const win = fast ? sd.first : sd.last;
        const nogo = r() < 0.22;                       // not every seed makes it (and that's planned for)
        const sprout = win[0] + r() * (win[1] - win[0]) + (r() < 0.12 ? r() * 6 : 0);
        out.push({ x, nogo, sprout, rate: K * (fast && mixed ? 0.95 : sd.first[0] >= 14 ? 0.62 : 0.85) * (0.75 + r() * 0.5),
          tiller: sprout + 16 + r() * 16, tx: r() < 0.5 ? -1 : 1, shade: r(), seedY: SOIL - 1 + Math.round(r()) });
      }
      return out;
    }
    const mowDayOf = (sd: any) => (sd.first[0] >= 14 ? 44 : 33);
    const CUT = Math.round(3.4 * PX_IN);             // ~3.5 inches after mowing
    function heightAt(g: number, rate: number, d: number, mowDay: number) {
      if (g < 0) return 0;
      const grow = (n: number) => Math.min(4.8 * PX_IN, rate * n * (n < 6 ? 0.55 : 1) + (n < 6 ? 0 : -2.7 * rate));
      let h = Math.max(1, grow(g));
      if (d >= mowDay && h > CUT) h = Math.min(h, CUT + 0.55 * K * ((d - mowDay) % 7));
      return h;
    }
    function scene(d: number, sd: any, bl: any[]) {
      const px: string[] = [];
      const rect = (x: number, y: number, w: number, h: number, c: string) => px.push(`<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="${c}"/>`);
      const mowDay = mowDayOf(sd);
      rect(0, 0, W, H, '#9fc6e6'); rect(0, 0, W, 6, '#b7d6ee');
      // a fence + a far hedge so it reads as a yard, not a petri dish
      rect(0, 10, W, 1, '#e8eef2'); for (let x = 3; x < W; x += 11) rect(x, 6, 3, SOIL - 6, '#f4f6ef');
      rect(0, 15, W, 1, '#e8eef2');
      // soil (darker while you're keeping it damp)
      const damp = d <= sd.last[1] + 3;
      rect(0, SOIL, W, H - SOIL, damp ? '#5a3d25' : '#6b4a2e');
      let s = 3; const r = () => ((s = (s * 9301 + 49297) % 233280) / 233280);
      for (let i = 0; i < 200; i++) rect(Math.floor(r() * W), SOIL + Math.floor(r() * (H - SOIL)), 1, 1, r() < 0.5 ? (damp ? '#4a3220' : '#5a3d25') : (damp ? '#6b4a2e' : '#7d5838'));
      // seeds still sitting on top
      bl.forEach((b) => { if (b.nogo ? d < 40 : d < b.sprout) rect(b.x, b.seedY, 1, 1, '#d8c08a'); });
      // grass
      const tip = d >= mowDay && (d - mowDay) % 7 < 2;
      bl.forEach((b) => {
        if (b.nogo) return;
        const g = d - b.sprout;
        const h = Math.round(heightAt(g, b.rate, d, mowDay));
        if (!h) return;
        const young = g < 5, old = g > 26;
        const c = young ? '#b5e07a' : old ? (b.shade < 0.5 ? '#4f9a35' : '#68b845') : (b.shade < 0.5 ? '#5fae3e' : '#79c64f');
        rect(b.x, SOIL - h, 1, h, c);
        if (h > 8 && !tip && b.shade > 0.7) rect(b.x + b.tx, SOIL - h + 2, 1, 1, '#9fd36a');
        if (tip && h >= CUT - 1) rect(b.x, SOIL - h, 1, 1, '#d9e6a3');
        const tg = d - b.tiller;                        // side shoot: the lawn thickening up
        if (tg > 0) { const th = Math.round(Math.min(h - 1, heightAt(tg, b.rate * 0.9, d, mowDay))); if (th > 0) rect(b.x + b.tx, SOIL - th, 1, th, b.shade < 0.5 ? '#468f2f' : '#5aa83c'); }
      });
      // ruler: 1"–4" marks so the height means something
      rect(0, SOIL - 4 * PX_IN - 1, 4, 4 * PX_IN + 1, '#f6c945'); rect(3, SOIL - 4 * PX_IN - 1, 1, 4 * PX_IN + 1, '#d99a1c');
      for (let i = 1; i <= 4; i++) rect(0, SOIL - i * PX_IN, i % 2 ? 2 : 3, 1, '#12301d');
      return px.join('');
    }
    const tallestIn = (d: number, sd: any, bl: any[]) => {
      let m = 0; const mowDay = mowDayOf(sd);
      bl.forEach((b) => { if (!b.nogo) m = Math.max(m, heightAt(d - b.sprout, b.rate, d, mowDay)); });
      return m / PX_IN;
    };
    function caption(d: number, sd: any) {
      const mixed = sd.first[0] !== sd.last[0], mowDay = mowDayOf(sd);
      if (d === 0) return 'Seed’s down. Now the hard part: waiting. Keep the top damp, every single day.';
      if (d < sd.first[0]) return `Looks like nothing. It isn’t. Underground, the seed is soaking up water and splitting open. Stay off it.`;
      if (d <= sd.first[1]) return mixed ? 'First green hairs, thinner than thread. That’s the fast grass showing off. Get low and look across the yard in morning light.' : 'First green hairs, thinner than thread. Get low and look across the yard in morning light. Keep watering.';
      if (mixed && d < sd.last[0]) return 'Green fuzz on the fast stuff. The slow grass is still on its way, so don’t stop watering because it “looks done.”';
      if (mixed && d <= sd.last[1]) return 'The second wave shows up between the first sprouts. This is the bluegrass and fescue finally clocking in.';
      if (d <= 21) return 'Filling in. Patchy right now is normal. Ease off to watering once a day, a little longer each time.';
      if (d < mowDay) return 'Getting tall and a little floppy. Roots are chasing water down. Water every few days, longer.';
      if (d <= mowDay + 2) return 'First mow! Mower on its highest setting, sharp blade, dry ground. Take off the top inch, no more.';
      if (d <= 45) return 'Mowed and thickening. Each blade starts sending out side shoots. That’s how thin turns into thick.';
      return 'It’s a lawn. A young one. It keeps thickening through next spring. Thin spots get a pinch more seed.';
    }

    /* ---------- stages */
    function stageOf(d: number, sd: any) {
      if (d < sd.first[0]) return 0;                    // soaking
      if (d <= sd.last[1]) return 1;                     // sprouting
      if (d <= 28) return 2;                             // filling in
      if (d <= 49) return 3;                             // first mow window
      return 4;                                          // growing up
    }
    const STAGES = ['Soaking it up', 'Sprouting', 'Filling in', 'First mow window', 'Growing up'];

    async function soilTemp() {
      const p = getPlace(); const el = $('[data-sw-soil]');
      try {
        const u = `https://api.open-meteo.com/v1/forecast?latitude=${p.lat.toFixed(3)}&longitude=${p.lon.toFixed(3)}&current=soil_temperature_6cm&temperature_unit=fahrenheit&timezone=America%2FNew_York`;
        const j = await (await fetch(u)).json();
        const t = Math.round(j.current.soil_temperature_6cm);
        if (!Number.isFinite(t)) return;
        el.hidden = false;
        el.innerHTML = t < 50
          ? `<b>Soil in ${p.name}: ${t}°F.</b> Below about 50°F, seed slows way down. If it went down in September, give it time. If it’s November, it may not make it before winter.`
          : t > 80
            ? `<b>Soil in ${p.name}: ${t}°F.</b> That’s hot for cool-season seed. Keep the surface damp and expect some losses.`
            : `<b>Soil in ${p.name}: ${t}°F.</b> Right in the sweet spot (50–70°F) for sprouting.`;
      } catch { el.hidden = true; }
    }

    /* ---------- the time machine: slide (or drag the picture, or hit Play) through days 0–60 */
    const range = $<HTMLInputElement>('[data-sw-range]'), view = $('[data-sw-view]');
    const playBtn = $<HTMLButtonElement>('[data-sw-play]'), nowBtn = $<HTMLButtonElement>('[data-sw-now]');
    const MAX = 60, pctOf = (n: number) => `${(Math.min(MAX, n) / MAX) * 100}%`;
    let tm = { sd: null as any, bl: [] as any[], blFor: '', today: 0, day: 0, touched: false };
    let raf = 0, used = false;
    function show(day: number) {
      const sd = tm.sd; if (!sd) return;
      tm.day = Math.max(0, Math.min(MAX, Math.round(day)));
      range.value = String(tm.day);
      $('[data-sw-scene]').innerHTML = scene(tm.day, sd, tm.bl);
      const isToday = tm.day === Math.min(MAX, tm.today);
      const inches = tallestIn(tm.day, sd, tm.bl);
      $('[data-sw-tday]').textContent = tm.day === 0 ? 'Planting Day' : `Day ${tm.day}`;
      $('[data-sw-tstage]').textContent = (isToday && tm.today <= MAX ? 'Today · ' : '') + (inches < 0.2 ? 'Nothing up yet' : `Tallest: about ${inches < 1 ? '½' : Math.round(inches * 2) / 2} in`).replace('.5 in', '½ in');
      $('[data-sw-cap]').textContent = caption(tm.day, sd);
      nowBtn.classList.toggle('is-off', isToday || tm.today > MAX);
      nowBtn.textContent = `Back to Today (Day ${tm.today})`;
      range.setAttribute('aria-valuetext', `Day ${tm.day}`);
    }
    function setToday(d: number, sd: any) {
      tm.sd = sd; tm.today = d;
      if (tm.blFor !== sd.id) { tm.bl = blades(sd); tm.blFor = sd.id; }
      const mixed = sd.first[0] !== sd.last[0];
      const sprout = $('[data-sw-bsprout]'), mow = $('[data-sw-bmow]'), you = $('[data-sw-you]');
      sprout.style.left = pctOf(sd.first[0]); sprout.style.width = `calc(${pctOf(mixed ? sd.last[1] : sd.first[1])} - ${pctOf(sd.first[0])})`;
      const md = mowDayOf(sd); mow.style.left = pctOf(md - 3); mow.style.width = `calc(${pctOf(md + 9)} - ${pctOf(md - 3)})`;
      you.hidden = d > MAX; you.style.left = pctOf(d);
      if (!tm.touched) show(Math.min(d, MAX)); else show(tm.day);
    }
    const touch = () => {
      tm.touched = true; $('[data-sw-hint]').classList.add('is-gone');
      if (!used) { used = true; (window as any).mitTrack?.('tool_use', { tool_name: 'seed_timeline', choice: type.value }); }
    };
    const stop = () => { cancelAnimationFrame(raf); raf = 0; playBtn.textContent = '▶ Play'; };
    range.addEventListener('input', () => { stop(); touch(); show(+range.value); });
    nowBtn.addEventListener('click', () => { stop(); show(tm.today); });
    playBtn.addEventListener('click', () => {
      if (raf) return stop();
      touch();
      const from = tm.day >= MAX ? 0 : tm.day, t0 = performance.now(), dur = (MAX - from) * 85;
      playBtn.textContent = '❚❚ Pause';
      const step = (t: number) => {
        const day = from + ((t - t0) / dur) * (MAX - from);
        show(day);
        if (day < MAX) raf = requestAnimationFrame(step); else stop();
      };
      raf = requestAnimationFrame(step);
    });
    // drag sideways on the picture to scrub; vertical swipes still scroll the page (touch-action: pan-y)
    let drag: { x: number; day: number; id: number } | null = null;
    view.addEventListener('pointerdown', (e) => { drag = { x: e.clientX, day: tm.day, id: e.pointerId }; });
    view.addEventListener('pointermove', (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      const dx = e.clientX - drag.x;
      if (Math.abs(dx) < 4) return;
      stop(); touch();
      show(drag.day + (dx / view.clientWidth) * MAX);
    });
    const end = () => { drag = null; };
    view.addEventListener('pointerup', end); view.addEventListener('pointercancel', end); view.addEventListener('pointerleave', end);

    function update() {
      const sd = SEEDS.find((s: any) => s.id === type.value);
      const planted = new Date(date.value + 'T12:00');
      const today = new Date(); today.setHours(12, 0, 0, 0);
      const d = Math.round((today.getTime() - planted.getTime()) / DAY);
      seeChips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.swSee === see)));
      save();
      if (!date.value || Number.isNaN(d)) return;
      if (d < 0) {
        setToday(0, sd);
        $('[data-sw-day]').textContent = 'Not yet';
        $('[data-sw-stage]').textContent = 'That date is in the future';
        $('[data-sw-verdict]').textContent = 'Pick the day you actually spread the seed.';
        return;
      }
      const st = stageOf(d, sd);
      const mixed = sd.first[0] !== sd.last[0];
      // how far through the sprouting waves we are (for the picture)
      $('[data-sw-day]').textContent = `Day ${d}`;
      $('[data-sw-stage]').textContent = STAGES[st];
      setToday(d, sd);

      const steps = [
        ['Day 0', 'Seed down'],
        [`Days ${sd.first[0]}–${sd.first[1]}`, mixed ? 'First sprouts' : 'Sprouts'],
        ...(mixed ? [[`Days ${sd.last[0]}–${sd.last[1]}`, 'The slow ones show up']] : []),
        ['Weeks 4–6', 'First mow'],
        ['Next spring', 'Thick lawn'],
      ];
      $('[data-sw-steps]').innerHTML = steps.map(([a, b]) => `<li><b>${a}</b><span>${b}</span></li>`).join('');

      // verdict: what they should see vs. what they see
      let word = 'ON TRACK', tone = 'yes', line = '';
      const late = d > sd.last[1] + 7;
      if (st === 0) {
        line = `Nothing to see yet, and that’s exactly right. The seed is soaking up water and splitting open. ${sd.note} First green usually shows around day ${sd.first[0]} to ${sd.first[1]}.`;
        if (see && see !== 'nothing') { word = 'AHEAD OF SCHEDULE'; line = `Already? Nice. Some seed always jumps early. ${sd.note}`; }
        else { word = see ? 'RIGHT ON TIME' : 'TOO SOON TO TELL'; tone = see ? 'yes' : 'close'; }
      } else if (st === 1) {
        line = mixed
          ? `Sprout season. Get low, look across the yard in morning light, and you’ll see thin green hairs. ${sd.note} Keep watering until day ${sd.last[1]} even if it looks done.`
          : `Sprout season. Get low and look across the yard in morning light for thin green hairs. ${sd.note}`;
        if (see === 'nothing') {
          if (d <= sd.first[1] + 3) { word = 'STILL NORMAL'; tone = 'close'; line = `Nothing yet on day ${d} is still inside the normal window (days ${sd.first[0]}–${sd.last[1]}). Look closer: early sprouts are thinner than a hair. Keep it damp and check again in a few days.`; }
          else { word = 'KEEP WATERING'; tone = 'close'; line = `It’s getting late for the first wave, but it’s not over. Most seed that “didn’t work” just dried out once or got buried. Keep the top damp every day. Check the list below.`; }
        }
      } else {
        line = st === 2
          ? 'The grass is up and filling in. Patchy right now is normal. Some seed is still coming, and the first ones are growing roots.'
          : st === 3
            ? 'This is the first mow window. Once it’s about 4 inches tall, give it a gentle haircut. Mowing actually helps it thicken up.'
            : 'It’s a lawn now. A young one. Thin spots get a little more seed; the rest thickens up through next spring.';
        if (see === 'nothing') { word = 'LET’S CHECK'; tone = 'no'; line = `Nothing by day ${d} means something got in the way. It happens to everyone. See what to check below, then reseed. Fall seed can still go down until about mid-October around here.`; }
        else if (see === 'few' || see === 'patchy') { word = late ? 'TOUCH UP' : 'NORMAL'; tone = late ? 'close' : 'yes'; if (late) line = `Patchy at day ${d} is common, and it’s fixable. Rake the thin spots lightly, add a little more seed, and keep just those spots damp for two weeks.`; }
      }
      $('[data-sw-word]').textContent = word; $('[data-sw-word]').dataset.tone = tone;
      $('[data-sw-verdict]').textContent = line;

      // watering
      $('[data-sw-water]').textContent = st <= 1
        ? 'Keep the top half inch damp, all the time. Light sprinkles 1 to 3 times a day: more when it’s sunny, warm or windy, less when it’s cool and cloudy. Rain counts. Puddles mean too much.'
        : st === 2
          ? 'Ease off to once a day, a little longer each time, so roots chase the water down. Skip it if it rained.'
          : 'Every few days, longer and deeper. Once you’ve mowed it a couple of times, switch to normal lawn watering: about an inch a week, rain included.';

      // mowing
      const mowFrom = new Date(planted.getTime() + 28 * DAY), mowTo = new Date(planted.getTime() + 42 * DAY);
      const fmt = (x: Date) => x.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      $('[data-sw-mow]').textContent = st >= 4
        ? 'Yes. Mow it like the rest of the lawn, tall (3.5 to 4 inches), with a sharp blade.'
        : (today >= mowFrom
            ? 'Any time now, once it’s about 4 inches tall.'
            : `Probably between ${fmt(mowFrom)} and ${fmt(mowTo)}.`) +
          ' Go by height, not the date: mower on its highest setting, sharp blade, dry ground. Take off the top inch, no more.' +
          ([10, 11, 0, 1].includes(mowFrom.getMonth()) ? ' Seeded late in the fall? Growth slows way down when it gets cold, so the first mow may wait until spring.' : '');

      // what to watch for
      const watch = st <= 1
        ? ['A dry surface. One dry afternoon can kill sprouting seed. This is the #1 reason seed fails.',
           'Washed-away seed after a downpour. Re-spread a little where you see bare dirt lines.',
           'Birds. They take some. That’s why bags have extra.',
           'Stay off it. Footprints crush sprouts and bury seed.']
        : ['Thin spots. Normal. Touch them up with a pinch of seed and keep them damp.',
           'No weed killer yet. Wait until you’ve mowed 3 or 4 times, and read the label. Some weeds now are fine; mowing knocks most of them out.',
           'Don’t rake leaves hard. Mow over them or use a light leaf blower setting.',
           'Light green color is normal on new grass. It darkens as it grows.'];
      if (late && see === 'nothing') watch.unshift('Buried seed: it wants to sit just under the surface, about ¼ inch. Deeper doesn’t come up.', 'A crabgrass preventer put down in the last few months blocks grass seed too.', 'Old seed. Check the test date on the tag. Over a year or two old drops off fast.');
      $('[data-sw-watch]').innerHTML = watch.map((w) => `<li>${w}</li>`).join('');
    }

    function ics() {
      const sd = SEEDS.find((s: any) => s.id === type.value);
      const p = new Date(date.value + 'T12:00');
      const day = (n: number) => { const x = new Date(p.getTime() + n * DAY); return x.toISOString().slice(0, 10).replace(/-/g, ''); };
      const ev = (n: number, title: string, body: string) =>
        `BEGIN:VEVENT\r\nUID:mit-seed-${n}-${day(0)}@mowittall.com\r\nDTSTAMP:${day(0)}T120000Z\r\nDTSTART;VALUE=DATE:${day(n)}\r\nSUMMARY:${title}\r\nDESCRIPTION:${body}\r\nEND:VEVENT\r\n`;
      const text = 'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//Mow It Tall//Seed//EN\r\n' +
        ev(sd.first[1], 'Look for grass sprouts', 'Get low and look across the yard in morning light. Keep it damp. mowittall.com/resources/is-my-grass-seed-working/') +
        (sd.last[1] !== sd.first[1] ? ev(sd.last[1], 'Seed check: the slow ones', 'The bluegrass/fescue should be up by now. Ease watering to once a day. mowittall.com/resources/is-my-grass-seed-working/') : '') +
        ev(30, 'First mow check', 'Is the new grass about 4 inches? Mower on high, sharp blade, dry ground. mowittall.com/resources/is-my-grass-seed-working/') +
        'END:VCALENDAR\r\n';
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([text], { type: 'text/calendar' }));
      a.download = 'mow-it-tall-seed.ics'; a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 2000);
    }

    type.addEventListener('change', update);
    date.addEventListener('change', update);
    seeChips.forEach((c) => c.addEventListener('click', () => { see = see === c.dataset.swSee ? '' : c.dataset.swSee!; update(); }));
    $('[data-sw-ics]').addEventListener('click', ics);
    window.addEventListener('mit:place', soilTemp);
    update();
    soilTemp();
  });
</script>
