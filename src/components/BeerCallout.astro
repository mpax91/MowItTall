---
// "Buy me a beer" tip callout. Links come from src/data/site.js (empty = "coming soon").
// compact: one-line version for the footer.
import { tipLink, TIPS_ON, TIP_URL } from '../data/site.js';
const { compact = false } = Astro.props;
---
{compact ? (
  <div class="beer-foot" id="beer">
    <div class="beer-mug beer-mug-sm" aria-hidden="true">
      <svg viewBox="0 0 16 16" shape-rendering="crispEdges">
        <rect x="2" y="3" width="9" height="2" fill="#f1f6ec" />
        <rect x="2" y="5" width="9" height="9" fill="#f6c945" />
        <rect x="3" y="6" width="1" height="6" fill="#ffe08a" />
        <rect x="11" y="6" width="3" height="1" fill="#eef5e6" /><rect x="13" y="7" width="1" height="4" fill="#eef5e6" /><rect x="11" y="11" width="3" height="1" fill="#eef5e6" />
        <rect x="2" y="14" width="9" height="1" fill="#0a2414" />
      </svg>
    </div>
    <div class="beer-foot-text">
      <p class="beer-foot-h">Find This Helpful?</p>
      <p class="beer-foot-sub">Say thanks with a beer.</p>
    </div>
    {TIPS_ON
      ? <a class="beer-foot-btn" href={TIP_URL || tipLink(5)} target="_blank" rel="noopener" data-track="tip_click" data-track-link_area="footer">Buy Me a Beer</a>
      : <span class="beer-foot-btn is-off" aria-disabled="true">Tip Jar Opening Soon</span>}
  </div>
) : (
  <aside class="beer" aria-labelledby="beer-h" data-pagefind-ignore>
    <div class="beer-mug" aria-hidden="true">
      <svg viewBox="0 0 16 16" shape-rendering="crispEdges">
        <rect x="2" y="3" width="9" height="2" fill="#f1f6ec" />
        <rect x="2" y="5" width="9" height="9" fill="#f6c945" />
        <rect x="3" y="6" width="1" height="6" fill="#ffe08a" />
        <rect x="11" y="6" width="3" height="1" fill="#eef5e6" /><rect x="13" y="7" width="1" height="4" fill="#eef5e6" /><rect x="11" y="11" width="3" height="1" fill="#eef5e6" />
        <rect x="2" y="14" width="9" height="1" fill="#0a2414" />
      </svg>
    </div>
    <div class="beer-body">
      <h2 id="beer-h">Find This Helpful? Buy Me a Beer.</h2>
      <p>Totally optional. Just a way to say thanks.</p>
      <div class="beer-btns">
        {TIPS_ON
          ? <a class="btn beer-btn" href={TIP_URL || tipLink(5)} target="_blank" rel="noopener" data-track="tip_click" data-track-link_area="callout">Buy Me a Beer</a>
          : <span class="btn beer-btn is-off" aria-disabled="true">Buy Me a Beer</span>}
      </div>
      {!TIPS_ON && <p class="beer-soon">Tip jar opens soon.</p>}
    </div>
  </aside>
)}
