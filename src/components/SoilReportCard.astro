---
// "Exhibit A": a friend's real soil report, redrawn in Mow It Tall style (no names, address or lab branding).
import { SAMPLE_SOIL } from '../data/sampleSoil.js';
const CHIP = { low: 'TOO LOW', ok: 'NAILED IT', high: 'OVERACHIEVER' };
// Position of a value on a bar: pH uses its own scale, everything else 0 → a bit past the bigger of value / range top
function bar(r) {
  const [lo, hi] = r.scale || [0, Math.max(r.range[1] * 1.6, r.value * 1.15)];
  const pct = (x) => Math.min(100, Math.max(0, ((x - lo) / (hi - lo)) * 100));
  return { left: pct(r.range[0]), width: pct(r.range[1]) - pct(r.range[0]), mark: pct(r.value) };
}
const groups = SAMPLE_SOIL.groups.map((g) => ({ ...g, rows: g.rows.map((r) => ({ ...r, bar: bar(r) })) }));
---
<section class="window sr" aria-labelledby="sr-h">
  <div class="sr-head">
    <span class="sr-stamp">Exhibit A</span>
    <h2 id="sr-h">My Buddy’s Soil Report</h2>
    <p class="sr-sub">Real numbers from a real Northeast lawn. Names withheld to protect the guilty. Green zone = where you want to be.</p>
  </div>

  {groups.map((g) => (
    <div class="sr-group">
      <h3>{g.name}</h3>
      <ul class="sr-rows">
        {g.rows.map((r) => (
          <li class="sr-row" data-rating={r.rating}>
            <div class="sr-top">
              <span class="sr-name">{r.name}</span>
              <span class="sr-val">{r.show}<small>{r.id === 'ph' ? '' : ' ppm'}</small></span>
              <span class="sr-chip">{CHIP[r.rating]}</span>
            </div>
            <div class="sr-bar" aria-hidden="true">
              <span class="sr-zone" style={`left:${r.bar.left}%;width:${r.bar.width}%`}></span>
              <span class="sr-mark" style={`left:${r.bar.mark}%`}></span>
            </div>
            <p class="sr-note"><span class="sr-range">Goal {r.range[0]}–{r.range[1]}.</span> {r.note}</p>
          </li>
        ))}
      </ul>
    </div>
  ))}

  <div class="sr-verdict">
    <p class="sr-grade"><b>Report card: C+</b></p>
    <p>Tons of food in the soil, and the grass can’t eat it. A fridge full of groceries with the door locked. The pH is the lock.</p>
    <p class="sr-plan-h">The game plan</p>
    <ol>
      <li><b>Calcitic lime.</b> Magnesium is fine, so no dolomitic. No more than 50 lb per 1,000 sq ft at once. Split bigger doses between spring and fall.</li>
      <li><b>Just nitrogen.</b> Lawn food with a big first number, a 0 in the middle and a tiny last number.</li>
      <li><b>Skip the extras.</b> No iron, no micronutrient cocktails. Fixing pH handles most of that.</li>
      <li><b>Retest next year</b> to see if the lime unlocked the fridge.</li>
    </ol>
  </div>
</section>
