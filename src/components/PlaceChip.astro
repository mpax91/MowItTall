---
// A tappable location chip: "📍 Bedford, NY · change". Opens a small inline box to type a ZIP
// or use GPS. Every chip on the page stays in sync through the 'mit:place' event.
interface Props { id: string }
const { id } = Astro.props;
---
<div class="place" data-place>
  <button type="button" class="place-chip" data-place-btn aria-expanded="false" aria-controls={`${id}-panel`}>
    <svg class="place-pin" viewBox="0 0 7 9" width="12" height="15" aria-hidden="true" shape-rendering="crispEdges">
      <path fill="#0a2414" d="M2 0h3v1h1v1h1v3h-1v1h-1v1h-1v2h-1v-2h-1v-1h-1v-1h-1v-3h1v-1h1z" />
      <path fill="#c8372d" d="M2 1h3v1h1v3h-1v1h-1v1h-1v-1h-1v-1h-1v-3h1z" />
      <path fill="#f1f6ec" d="M3 2h1v2h-1z" />
    </svg>
    <span data-place-name>Bedford, NY</span>
    <span class="place-change">change</span>
  </button>
  <div class="place-panel" id={`${id}-panel`} data-place-panel hidden>
    <form class="place-form" data-place-form novalidate>
      <label for={`${id}-zip`}>Your ZIP</label>
      <input id={`${id}-zip`} inputmode="numeric" autocomplete="postal-code" maxlength="5" placeholder="10506" />
      <button type="submit" class="btn place-go">Go</button>
    </form>
    <div class="place-links">
      <button type="button" class="place-link" data-place-gps>Use my location</button>
      <button type="button" class="place-link" data-place-home hidden>Back to Bedford</button>
    </div>
    <p class="place-msg" data-place-msg role="status"></p>
  </div>
</div>

<script>
  import { getPlace, setZip, useMyLocation, resetPlace, adoptQuizZip } from '../scripts/place.js';

  const chips = [...document.querySelectorAll('[data-place]')];

  function paint(p) {
    for (const c of chips) {
      c.querySelector('[data-place-name]').textContent = p.name;
      c.querySelector('[data-place-home]').hidden = !!p.home;
    }
  }

  function close(c) {
    c.querySelector('[data-place-panel]').hidden = true;
    c.querySelector('[data-place-btn]').setAttribute('aria-expanded', 'false');
  }

  for (const c of chips) {
    const btn = c.querySelector('[data-place-btn]');
    const panel = c.querySelector('[data-place-panel]');
    const input = c.querySelector('input');
    const msg = c.querySelector('[data-place-msg]');
    const go = c.querySelector('.place-go');

    btn.addEventListener('click', () => {
      const open = panel.hidden;
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      msg.textContent = '';
      if (open) {
        const p = getPlace();
        input.value = p.home ? '' : p.zip || '';
        input.focus();
      }
    });

    input.addEventListener('input', () => { input.value = input.value.replace(/\D/g, '').slice(0, 5); });

    c.querySelector('[data-place-form]').addEventListener('submit', async (e) => {
      e.preventDefault();
      go.disabled = true;
      msg.textContent = 'Looking it up…';
      const r = await setZip(input.value);
      go.disabled = false;
      if (r.error) { msg.textContent = r.error; return; }
      input.blur();
      close(c);
    });

    c.querySelector('[data-place-gps]').addEventListener('click', async () => {
      msg.textContent = 'Asking your phone…';
      const r = await useMyLocation();
      if (r.error) { msg.textContent = r.error; return; }
      close(c);
    });

    c.querySelector('[data-place-home]').addEventListener('click', () => { resetPlace(); close(c); });
  }

  window.addEventListener('mit:place', (e) => paint((e as CustomEvent).detail));
  paint(getPlace());
  adoptQuizZip();
</script>
