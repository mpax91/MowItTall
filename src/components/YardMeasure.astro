---
// Measure your yard. Page view shows a still map and the numbers; tapping opens full screen,
// where the map takes touches. See src/scripts/measure.js.
---
<div class="mz" data-mz>
  <div class="mz-frame">
    <div class="mz-stage" data-mz-map role="application" aria-label="Satellite map of your yard"></div>

    <button type="button" class="mz-start" data-act="start">
      <span class="btn btn-big">Start measuring</span>
      <span class="mz-start-sub">Find your house, then tap the corners of your grass.</span>
    </button>
    <button type="button" class="mz-edit-chip" data-act="edit">Edit on the map</button>

    <div class="mz-top mz-ui">
      <button type="button" class="mz-pill" data-act="done">Done</button>
      <p class="mz-total" data-mz-total aria-live="polite"></p>
      <button type="button" class="mz-pill mz-pill-icon" data-act="search" aria-label="Search for an address">
        <svg viewBox="0 0 10 10" width="20" height="20" aria-hidden="true" shape-rendering="crispEdges"><path fill="currentColor" d="M3 0h3v1h1v1h1v3h-1v1h-1v1h-3v-1h-1v-1h-1v-3h1v-1h1zM3 1v1h-1v3h1v1h3v-1h1v-3h-1v-1zM7 7h1v1h1v1h1v1h-1v-1h-1v-1h-1z"/></svg>
      </button>
    </div>
    <p class="mz-hint mz-ui" data-mz-hint role="status"></p>

    <div class="mz-sheet mz-ui" data-mz-search hidden>
      <p class="mz-sheet-title">Find your house</p>
      <form class="mz-search-form" data-mz-search-form novalidate>
        <label class="sr-only" for="mz-addr">Your address</label>
        <input id="mz-addr" type="search" enterkeyhint="search" autocomplete="street-address" placeholder="Your address" />
        <button type="submit" class="btn">Go</button>
      </form>
      <ul class="mz-sugg" data-mz-sugg></ul>
      <div class="mz-sheet-row">
        <button type="button" class="mz-link" data-act="gps">Use my location</button>
        <button type="button" class="mz-link" data-act="search-close">I’ll drag the map</button>
      </div>
      <p class="mz-msg" data-mz-search-msg role="status"></p>
    </div>

    <div class="mz-sheet mz-ui" data-mz-name hidden>
      <p class="mz-sheet-title">Name this area <span class="mz-sheet-sub" data-mz-name-sqft></span></p>
      <div class="mz-chips" data-mz-chips></div>
      <form class="mz-search-form" data-mz-name-form novalidate>
        <label class="sr-only" for="mz-name">Or type a name</label>
        <input id="mz-name" type="text" enterkeyhint="done" maxlength="24" placeholder="Or type a name" autocomplete="off" />
        <button type="submit" class="btn">Save</button>
      </form>
      <div class="mz-sheet-row">
        <button type="button" class="mz-link" data-act="name-skip">Skip</button>
      </div>
    </div>

    <div class="mz-toast mz-ui" data-mz-toast hidden>
      <span></span>
      <button type="button" data-act="undo-delete">Undo</button>
    </div>

    <div class="mz-bar mz-ui" data-mz-bar></div>
  </div>

  <p class="mz-empty" data-mz-empty>Your measurements stay on your phone. I never see your address.</p>

  <div class="mz-summary window" data-mz-summary hidden>
    <h2 class="mz-summary-h">Your lawn</h2>
    <ul class="mz-list" data-mz-list></ul>
    <p class="mz-sum"><span>Total</span><strong data-mz-sum></strong></p>
    <p class="mz-acres" data-mz-acres></p>
    <div class="mz-actions">
      <button type="button" class="btn" data-act="edit">Edit map</button>
      <button type="button" class="btn btn-quiet" data-act="save-image">Save image</button>
    </div>
    <p class="mz-note" data-mz-note role="status"></p>
    <button type="button" class="mz-clear" data-act="clear">Start over</button>
  </div>
</div>

<script>
  import { initMeasure } from '../scripts/measure.js';
  const root = document.querySelector('[data-mz]');
  if (root) initMeasure(root);
</script>
