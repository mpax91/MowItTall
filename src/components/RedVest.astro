---
// Red Vest studio mark: pixel bee cap + quilted red vest (public/img/brand/red-vest.png, 78×144).
interface Props { size?: number }
const { size = 36 } = Astro.props;
---
<img class="red-vest" src="/img/brand/red-vest.png" width={Math.round(size * 78 / 144)} height={size} alt="" aria-hidden="true" decoding="async" loading="lazy" />
